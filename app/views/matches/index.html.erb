<div class="page-transition">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      Your Matches
    </h1>
    <%= link_to new_match_path, class: "inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-0.5 active:scale-98 transition-all duration-200" do %>
      <i class="fas fa-plus mr-2"></i>
      Log Match
    <% end %>
  </div>

  <!-- Filters and Search -->
  <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl p-5 mb-6 border border-slate-700 transition-all duration-300 hover:border-purple-500/30">
    <div class="flex flex-col md:flex-row gap-4">
      <div class="flex-grow">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <i class="fas fa-search text-slate-400"></i>
          </div>
          <input type="text" id="search-input" placeholder="Search matches..." class="w-full px-4 py-3 pl-11 bg-slate-900/70 border-2 border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200">
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3">
        <select id="leaderboard-filter" class="px-4 py-3 bg-slate-900/70 border-2 border-slate-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200">
          <option value="all">All Leaderboards</option>
          <% @leaderboards&.each do |leaderboard| %>
            <option value="<%= leaderboard.id %>"><%= leaderboard.name %></option>
          <% end %>
        </select>
        <select id="time-filter" class="px-4 py-3 bg-slate-900/70 border-2 border-slate-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200">
          <option value="all">All Time</option>
          <option value="month">This Month</option>
          <option value="week">This Week</option>
          <option value="today">Today</option>
        </select>
      </div>
    </div>
  </div>

  <% if @matches.present? %>
    <!-- Matches List -->
    <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl border border-slate-700 overflow-hidden transition-all duration-300 hover:border-purple-500/30">
      <div class="overflow-x-auto">
        <table class="w-full data-table" id="matches-table">
          <thead>
          <tr class="bg-slate-900/70 text-left">
            <th class="px-5 py-4 text-sm font-semibold text-slate-300" data-sortable="true" data-sort-key="date">Date</th>
            <th class="px-5 py-4 text-sm font-semibold text-slate-300" data-sortable="true" data-sort-key="opponent">Opponent</th>
            <th class="hidden md:table-cell px-5 py-4 text-sm font-semibold text-slate-300" data-sortable="true" data-sort-key="leaderboard">Leaderboard</th>
            <th class="px-5 py-4 text-sm font-semibold text-slate-300" data-sortable="true" data-sort-key="result">Result</th>
            <th class="px-5 py-4 text-sm font-semibold text-slate-300" data-sortable="false">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-slate-700">
          <% @matches.each do |match| %>
            <tr class="match-row hover:bg-slate-700/50 transition-all duration-200"
                data-leaderboard-id="<%= match.leaderboard_id %>"
                data-date="<%= match.created_at.to_i %>"
                data-opponent="<%= match.user1_id == current_user.id ? match.opponent.username : match.user1.username %>">
              <td class="px-4 py-3 text-sm text-slate-300">
                <%= match.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-slate-700 rounded-full flex items-center justify-center mr-3 border border-white/10">
                    <i class="fas fa-user text-white/70"></i>
                  </div>
                  <div>
                    <div class="font-medium text-white">
                      <%= match.user1_id == current_user.id ? match.opponent.username : match.user1.username %>
                    </div>
                  </div>
                </div>
              </td>
              <td class="hidden md:table-cell px-4 py-3 text-sm text-slate-300">
                <%= match.leaderboard.name %>
              </td>
              <td class="px-4 py-3">
                <% if match.winner_id == current_user.id %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-900/30 text-green-300 border border-green-500/30">
                      <i class="fas fa-trophy mr-1 text-green-400"></i> Win
                    </span>
                <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-900/30 text-red-300 border border-red-500/30">
                      <i class="fas fa-times mr-1 text-red-400"></i> Loss
                    </span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm">
                <%= link_to match_path(match), class: "text-indigo-400 hover:text-pink-400 transition-colors" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Card View (visible on small screens only) -->
    <div class="md:hidden mt-4 space-y-4" id="mobile-matches-container">
      <% @matches.each do |match| %>
        <div class="match-card bg-slate-800/30 backdrop-blur-md rounded-xl border border-white/10 p-4"
             data-leaderboard-id="<%= match.leaderboard_id %>"
             data-date="<%= match.created_at.to_i %>"
             data-opponent="<%= match.user1_id == current_user.id ? match.opponent.username : match.user1.username %>">
          <div class="flex justify-between items-start mb-3">
            <div class="flex items-center">
              <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center mr-3 border border-white/10">
                <i class="fas fa-user text-white/70"></i>
              </div>
              <div>
                <div class="font-medium text-white">
                  <%= match.user1_id == current_user.id ? match.opponent.username : match.user1.username %>
                </div>
                <div class="text-xs text-slate-400">
                  <%= match.leaderboard.name %>
                </div>
              </div>
            </div>
            <div>
              <% if match.winner_id == current_user.id %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-900/30 text-green-300 border border-green-500/30">
                  <i class="fas fa-trophy mr-1 text-green-400"></i> Win
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-900/30 text-red-300 border border-red-500/30">
                  <i class="fas fa-times mr-1 text-red-400"></i> Loss
                </span>
              <% end %>
            </div>
          </div>
          <div class="flex justify-between items-center text-sm">
            <div class="text-slate-300">
              <%= match.created_at.strftime("%b %d, %Y") %>
            </div>
            <%= link_to match_path(match), class: "text-indigo-400 hover:text-pink-400 transition-colors" do %>
              <i class="fas fa-eye"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex justify-center">
      <%= paginate @matches, theme: "tailwind" %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-slate-800/30 backdrop-blur-md rounded-xl border border-white/10 p-8 text-center">
      <div class="w-16 h-16 bg-slate-700/50 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-trophy text-2xl text-slate-400"></i>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">No matches yet</h3>
      <p class="text-slate-400 mb-6 max-w-md mx-auto">You haven't logged any matches yet. Start competing and tracking your progress!</p>
      <%= link_to new_match_path, class: "inline-flex items-center justify-center font-medium rounded-md transition-all duration-300 px-6 py-3 text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-1" do %>
        <i class="fas fa-plus mr-2"></i>
        Log Your First Match
      <% end %>
    </div>
  <% end %>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileMenuContainer = document.getElementById('mobile-menu-container');
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const closeMenuButton = document.getElementById('close-mobile-menu');

        // Open mobile menu
        function openMobileMenu() {
            mobileMenu.classList.remove('hidden');
            setTimeout(() => {
                mobileMenuContainer.classList.remove('-translate-x-full');
            }, 10);
        }

        // Close mobile menu
        function closeMobileMenu() {
            mobileMenuContainer.classList.add('-translate-x-full');
            setTimeout(() => {
                mobileMenu.classList.add('hidden');
            }, 300);
        }

        // Toggle the mobile menu on hamburger click
        mobileMenuButton?.addEventListener('click', openMobileMenu);
        closeMenuButton?.addEventListener('click', closeMobileMenu);

        // Close menu when clicking outside container
        mobileMenu?.addEventListener('click', function(e) {
            if (e.target === mobileMenu) {
                closeMobileMenu();
            }
        });

        // Flash messages auto-dismiss and manual close
        const flashMessages = document.querySelectorAll('.flash-message');
        flashMessages.forEach(message => {
            setTimeout(() => {
                message.style.opacity = '0';
                setTimeout(() => {
                    message.remove();
                }, 500);
            }, 5000);

            const closeButton = message.querySelector('.close-flash');
            if (closeButton) {
                closeButton.addEventListener('click', () => {
                    message.style.opacity = '0';
                    setTimeout(() => {
                        message.remove();
                    }, 500);
                });
            }
        });

        // Hide bottom nav on scroll
        const bottomNav = document.getElementById('bottom-nav');
        if (bottomNav) {
            let lastScrollTop = 0;
            const scrollThreshold = 20;

            window.addEventListener(
                'scroll',
                () => {
                    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    if (Math.abs(lastScrollTop - scrollTop) <= scrollThreshold) return;

                    if (scrollTop > lastScrollTop && scrollTop > 100) {
                        bottomNav.classList.add('hidden-nav');
                    } else {
                        bottomNav.classList.remove('hidden-nav');
                    }

                    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
                },
                { passive: true }
            );
        }

        // Ripple effect
        function createRipple(event) {
            const button = event.currentTarget;
            const circle = document.createElement('span');
            const diameter = Math.max(button.clientWidth, button.clientHeight);
            const radius = diameter / 2;
            const rect = button.getBoundingClientRect();

            circle.style.width = circle.style.height = `${diameter}px`;
            circle.style.left = `${event.clientX - rect.left - radius}px`;
            circle.style.top = `${event.clientY - rect.top - radius}px`;
            circle.classList.add('ripple');

            const existingRipple = button.querySelector('.ripple');
            if (existingRipple) {
                existingRipple.remove();
            }

            button.appendChild(circle);
        }

        const rippleButtons = document.querySelectorAll(
            '.btn, .btn-primary, .btn-accent, .log-match-button'
        );
        rippleButtons.forEach(button => {
            button.addEventListener('click', createRipple);
        });

        // Toast notification system
        window.showToast = function(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast flex items-center mb-3 pointer-events-auto bg-slate-800/90 backdrop-blur-md rounded-lg shadow-md p-4 max-w-sm w-full border-l-4 animate-[toast-in_0.5s_ease] border-white/10`;
            toast.style.animation =
                'toast-in 0.5s var(--ease), toast-out 0.5s var(--ease) 3s forwards';

            let iconClass = 'fa-info-circle text-indigo-400';
            let borderColor = 'border-indigo-500';
            if (type === 'success') {
                iconClass = 'fa-check-circle text-green-400';
                borderColor = 'border-green-500';
            } else if (type === 'error') {
                iconClass = 'fa-exclamation-circle text-red-400';
                borderColor = 'border-red-500';
            } else if (type === 'warning') {
                iconClass = 'fa-exclamation-triangle text-yellow-400';
                borderColor = 'border-yellow-500';
            }

            toast.classList.add(borderColor);
            toast.innerHTML = `
            <i class="fas ${iconClass} mr-3"></i>
            <span class="flex-1 text-white">${message}</span>
            <button class="ml-2 text-white/60 hover:text-white transition-colors duration-300">
              <i class="fas fa-times"></i>
            </button>
          `;

            container.appendChild(toast);

            const closeBtn = toast.querySelector('button');
            closeBtn.addEventListener('click', () => {
                toast.style.opacity = '0';
                setTimeout(() => {
                    toast.remove();
                }, 300);
            });
        };

        // Navbar shadow on scroll
        const navbar = document.querySelector('nav');
        function handleNavbarScroll() {
            if (window.scrollY > 10) {
                navbar.classList.add('shadow-lg', 'shadow-purple-500/5');
            } else {
                navbar.classList.remove('shadow-lg', 'shadow-purple-500/5');
            }
        }
        window.addEventListener('scroll', handleNavbarScroll, { passive: true });

        // Link highlighting
        function setActiveLinks() {
            const currentPath = window.location.pathname;

            // Desktop nav links
            document.querySelectorAll('.nav-link').forEach(link => {
                const href = link.getAttribute('href');
                if (href === currentPath) {
                    link.classList.add('font-medium', 'text-[var(--accent)]');
                } else {
                    link.classList.remove('font-medium', 'text-[var(--accent)]');
                }
            });

            // Mobile nav items
            document.querySelectorAll('.mobile-nav-item').forEach(link => {
                const href = link.getAttribute('href');
                if (href === currentPath) {
                    link.classList.add('bg-slate-700/50', 'text-[var(--accent)]');
                } else {
                    link.classList.remove('bg-slate-700/50', 'text-[var(--accent)]');
                }
            });

            // Bottom nav
            document.querySelectorAll('.mobile-nav-button').forEach(btn => {
                const href = btn.getAttribute('href');
                if (href === currentPath) {
                    btn.classList.add('text-[var(--accent)]');
                } else {
                    btn.classList.remove('text-[var(--accent)]');
                }
            });
        }
        setActiveLinks();

        // Tooltips
        function initTooltips() {
            document.querySelectorAll('[data-tooltip]').forEach(el => {
                el.addEventListener('mouseenter', () => {
                    const tooltipText = el.getAttribute('data-tooltip');
                    const tooltip = document.createElement('div');
                    tooltip.className =
                        'absolute bg-slate-800 text-white text-xs rounded-md py-1 px-2 z-50 backdrop-blur-md border border-white/10 shadow-lg shadow-purple-500/10';
                    tooltip.style.bottom = 'calc(100% + 5px)';
                    tooltip.style.left = '50%';
                    tooltip.style.transform = 'translateX(-50%)';
                    tooltip.textContent = tooltipText;

                    const arrow = document.createElement('div');
                    arrow.className = 'absolute w-0 h-0';
                    arrow.style.borderLeft = '5px solid transparent';
                    arrow.style.borderRight = '5px solid transparent';
                    arrow.style.borderTop = '5px solid #1e293b';
                    arrow.style.bottom = '-5px';
                    arrow.style.left = '50%';
                    arrow.style.transform = 'translateX(-50%)';
                    tooltip.appendChild(arrow);

                    el.style.position = 'relative';
                    el.appendChild(tooltip);
                });
                el.addEventListener('mouseleave', () => {
                    const tooltip = el.querySelector('.bg-slate-800');
                    if (tooltip) tooltip.remove();
                });
            });
        }
        initTooltips();

        // Enhanced form effect
        document.querySelectorAll('input, textarea, select').forEach(field => {
            field.addEventListener('focus', () => {
                if (field.parentElement) {
                    field.parentElement.classList.add('focused');
                }
            });
            field.addEventListener('blur', () => {
                if (field.parentElement) {
                    field.parentElement.classList.remove('focused');
                }
                if (field.value) {
                    field.classList.add('filled');
                } else {
                    field.classList.remove('filled');
                }
            });
        });

        // Simple data-table clickable sort icons
        function initializeDataTables() {
            const tables = document.querySelectorAll('.data-table');
            tables.forEach(table => {
                const headers = table.querySelectorAll('th');
                headers.forEach(header => {
                    if (header.getAttribute('data-sortable') !== 'false') {
                        header.classList.add('cursor-pointer', 'select-none');
                        const iconSpan = document.createElement('span');
                        iconSpan.innerHTML = ' <i class="fas fa-sort text-white/40 ml-1"></i>';
                        header.appendChild(iconSpan);

                        header.addEventListener('click', () => {
                            const currentSort = header.getAttribute('data-sort') || 'none';
                            headers.forEach(h => {
                                h.setAttribute('data-sort', 'none');
                                const icon = h.querySelector('i');
                                if (icon) {
                                    icon.className = 'fas fa-sort text-white/40 ml-1';
                                }
                            });
                            let newSort = 'asc';
                            if (currentSort === 'asc') newSort = 'desc';

                            header.setAttribute('data-sort', newSort);
                            const icon = header.querySelector('i');
                            if (icon) {
                                icon.className = `fas fa-sort-${
                                    newSort === 'asc' ? 'up' : 'down'
                                } text-[var(--accent)] ml-1`;
                            }
                            // Add your own sorting logic or server request here
                        });
                    }
                });
            });
        }
        initializeDataTables();

        // Page transitions with Turbo
        document.addEventListener('turbo:before-visit', () => {
            const mainContent = document.querySelector('main');
            if (mainContent) {
                mainContent.style.opacity = '0';
            }
        });

        document.addEventListener('turbo:load', () => {
            setActiveLinks();
            initTooltips();
            initializeDataTables();
            const mainContent = document.querySelector('main');
            if (mainContent) {
                mainContent.classList.add('page-transition');
            }
        });

        // Add decorative elements with animations
        function addDecorativeElements() {
            const decorContainer = document.createElement('div');
            decorContainer.className =
                'fixed inset-0 pointer-events-none overflow-hidden z-0';

            // Add floating orbs with different sizes and opacities
            for (let i = 0; i < 5; i++) {
                const orb = document.createElement('div');
                const size = Math.floor(Math.random() * 300) + 100;
                const posX = Math.floor(Math.random() * 100);
                const posY = Math.floor(Math.random() * 100);
                const delay = Math.floor(Math.random() * 5);

                orb.className = 'absolute rounded-full animate-float';
                orb.style.width = `${size}px`;
                orb.style.height = `${size}px`;
                orb.style.left = `${posX}%`;
                orb.style.top = `${posY}%`;
                orb.style.background = `radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, rgba(236, 72, 153, 0.05) 70%, transparent 100%)`;
                orb.style.filter = 'blur(40px)';
                orb.style.animationDelay = `${delay}s`;

                decorContainer.appendChild(orb);
            }

            document.body.prepend(decorContainer);
        }

        // Only add decorative elements on larger screens
        if (window.innerWidth > 768) {
            addDecorativeElements();
        }
    });
</script>
