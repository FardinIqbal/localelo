<%= render "shared/layouts/page_shell",
           title: "Your matches",
           subtitle: "Search your recent results, narrow them by leaderboard, or log something new." do %>
  <section data-controller="matches-filters" class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex-1">
        <label for="matches-search" class="text-sm font-medium text-slate-700">Search</label>
        <div class="mt-2 flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
          <i class="fas fa-search text-slate-400"></i>
          <input id="matches-search"
                 type="search"
                 placeholder="Search by opponent or leaderboard"
                 class="w-full border-0 p-0 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0"
                 data-matches-filters-target="query"
                 data-action="input->matches-filters#filter">
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 sm:items-end">
        <div>
          <label for="matches-leaderboard" class="text-sm font-medium text-slate-700">Leaderboard</label>
          <select id="matches-leaderboard"
                  class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10"
                  data-matches-filters-target="leaderboard"
                  data-action="change->matches-filters#filter">
            <option value="all">All leaderboards</option>
            <% @leaderboards&.each do |leaderboard| %>
              <option value="<%= leaderboard.id %>"><%= leaderboard.name %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label for="matches-timeframe" class="text-sm font-medium text-slate-700">Timeframe</label>
          <select id="matches-timeframe"
                  class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10"
                  data-matches-filters-target="timeframe"
                  data-action="change->matches-filters#filter">
            <option value="all">All time</option>
            <option value="month">This month</option>
            <option value="week">This week</option>
            <option value="today">Today</option>
          </select>
        </div>
      </div>
      <%= link_to new_match_path,
                  class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
        <i class="fas fa-plus"></i>
        Log match
      <% end %>
    </div>

    <% if @matches.present? %>
      <div class="space-y-4">
        <% @matches.each do |match| %>
          <% opponent_name = match.user1_id == current_user.id ? match.opponent.username : match.user1.username %>
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-slate-300"
                   data-matches-filters-target="item"
                   data-leaderboard-id="<%= match.leaderboard_id %>"
                   data-leaderboard-name="<%= match.leaderboard.name.to_s.downcase %>"
                   data-opponent="<%= opponent_name.to_s.downcase %>"
                   data-played-at="<%= match.created_at.iso8601 %>">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="space-y-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Opponent</p>
                <p class="text-lg font-semibold text-slate-900"><%= opponent_name %></p>
                <p class="text-sm text-slate-500"><i class="fas fa-layer-group mr-1 text-slate-400"></i><%= match.leaderboard.name %></p>
              </div>
              <div class="flex flex-col items-start gap-2 text-sm text-slate-600 sm:items-end">
                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= match.winner_id == current_user.id ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                  <%= match.winner_id == current_user.id ? 'Win' : 'Loss' %>
                </span>
                <time datetime="<%= match.created_at.iso8601 %>" class="text-sm text-slate-500">
                  <%= match.created_at.strftime("%b %d, %Y") %>
                </time>
              </div>
            </div>
            <div class="mt-6 flex items-center justify-between text-sm text-slate-600">
              <p class="flex items-center gap-2">
                <i class="fas fa-hashtag text-slate-400"></i>
                Match ID <span class="font-mono text-slate-500">#<%= match.id %></span>
              </p>
              <%= link_to match_path(match), class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:text-slate-700" do %>
                View details
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
      <div data-matches-filters-target="empty" class="hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-500">
        <p>No matches match those filters yet.</p>
      </div>
      <div class="pt-4 text-center">
        <%= paginate @matches, theme: "tailwind" %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
        <p class="text-base">You have not logged any matches yet.</p>
        <div class="mt-4">
          <%= link_to "Log your first match", new_match_path, class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
