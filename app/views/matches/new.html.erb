<% leaderboards_data = @leaderboards.map { |lb| { id: lb.id, name: lb.name, organization_id: lb.organization_id } } %>
<% profiles_by_org = @user_profiles_by_org || {} %>

<%= render "shared/layouts/page_shell",
           title: "Log a match",
           subtitle: "Record the result, choose the right leaderboard, and keep the standings up to date." do %>
  <%= form_with(model: @match,
                local: true,
                html: { class: "space-y-8" },
                data: {
                  controller: "match-form",
                  "match-form-leaderboards-value": leaderboards_data.to_json,
                  "match-form-profiles-by-org-value": profiles_by_org.to_json,
                  "match-form-opponents-url-value": update_opponents_matches_path
                }) do |f| %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-medium text-slate-600">Step <span data-match-form-target="stepIndicator" class="font-semibold text-slate-900">1</span> of 4</p>
        <div class="h-2 w-full rounded-full bg-slate-200 sm:w-64">
          <div class="h-2 rounded-full bg-slate-900 transition-all" style="width: 0%" data-match-form-target="progressBar"></div>
        </div>
      </div>
    </div>

    <div class="grid gap-6">
      <div>
        <label for="organization-select" class="text-sm font-medium text-slate-700">Organization</label>
        <%= select_tag :organization_id,
                       options_for_select([["Select a gym…", ""]] + current_user.organizations.map { |org| [org.name, org.id] }, params[:organization_id]),
                       id: "organization-select",
                       class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10",
                       required: true,
                       data: { action: "change->match-form#chooseOrganization", match_form_target: "organizationSelect" } %>
      </div>

      <div>
        <%= f.label :leaderboard_id, "Leaderboard", class: "text-sm font-medium text-slate-700" %>
        <%= f.select :leaderboard_id,
                     [["Select a leaderboard…", ""]],
                     {},
                     class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10 disabled:bg-slate-100",
                     disabled: true,
                     required: true,
                     data: { action: "change->match-form#chooseLeaderboard", match_form_target: "leaderboardSelect" } %>
      </div>

      <div>
        <%= f.label :opponent_profile_id, "Opponent", class: "text-sm font-medium text-slate-700" %>
        <%= f.select :opponent_profile_id,
                     [["Select an opponent…", ""]],
                     {},
                     class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10 disabled:bg-slate-100",
                     disabled: true,
                     required: true,
                     data: { action: "change->match-form#chooseOpponent", match_form_target: "opponentSelect" } %>
      </div>

      <%= hidden_field_tag :profile1_id, "", data: { match_form_target: "profileField" } %>

      <fieldset class="space-y-3">
        <legend class="text-sm font-medium text-slate-700">Result</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block">
            <%= f.radio_button :winner_profile_id,
                               "",
                               class: "peer sr-only",
                               disabled: true,
                               data: { match_form_target: "winnerMeRadio", action: "change->match-form#pickWinner" } %>
            <div class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-4 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-400 peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white">
              <span class="flex h-6 w-6 items-center justify-center rounded-full border border-slate-300 bg-slate-50 peer-checked:border-white peer-checked:bg-white/20">
                <i class="fas fa-user text-xs text-slate-500 peer-checked:text-slate-900"></i>
              </span>
              I won
            </div>
          </label>
          <label class="block">
            <%= f.radio_button :winner_profile_id,
                               "",
                               class: "peer sr-only",
                               disabled: true,
                               data: { match_form_target: "winnerOpponentRadio", action: "change->match-form#pickWinner" } %>
            <div class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-4 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-400 peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white">
              <span class="flex h-6 w-6 items-center justify-center rounded-full border border-slate-300 bg-slate-50 peer-checked:border-white peer-checked:bg-white/20">
                <i class="fas fa-user text-xs text-slate-500 peer-checked:text-slate-900"></i>
              </span>
              My opponent won
            </div>
          </label>
        </div>
      </fieldset>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to matches_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-700" do %>
        Cancel
      <% end %>
      <button type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-60"
              data-match-form-target="submitButton"
              disabled>
        Log match
      </button>
    </div>
  <% end %>
<% end %>
