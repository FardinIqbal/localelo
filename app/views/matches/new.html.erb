<!-- app/views/matches/new.html.erb -->
<div class="relative min-h-screen">
  <!-- Decorative Background Elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-3xl mx-auto px-4 py-6">
    <!-- Page Header -->
    <h1 class="font-extrabold text-3xl md:text-4xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent mb-2">
      Log a Match
    </h1>
    <p class="text-slate-400 mb-6">Record your match results to update Elo ratings</p>

    <%= form_with(model: @match, local: true, id: "match-form", class: "space-y-6") do |f| %>
      <!-- Quick Access Section -->
      <% if @recent_opponents.present? %>
        <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 p-4 mb-2">
          <h3 class="text-sm font-medium text-slate-300 mb-3">Recent Opponents</h3>
          <div class="flex flex-wrap gap-2">
            <% @recent_opponents.each do |opponent| %>
              <button type="button"
                      class="quick-opponent px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-white text-sm flex items-center"
                      data-opponent-id="<%= opponent.id %>"
                      data-opponent-name="<%= opponent.username %>">
                <div class="w-6 h-6 rounded-full bg-gradient-to-br from-indigo-500 to-blue-500 flex items-center justify-center text-white font-bold text-xs mr-2">
                  <%= opponent.username[0..1].upcase %>
                </div>
                <%= opponent.username %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Main Form Card -->
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <!-- Leaderboard Selection -->
          <div>
            <label class="text-sm text-slate-400 mb-1 block">Leaderboard <span class="text-pink-400">*</span></label>
            <%= f.select :leaderboard_id,
                         options_from_collection_for_select(@leaderboards, :id, :name, params[:leaderboard_id]),
                         { include_blank: "Select leaderboard" },
                         { class: "w-full px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-white",
                           required: true,
                           data: { action: "change->match#fetchOpponents" } } %>
            <div class="text-xs text-red-400 hidden mt-1" id="leaderboard-error">Please select a leaderboard</div>
          </div>

          <!-- Opponent Selection -->
          <div>
            <label class="text-sm text-slate-400 mb-1 block">Opponent <span class="text-pink-400">*</span></label>
            <%= f.select :opponent_id,
                         params[:opponent_id].present? ? [[User.find(params[:opponent_id]).username, params[:opponent_id]]] : [],
                         { include_blank: "Select opponent" },
                         { class: "w-full px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-white",
                           required: true,
                           data: { action: "change->match#updatePreview" } } %>
            <div class="text-xs text-red-400 hidden mt-1" id="opponent-error">Please select an opponent</div>
          </div>
        </div>

        <!-- Match Preview -->
        <div id="match-preview" class="<%= params[:opponent_id].present? ? '' : 'hidden' %> mb-6 p-4 rounded-lg bg-slate-700/50 border border-slate-600">
          <h3 class="text-sm font-medium text-slate-300 mb-3">Match Preview</h3>
          <div class="flex items-center justify-between">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-sm font-bold">
                <%= current_user.username[0..1].upcase %>
              </div>
              <div class="mt-2 text-center">
                <div class="text-white text-sm font-medium">You</div>
                <div class="text-xs text-slate-400" id="user-rating">1500</div>
              </div>
            </div>

            <div class="flex flex-col items-center">
              <div class="text-lg font-bold text-white">VS</div>
              <div class="text-xs text-slate-400 mt-1" id="leaderboard-name"></div>
            </div>

            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-blue-500 flex items-center justify-center text-white text-sm font-bold" id="opponent-initials">
                ?
              </div>
              <div class="mt-2 text-center">
                <div class="text-white text-sm font-medium" id="opponent-name">Opponent</div>
                <div class="text-xs text-slate-400" id="opponent-rating">1500</div>
              </div>
            </div>
          </div>

          <div class="mt-3 text-center text-xs text-slate-400">
            <span id="elo-prediction" class="font-medium">
              <i class="fas fa-calculator mr-1"></i> Win: <span class="text-green-400">+0</span> | Loss: <span class="text-red-400">-0</span>
            </span>
          </div>
        </div>

        <!-- Result Selection -->
        <div>
          <label class="text-sm text-slate-400 mb-3 block">Match Result <span class="text-pink-400">*</span></label>
          <div class="grid grid-cols-3 gap-3">
            <!-- I Won -->
            <label class="cursor-pointer">
              <%= f.radio_button :winner_id, current_user.id, class: "hidden result-radio" %>
              <div class="p-3 rounded-lg border border-slate-700 hover:border-green-500/50 transition-all duration-300 bg-slate-800/50 text-center result-option">
                <div class="text-green-400 text-lg mb-1"><i class="fas fa-trophy"></i></div>
                <div class="text-white text-sm">I Won</div>
                <div class="w-4 h-4 rounded-full border border-slate-600 mx-auto mt-2 flex items-center justify-center result-check">
                  <i class="fas fa-check text-green-500 opacity-0 transition-opacity duration-300"></i>
                </div>
              </div>
            </label>

            <!-- I Lost -->
            <label class="cursor-pointer">
              <%= f.radio_button :winner_id, nil, class: "hidden result-radio", id: "opponent-winner-radio" %>
              <div class="p-3 rounded-lg border border-slate-700 hover:border-red-500/50 transition-all duration-300 bg-slate-800/50 text-center result-option">
                <div class="text-red-400 text-lg mb-1"><i class="fas fa-times"></i></div>
                <div class="text-white text-sm">I Lost</div>
                <div class="w-4 h-4 rounded-full border border-slate-600 mx-auto mt-2 flex items-center justify-center result-check">
                  <i class="fas fa-check text-red-500 opacity-0 transition-opacity duration-300"></i>
                </div>
              </div>
            </label>

            <!-- Draw -->
            <label class="cursor-pointer">
              <%= f.check_box :is_draw, class: "hidden draw-checkbox" %>
              <div class="p-3 rounded-lg border border-slate-700 hover:border-yellow-500/50 transition-all duration-300 bg-slate-800/50 text-center result-option">
                <div class="text-yellow-400 text-lg mb-1"><i class="fas fa-handshake"></i></div>
                <div class="text-white text-sm">Draw</div>
                <div class="w-4 h-4 rounded-full border border-slate-600 mx-auto mt-2 flex items-center justify-center draw-check">
                  <i class="fas fa-check text-yellow-500 opacity-0 transition-opacity duration-300"></i>
                </div>
              </div>
            </label>
          </div>
          <div class="text-xs text-red-400 hidden mt-1" id="result-error">Please select a match result</div>
        </div>

        <!-- Submit Button -->
        <div class="mt-6">
          <button type="submit" id="submit-button" class="w-full px-5 py-3 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all transform hover:-translate-y-0.5">
            <span id="submit-text">Log Match</span>
            <i class="fas fa-spinner fa-spin ml-2 hidden" id="spinner"></i>
          </button>
          <div class="text-xs text-center text-slate-400 mt-2">
            <span class="text-purple-400">Pro tip:</span> Press
            <kbd class="px-1.5 py-0.5 bg-slate-700 rounded text-xs">Alt + Enter</kbd> to quickly submit
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-5 right-5 px-4 py-3 rounded-lg shadow-lg transform translate-y-10 opacity-0 transition-all duration-500 z-50 flex items-center hidden">
  <i class="fas mr-2 text-xl toast-icon"></i>
  <div>
    <div class="font-medium toast-title"></div>
    <div class="text-sm toast-message"></div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --------------------
        // Form elements
        // --------------------
        const form = document.getElementById("match-form");
        const leaderboardSelect = document.getElementById("match_leaderboard_id");
        const opponentSelect = document.getElementById("match_opponent_id");
        const opponentWinnerRadio = document.getElementById("opponent-winner-radio");
        const resultRadios = document.querySelectorAll(".result-radio");
        const drawCheckbox = document.querySelector(".draw-checkbox");
        const submitButton = document.getElementById("submit-button");
        const submitText = document.getElementById("submit-text");
        const spinner = document.getElementById("spinner");
        const toast = document.getElementById("toast");

        // --------------------
        // Preview elements
        // --------------------
        const matchPreview = document.getElementById("match-preview");
        const opponentInitials = document.getElementById("opponent-initials");
        const opponentName = document.getElementById("opponent-name");
        const leaderboardNamePreview = document.getElementById("leaderboard-name");
        const userRating = document.getElementById("user-rating");
        const opponentRating = document.getElementById("opponent-rating");
        const eloPrediction = document.getElementById("elo-prediction");

        // --------------------
        // Error elements
        // --------------------
        const leaderboardError = document.getElementById("leaderboard-error");
        const opponentError = document.getElementById("opponent-error");
        const resultError = document.getElementById("result-error");

        // --------------------
        // Quick opponent buttons
        // --------------------
        const quickOpponentButtons = document.querySelectorAll(".quick-opponent");

        // --------------------
        // TomSelect initialization
        // --------------------
        let tomSelect = new TomSelect("#match_opponent_id", {
            create: false,
            sortField: {field: "text", direction: "asc"},
            placeholder: "Search for an opponent...",
            render: {
                option: function (data, escape) {
                    return `<div class="flex items-center p-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-blue-500 flex items-center justify-center text-white font-bold mr-2">
              ${escape(data.text.substring(0, 2).toUpperCase())}
            </div>
            <div>${escape(data.text)}</div>
          </div>`;
                },
                item: function (data, escape) {
                    return `<div class="flex items-center">
            <div class="w-6 h-6 rounded-full bg-gradient-to-br from-indigo-500 to-blue-500 flex items-center justify-center text-white font-bold mr-2 text-xs">
              ${escape(data.text.substring(0, 2).toUpperCase())}
            </div>
            <div>${escape(data.text)}</div>
          </div>`;
                }
            }
        });

        // --------------------
        // Quick opponent selection
        // --------------------
        quickOpponentButtons.forEach(button => {
            button.addEventListener("click", function () {
                const opponentId = this.dataset.opponentId;
                const opponentUsername = this.dataset.opponentName;

                if (leaderboardSelect.value) {
                    tomSelect.setValue(opponentId);
                    updateOpponentPreview(opponentId, opponentUsername);
                    fetchRatings(leaderboardSelect.value, opponentId);
                } else {
                    showToast("Please select a leaderboard first", "error");
                    leaderboardError.classList.remove("hidden");
                }
            });
        });

        // --------------------
        // Leaderboard selection
        // --------------------
        leaderboardSelect.addEventListener("change", function () {
            leaderboardError.classList.add("hidden");

            if (this.value) {
                fetchOpponents(this.value);
                const leaderboardName = this.options[this.selectedIndex].text;
                leaderboardNamePreview.textContent = leaderboardName;

                // If opponent is already selected, fetch ratings
                if (opponentSelect.value) {
                    fetchRatings(this.value, opponentSelect.value);
                }
            } else {
                tomSelect.clear();
                tomSelect.clearOptions();
                matchPreview.classList.add("hidden");
            }
        });

        // --------------------
        // Opponent selection (TomSelect)
        // --------------------
        tomSelect.on("change", function (value) {
            opponentError.classList.add("hidden");
            if (value) {
                const selectedOption = tomSelect.options[value];
                if (selectedOption) {
                    updateOpponentPreview(value, selectedOption.text);

                    if (leaderboardSelect.value) {
                        fetchRatings(leaderboardSelect.value, value);
                    }
                }
            } else {
                matchPreview.classList.add("hidden");
            }
        });

        // --------------------
        // Result selection (Winner radios)
        // --------------------
        resultRadios.forEach(radio => {
            radio.addEventListener("change", function () {
                resultError.classList.add("hidden");

                // Reset checks
                document.querySelectorAll(".result-check i").forEach(check => {
                    check.style.opacity = "0";
                });

                // Show check for selected
                if (this.checked) {
                    this.closest("label").querySelector(".result-check i").style.opacity = "1";

                    // Uncheck draw if a winner is selected
                    if (drawCheckbox.checked) {
                        drawCheckbox.checked = false;
                        document.querySelector(".draw-check i").style.opacity = "0";
                    }
                }
            });
        });

        // --------------------
        // Draw checkbox
        // --------------------
        drawCheckbox.addEventListener("change", function () {
            resultError.classList.add("hidden");
            if (this.checked) {
                document.querySelector(".draw-check i").style.opacity = "1";

                // Uncheck winner radios if draw is selected
                resultRadios.forEach(radio => {
                    radio.checked = false;
                    radio.closest("label").querySelector(".result-check i").style.opacity = "0";
                });
            } else {
                document.querySelector(".draw-check i").style.opacity = "0";
            }
        });

        // --------------------
        // Form submission
        // --------------------
        form.addEventListener("submit", function (event) {
            event.preventDefault();
            let isValid = true;

            // Validate leaderboard
            if (!leaderboardSelect.value) {
                isValid = false;
                leaderboardError.classList.remove("hidden");
            }

            // Validate opponent
            if (!opponentSelect.value) {
                isValid = false;
                opponentError.classList.remove("hidden");
            }

            // Validate result
            if (!document.querySelector('input[name="match[winner_id]"]:checked') && !drawCheckbox.checked) {
                isValid = false;
                resultError.classList.remove("hidden");
            }

            if (!isValid) {
                return;
            }

            // If "I lost" is chosen, set winner_id to the opponent
            if (opponentWinnerRadio.checked) {
                opponentWinnerRadio.value = opponentSelect.value;
            }

            // Show loading state
            submitButton.disabled = true;
            submitText.textContent = "Logging Match...";
            spinner.classList.remove("hidden");

            // Slight delay then submit
            setTimeout(() => {
                form.submit();
            }, 300);
        });

        // --------------------
        // Keyboard shortcuts
        // --------------------
        document.addEventListener("keydown", function (e) {
            // Alt+Enter to submit form
            if (e.altKey && e.key === "Enter") {
                submitButton.click();
            }
            // Escape to clear form
            if (e.key === "Escape") {
                if (confirm("Clear form and start over?")) {
                    leaderboardSelect.value = "";
                    tomSelect.clear();
                    resultRadios.forEach(radio => {
                        radio.checked = false;
                    });
                    drawCheckbox.checked = false;
                    document.querySelectorAll(".result-check i, .draw-check i").forEach(check => {
                        check.style.opacity = "0";
                    });
                    matchPreview.classList.add("hidden");
                }
            }
        });

        // --------------------
        // Helper functions
        // --------------------
        function updateOpponentPreview(opponentId, opponentUsername) {
            opponentName.textContent = opponentUsername;
            opponentInitials.textContent = opponentUsername.substring(0, 2).toUpperCase();
            matchPreview.classList.remove("hidden");
        }

        function fetchOpponents(leaderboardId) {
            fetch(`/api/v1/leaderboards/${leaderboardId}/users?exclude_current=true`, {
                headers: {"Accept": "application/json"}
            })
                .then(response => response.json())
                .then(data => {
                    tomSelect.clear();
                    tomSelect.clearOptions();
                    data.forEach(user => {
                        tomSelect.addOption({value: user.id, text: user.username});
                    });
                    tomSelect.refreshOptions(false);
                })
                .catch(error => {
                    console.error("Error fetching opponents:", error);
                    showToast("Failed to load opponents", "error");
                });
        }

        function fetchRatings(leaderboardId, userId) {
            fetch(`/api/v1/leaderboards/${leaderboardId}/ratings?user_id=${userId}`, {
                headers: {"Accept": "application/json"}
            })
                .then(response => response.json())
                .then(data => {
                    if (data.current_user_rating) {
                        userRating.textContent = `${data.current_user_rating} Elo`;
                    }
                    if (data.opponent_rating) {
                        opponentRating.textContent = `${data.opponent_rating} Elo`;
                    }
                    if (data.current_user_rating && data.opponent_rating) {
                        const winChange = calculateEloChange(data.current_user_rating, data.opponent_rating, 1);
                        const lossChange = calculateEloChange(data.current_user_rating, data.opponent_rating, 0);
                        eloPrediction.innerHTML = `<i class="fas fa-calculator mr-1"></i> Win: <span class="text-green-400">+${winChange}</span> | Loss: <span class="text-red-400">${lossChange}</span>`;
                    }
                })
                .catch(error => {
                    console.error("Error fetching ratings:", error);
                });
        }

        function calculateEloChange(ratingA, ratingB, outcome) {
            const K_FACTOR = 32;
            const expectedScore = 1.0 / (1.0 + Math.pow(10, (ratingB - ratingA) / 400.0));
            return Math.round(K_FACTOR * (outcome - expectedScore));
        }

        function showToast(message, type = "success") {
            const toastIcon = document.querySelector(".toast-icon");
            const toastTitle = document.querySelector(".toast-title");
            const toastMessage = document.querySelector(".toast-message");

            if (type === "success") {
                toastIcon.className = "fas fa-check-circle mr-2 text-xl text-green-400 toast-icon";
                toastTitle.textContent = "Success";
                toastTitle.className = "toast-title font-medium text-green-400";
                toast.className = "fixed bottom-5 right-5 bg-slate-800 border border-green-500 px-4 py-3 rounded-lg shadow-lg transform translate-y-10 opacity-0 transition-all duration-500 z-50 flex items-center";
            } else {
                toastIcon.className = "fas fa-exclamation-circle mr-2 text-xl text-red-400 toast-icon";
                toastTitle.textContent = "Error";
                toastTitle.className = "toast-title font-medium text-red-400";
                toast.className = "fixed bottom-5 right-5 bg-slate-800 border border-red-500 px-4 py-3 rounded-lg shadow-lg transform translate-y-10 opacity-0 transition-all duration-500 z-50 flex items-center";
            }

            toastMessage.textContent = message;
            toast.classList.remove("hidden");

// Show toast
            setTimeout(() => {
                toast.classList.remove("translate-y-10", "opacity-0");
            }, 10);

// Hide toast after 3 seconds
            setTimeout(() => {
                toast.classList.add("translate-y-10", "opacity-0");
                setTimeout(() => {
                    toast.classList.add("hidden");
                }, 500);
            }, 3000);
        }

// --------------------
// If the page loads with a pre-selected leaderboard or opponent
// --------------------
        if (leaderboardSelect.value) {
            const leaderboardName =
                leaderboardSelect.options[leaderboardSelect.selectedIndex].text;
            leaderboardNamePreview.textContent = leaderboardName;
            fetchOpponents(leaderboardSelect.value);

            if (opponentSelect.value) {
                fetchRatings(leaderboardSelect.value, opponentSelect.value);
            }
        }
    });
</script>
