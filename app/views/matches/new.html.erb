<h1 class="font-bold text-4xl mb-6">Log a Match</h1>

<%= form_with(model: @match, local: true, id: "match-form", class: "space-y-6") do |f| %>

  <!-- Select Leaderboard -->
  <div>
    <%= f.label :leaderboard_id, "Select Leaderboard", class: "block font-semibold mb-1" %>
    <%= f.collection_select :leaderboard_id, @leaderboards, :id, :name, { prompt: "Choose a leaderboard" },
                            class: "border p-2 w-full rounded-md focus:ring focus:ring-indigo-300", required: true %>
  </div>

  <!-- Select Opponent (with search) -->
  <div>
    <%= f.label :opponent_id, "Select Opponent", class: "block font-semibold mb-1" %>
    <select id="opponent-select"
            name="match[opponent_id]"
            class="border p-2 w-full rounded-md focus:ring focus:ring-indigo-300">
      <option value="" disabled selected>Choose an opponent</option>
      <% @users.each do |user| %>
        <option value="<%= user.id %>"><%= user.username %></option>
      <% end %>
    </select>
  </div>

  <!-- Select Winner -->
  <div>
    <%= f.label :winner_id, "Who won?", class: "block font-semibold mb-1" %>
    <div class="flex flex-col space-y-2" id="winner-options">
      <label class="flex items-center space-x-2">
        <%= f.radio_button :winner_id, current_user.id, id: "winner-player1", class: "mr-2" %>
        <span><%= current_user.username %></span>
      </label>

      <label class="flex items-center space-x-2 hidden" id="winner-player2-option">
        <%= f.radio_button :winner_id, nil, id: "winner-player2", class: "mr-2" %>
        <span id="winner-player2-name"></span>
      </label>
    </div>
  </div>

  <!-- Submit Button -->
  <div>
    <button id="submit-button" type="submit"
            class="w-full bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition flex items-center justify-center">
      <span id="submit-text">Log Match</span>
      <svg id="spinner" class="hidden ml-2 w-5 h-5 animate-spin text-white" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor"
              d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </button>
  </div>

<% end %>

<!-- Toast Notification -->
<div id="success-toast" class="hidden fixed top-5 right-5 bg-green-500 text-white px-4 py-2 rounded-md shadow-lg">
  Match Successfully Logged!
</div>

<!-- JavaScript -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("match-form");
        const opponentSelect = document.getElementById("opponent-select");
        const winnerPlayer2Option = document.getElementById("winner-player2-option");
        const winnerPlayer2Radio = document.getElementById("winner-player2");
        const winnerPlayer2Name = document.getElementById("winner-player2-name");
        const submitButton = document.getElementById("submit-button");
        const submitText = document.getElementById("submit-text");
        const spinner = document.getElementById("spinner");
        const successToast = document.getElementById("success-toast");

        function updateWinnerOptions() {
            const selectedOpponent = opponentSelect.options[opponentSelect.selectedIndex];

            if (selectedOpponent && selectedOpponent.value) {
                winnerPlayer2Radio.value = selectedOpponent.value;
                winnerPlayer2Name.textContent = selectedOpponent.text;
                winnerPlayer2Option.classList.remove("hidden");
            } else {
                winnerPlayer2Option.classList.add("hidden");
            }
        }

        if (opponentSelect) {
            opponentSelect.addEventListener("change", updateWinnerOptions);
        }

        // Initialize searchable dropdown (Using Tom Select.js for better UX)
        new TomSelect("#opponent-select", {
            maxItems: 1,
            create: false,
            allowEmptyOption: false,
            placeholder: "Search for an opponent..."
        });

        form.addEventListener("submit", function (event) {
            event.preventDefault();
            submitButton.disabled = true;
            submitText.textContent = "Logging Match...";
            spinner.classList.remove("hidden");

            // Simulate a delay (like a real-world API request)
            setTimeout(() => {
                successToast.classList.remove("hidden");
                submitButton.disabled = false;
                submitText.textContent = "Log Match";
                spinner.classList.add("hidden");

                // Auto-hide toast after 3 seconds
                setTimeout(() => {
                    successToast.classList.add("hidden");
                }, 3000);

                // Submit the form properly after the visual feedback
                form.submit();
            }, 1500);
        });
    });
</script>

<!-- Include Tom Select.js -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
