<h1>Log a Match</h1>

<%= form_with(model: @match, local: true) do |f| %>

  <!-- Select Leaderboard -->
  <div>
    <%= f.label :leaderboard_id, "Select Leaderboard" %>
    <%= f.collection_select :leaderboard_id, @leaderboards, :id, :name, prompt: "Choose leaderboard" %>
  </div>

  <!-- Select Opponent -->
  <div>
    <%= f.label :opponent_id, "Select Opponent" %>
    <%= f.collection_select :opponent_id, @users, :id, :email, prompt: "Choose opponent" %>
  </div>

  <!-- Select Winner -->
  <div>
    <%= f.label :winner_id, "Who won?" %>
    <%= f.radio_button :winner_id, current_user.id %> <%= current_user.username %>
    <%= f.radio_button :winner_id, nil %> Draw
    <%= f.radio_button :winner_id, nil, checked: true %> TBD
  </div>

  <!-- Dynamic Metadata Fields (Based on Sport Type) -->
  <div id="metadata-fields">
    <h3>Additional Match Details (Optional)</h3>
    <div id="metadata-container"></div>
  </div>

  <div>
    <%= f.submit "Log Match" %>
  </div>
<% end %>

<!-- JavaScript to dynamically load sport-specific metadata fields -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const leaderboardSelect = document.getElementById("match_leaderboard_id");
        const metadataContainer = document.getElementById("metadata-container");

        leaderboardSelect.addEventListener("change", function() {
            fetch(`/api/v1/leaderboards/${this.value}.json`)
                .then(response => response.json())
                .then(data => {
                    metadataContainer.innerHTML = ""; // Clear existing fields

                    // Check if metadata is available for the selected sport type
                    if (data.sport_type && data.sport_type.metadata_template) {
                        Object.keys(data.sport_type.metadata_template).forEach(field => {
                            const label = document.createElement("label");
                            label.textContent = field.replace(/_/g, " ").toUpperCase();

                            const input = document.createElement("input");
                            input.type = "text";
                            input.name = `match[metadata][${field}]`;

                            metadataContainer.appendChild(label);
                            metadataContainer.appendChild(input);
                        });
                    }
                });
        });
    });
</script>
