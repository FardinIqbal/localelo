<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-2xl md:text-3xl font-bold text-white">My Organizations</h1>
      <p class="mt-1 text-slate-400">Manage the organizations you're a member of</p>
    </div>
    <%= link_to new_organization_path, class: "mt-4 md:mt-0 inline-flex items-center justify-center font-medium rounded-md transition-all duration-300 h-10 px-4 py-2 text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-1" do %>
      <i class="fas fa-plus mr-2"></i>
      Create Organization
    <% end %>
  </div>

  <!-- Organizations Grid -->
  <% if @organizations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @organizations.each do |organization| %>
        <% is_admin = organization.admin?(current_user) %>
        <div class="bg-slate-800/60 backdrop-blur-sm rounded-xl border border-white/10 shadow-xl overflow-hidden hover:shadow-purple-500/10 transition-all duration-300 hover:-translate-y-1 group">
          <div class="h-32 bg-gradient-to-r from-indigo-900/50 to-purple-900/50 flex items-center justify-center relative overflow-hidden">
            <% if organization.name.present? %>
              <div class="text-5xl font-bold text-white/10 absolute inset-0 flex items-center justify-center">
                <%= organization.name.first.upcase %>
              </div>
            <% end %>
            <% if organization.location.present? %>
              <div class="absolute bottom-3 left-4 bg-slate-900/80 backdrop-blur-sm rounded-md px-2 py-1 text-xs text-slate-300 flex items-center">
                <i class="fas fa-map-marker-alt mr-1.5 text-pink-500"></i>
                <%= organization.location %>
              </div>
            <% end %>
          </div>

          <div class="p-5">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-white group-hover:text-pink-500 transition-colors duration-300">
                <%= link_to organization.name, organization_path(organization) %>
              </h3>
              <div class="flex space-x-1">
                <% if is_admin %>
                  <span class="bg-purple-900/50 text-purple-300 text-xs px-2 py-1 rounded-md">Admin</span>
                <% end %>
              </div>
            </div>

            <p class="text-slate-400 text-sm mb-4 line-clamp-2">
              <%= organization.description.present? ? organization.description : "No description provided" %>
            </p>

            <div class="flex items-center justify-between">
              <div class="flex items-center text-slate-400 text-sm">
                <i class="fas fa-users mr-1.5 text-indigo-400"></i>
                <%= organization.organization_memberships.count %> members
              </div>

              <div class="flex items-center text-slate-400 text-sm">
                <i class="fas fa-trophy mr-1.5 text-indigo-400"></i>
                <%= organization.leaderboards.count %> leaderboards
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-white/5 flex justify-between">
              <%= link_to organization_path(organization), class: "text-sm text-indigo-400 hover:text-pink-500 transition-colors duration-300 flex items-center" do %>
                <i class="fas fa-eye mr-1.5"></i>
                View
              <% end %>

              <% if is_admin %>
                <%= link_to edit_organization_path(organization), class: "text-sm text-indigo-400 hover:text-pink-500 transition-colors duration-300 flex items-center" do %>
                  <i class="fas fa-edit mr-1.5"></i>
                  Edit
                <% end %>
              <% end %>

              <%= link_to organization_leaderboards_path(organization), class: "text-sm text-indigo-400 hover:text-pink-500 transition-colors duration-300 flex items-center" do %>
                <i class="fas fa-chart-line mr-1.5"></i>
                Leaderboards
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <!-- Empty State -->
    <div class="bg-slate-800/60 backdrop-blur-sm rounded-xl border border-white/10 shadow-xl p-8 text-center">
      <div class="w-20 h-20 bg-slate-700/50 rounded-full flex items-center justify-center mx-auto mb-6">
        <i class="fas fa-users text-3xl text-slate-500"></i>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">No Organizations Yet</h3>
      <p class="text-slate-400 max-w-md mx-auto mb-6">
        You're not a member of any organizations yet. Create your own organization or join an existing one to get started.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <%= link_to new_organization_path, class: "inline-flex items-center justify-center font-medium rounded-md transition-all duration-300 h-10 px-4 py-2 text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-1" do %>
          <i class="fas fa-plus mr-2"></i>
          Create Organization
        <% end %>

        <%= link_to organizations_path, class: "inline-flex items-center justify-center font-medium rounded-md transition-all duration-300 h-10 px-4 py-2 text-white bg-slate-700 hover:bg-slate-600 border border-white/10" do %>
          <i class="fas fa-search mr-2"></i>
          Explore Organizations
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Pagination (if needed) -->
  <% if @organizations.respond_to?(:total_pages) && @organizations.total_pages > 1 %>
    <div class="mt-8 flex justify-center">
      <nav class="flex items-center space-x-1">
        <% if @organizations.prev_page %>
          <%= link_to account_organizations_path(page: @organizations.prev_page), class: "px-3 py-2 rounded-md text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-colors duration-300" do %>
            <i class="fas fa-chevron-left"></i>
          <% end %>
        <% else %>
          <span class="px-3 py-2 rounded-md text-sm font-medium bg-slate-800/50 text-slate-500 cursor-not-allowed">
            <i class="fas fa-chevron-left"></i>
          </span>
        <% end %>

        <% (1..@organizations.total_pages).each do |page| %>
          <% if page == @organizations.current_page %>
            <span class="px-3 py-2 rounded-md text-sm font-medium bg-indigo-900/70 text-white">
              <%= page %>
            </span>
          <% else %>
            <%= link_to page, account_organizations_path(page: page), class: "px-3 py-2 rounded-md text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-colors duration-300" %>
          <% end %>
        <% end %>

        <% if @organizations.next_page %>
          <%= link_to account_organizations_path(page: @organizations.next_page), class: "px-3 py-2 rounded-md text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-colors duration-300" do %>
            <i class="fas fa-chevron-right"></i>
          <% end %>
        <% else %>
          <span class="px-3 py-2 rounded-md text-sm font-medium bg-slate-800/50 text-slate-500 cursor-not-allowed">
            <i class="fas fa-chevron-right"></i>
          </span>
        <% end %>
      </nav>
    </div>
  <% end %>
</div>