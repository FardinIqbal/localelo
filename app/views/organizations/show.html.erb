<!-- app/views/organizations/show.html.erb -->
<div class="relative min-h-screen bg-slate-900 text-white" data-controller="organization-tabs">
  <!-- Decorative Background Elements - Hidden on mobile for performance -->
  <div class="decorative-blur absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse z-0"></div>
  <div class="decorative-blur absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse z-0 delay-1000"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-6">

    <!-- Gym Header with Actions -->
    <div class="flex flex-col mb-6">
      <div class="flex flex-wrap justify-between items-start">
        <h1 class="font-extrabold text-3xl md:text-5xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
          <%= @organization.name %>
        </h1>

        <% if @organization.member?(current_user) %>
          <%= link_to leave_organization_path(@organization),
                      data: { turbo_method: :delete, confirm: "Are you sure you want to leave this gym?" },
                      class: "mt-2 px-3 py-1.5 rounded-lg bg-red-500/20 text-red-400 border border-red-500/30 text-sm font-medium hover:bg-red-500/30 transition-all flex items-center" do %>
            <i class="fas fa-sign-out-alt mr-1.5"></i> Leave
          <% end %>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-2 text-slate-400">
        <% if @organization.location.present? %>
      <span class="flex items-center">
        <i class="fas fa-map-marker-alt mr-2"></i> <%= @organization.location %>
      </span>
        <% end %>
        <span class="flex items-center">
          <i class="fas fa-<%= @organization.open? ? 'globe' : 'lock' %> mr-2"></i>
          <%= @organization.visibility.humanize %>
        </span>
      </div>

      <!-- Mobile Action Buttons - Horizontal Scrollable -->
      <div class="mt-4 md:hidden overflow-x-auto pb-2 -mx-4 px-4 scrollbar-hide scroll-smooth-touch">
        <div class="flex space-x-3 w-max">
          <% if @organization.owner?(current_user) || @organization.admin?(current_user) %>
            <%= link_to edit_organization_path(@organization), class: "whitespace-nowrap px-5 py-3 rounded-xl bg-slate-700 text-white font-medium hover:bg-slate-600 transition-all flex items-center touch-target touch-active" do %>
              <i class="fas fa-edit mr-2"></i> Edit Gym
            <% end %>

            <%= link_to new_organization_leaderboard_path(@organization), class: "whitespace-nowrap px-5 py-3 rounded-xl bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium shadow-lg shadow-purple-500/20 transition-all flex items-center touch-target touch-active" do %>
              <i class="fas fa-plus mr-2"></i> Add Leaderboard
            <% end %>
          <% end %>

          <% unless @organization.member?(current_user) %>
            <%= link_to join_organization_path(@organization),
                        data: { turbo_method: :post },
                        class: "whitespace-nowrap px-5 py-3 rounded-xl bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium shadow-lg shadow-purple-500/20 transition-all flex items-center touch-target touch-active" do %>
              <i class="fas fa-user-plus mr-2"></i> <%= @organization.open? ? "Join Gym" : "Request to Join" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Desktop Action Buttons -->
      <div class="hidden md:flex mt-4 flex-wrap gap-3">
        <% if @organization.owner?(current_user) || @organization.admin?(current_user) %>
          <%= link_to edit_organization_path(@organization), class: "px-4 py-2 rounded-lg bg-slate-700 text-white font-medium hover:bg-slate-600 transition-all" do %>
            <i class="fas fa-edit mr-2"></i> Edit Gym
          <% end %>

          <%= link_to new_organization_leaderboard_path(@organization), class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
            <i class="fas fa-plus mr-2"></i> Add Leaderboard
          <% end %>
        <% end %>

        <% unless @organization.member?(current_user) %>
          <%= link_to join_organization_path(@organization),
                      data: { turbo_method: :post },
                      class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
            <i class="fas fa-user-plus mr-2"></i> <%= @organization.open? ? "Join Gym" : "Request to Join" %>
          <% end %>
        <% end %>
      </div>
    </div>


    <!-- Tab Navigation - Horizontally scrollable on mobile -->
    <div class="mb-6 border-b border-slate-700 -mx-4 px-4 md:mx-0 md:px-0">
      <div class="overflow-x-auto scrollbar-hide scroll-smooth-touch">
        <ul class="flex -mb-px text-sm font-medium min-w-max" id="gym-tabs" role="tablist">
          <li role="presentation">
            <button class="inline-flex items-center justify-center px-4 py-3 md:px-5 md:py-4 border-b-2 border-purple-500 text-purple-400 font-semibold whitespace-nowrap touch-target active transition-colors" 
                    id="overview-tab" data-tabs-target="overview" data-organization-tabs-target="button" data-action="click->organization-tabs#changeTab" type="button" role="tab" aria-controls="overview" aria-selected="true">
              <i class="fas fa-home mr-2 md:hidden"></i>
              <span>Overview</span>
            </button>
          </li>
          <li role="presentation">
            <button class="inline-flex items-center justify-center px-4 py-3 md:px-5 md:py-4 border-b-2 border-transparent text-slate-400 hover:text-purple-400 hover:border-purple-400/50 whitespace-nowrap touch-target transition-colors" 
                    id="leaderboards-tab" data-tabs-target="leaderboards" data-organization-tabs-target="button" data-action="click->organization-tabs#changeTab" type="button" role="tab" aria-controls="leaderboards" aria-selected="false">
              <i class="fas fa-trophy mr-2 md:hidden"></i>
              <span>Leaderboards</span>
            </button>
          </li>
          <li role="presentation">
            <button class="inline-flex items-center justify-center px-4 py-3 md:px-5 md:py-4 border-b-2 border-transparent text-slate-400 hover:text-purple-400 hover:border-purple-400/50 whitespace-nowrap touch-target transition-colors" 
                    id="members-tab" data-tabs-target="members" data-organization-tabs-target="button" data-action="click->organization-tabs#changeTab" type="button" role="tab" aria-controls="members" aria-selected="false">
              <i class="fas fa-users mr-2 md:hidden"></i>
              <span>Members</span>
            </button>
          </li>
          <li role="presentation">
            <button class="inline-flex items-center justify-center px-4 py-3 md:px-5 md:py-4 border-b-2 border-transparent text-slate-400 hover:text-purple-400 hover:border-purple-400/50 whitespace-nowrap touch-target transition-colors" 
                    id="matches-tab" data-tabs-target="matches" data-organization-tabs-target="button" data-action="click->organization-tabs#changeTab" type="button" role="tab" aria-controls="matches" aria-selected="false">
              <i class="fas fa-gamepad mr-2 md:hidden"></i>
              <span>Matches</span>
            </button>
          </li>
          <% if @organization.owner?(current_user) || @organization.admin?(current_user) %>
            <li role="presentation">
              <button class="inline-flex items-center justify-center px-4 py-3 md:px-5 md:py-4 border-b-2 border-transparent text-slate-400 hover:text-purple-400 hover:border-purple-400/50 whitespace-nowrap touch-target transition-colors" 
                      id="manage-tab" data-tabs-target="manage" data-organization-tabs-target="button" data-action="click->organization-tabs#changeTab" type="button" role="tab" aria-controls="manage" aria-selected="false">
                <i class="fas fa-cog mr-2 md:hidden"></i>
                <span>Manage</span>
              </button>
            </li>
          <% end %>
        </ul>
      </div>
      <!-- Scroll indicator for mobile -->
      <div class="md:hidden flex justify-center mt-1">
        <div class="flex space-x-1">
          <div class="w-1 h-1 rounded-full bg-slate-600"></div>
          <div class="w-1 h-1 rounded-full bg-slate-600"></div>
          <div class="w-1 h-1 rounded-full bg-slate-600"></div>
        </div>
      </div>
    </div>

    <!-- Tab Content -->
    <div id="gym-content">
      <!-- Overview Tab -->
      <div class="block" id="overview" role="tabpanel" aria-labelledby="overview-tab" data-organization-tabs-target="content">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Gym Info & Stats -->
          <div class="lg:col-span-2">
            <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 p-5 mb-6">
              <h2 class="text-xl font-bold text-white mb-3">About this Gym</h2>
              <% if @organization.description.present? %>
                <p class="text-slate-300 whitespace-pre-line"><%= @organization.description %></p>
              <% else %>
                <p class="text-slate-400 italic">No description available</p>
              <% end %>

              <% if @organization.website.present? %>
                <div class="mt-4 flex items-center text-purple-400">
                  <i class="fas fa-link mr-2"></i>
                  <%= link_to @organization.website, @organization.website, target: "_blank", rel: "noopener", class: "hover:text-pink-400 transition-colors" %>
                </div>
              <% end %>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
                <div class="text-sm text-slate-400">Active Players</div>
                <div class="text-2xl font-bold text-white mt-1"><%= @active_member_count %></div>
                <div class="mt-2 text-xs text-purple-400">
                  <i class="fas fa-users mr-1"></i> of <%= @member_count %> members
                </div>
              </div>

              <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
                <div class="text-sm text-slate-400">Leaderboards</div>
                <div class="text-2xl font-bold text-white mt-1"><%= @leaderboard_count %></div>
                <div class="mt-2 text-xs text-pink-400">
                  <i class="fas fa-list-ol mr-1"></i> Ranking systems
                </div>
              </div>

              <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
                <div class="text-sm text-slate-400">Total Matches</div>
                <div class="text-2xl font-bold text-white mt-1"><%= @total_matches_count %></div>
                <div class="mt-2 text-xs text-purple-400">
                  <i class="fas fa-trophy mr-1"></i> All time
                </div>
              </div>

              <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
                <div class="text-sm text-slate-400">Created</div>
                <div class="text-2xl font-bold text-white mt-1"><%= @organization.created_at.strftime("%b %Y") %></div>
                <div class="mt-2 text-xs text-pink-400">
                  <i class="fas fa-calendar mr-1"></i> <%= time_ago_in_words(@organization.created_at) %> ago
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="space-y-6">
            <!-- Top Rivals -->
            <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
              <div class="flex items-center justify-between p-4 border-b border-slate-700 bg-gradient-to-r from-pink-500/10 to-purple-500/10">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-pink-500 to-orange-500 flex items-center justify-center">
                    <i class="fas fa-fire text-white text-sm"></i>
                  </div>
                  <h3 class="text-lg font-bold text-white">Top Rivals</h3>
                </div>
                <span class="text-xs text-slate-400 bg-slate-700/50 px-2 py-1 rounded-full">Most played</span>
              </div>

              <% if @viewer_profile.nil? %>
                <div class="p-6 text-center">
                  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-pink-500/20 to-purple-500/20 text-pink-400 mb-3">
                    <i class="fas fa-lock text-xl"></i>
                  </div>
                  <p class="text-sm text-slate-400 mb-4">
                    Join this gym to discover your top rivals
                  </p>
                  <%= link_to join_organization_path(@organization),
                              data: { turbo_method: :post },
                              class: "inline-flex items-center px-4 py-2 rounded-lg bg-gradient-to-r from-pink-500 to-purple-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-pink-500/20 transition-all" do %>
                    <i class="fas fa-user-plus mr-2"></i> Join Gym
                  <% end %>
                </div>
              <% elsif @top_rivals.present? %>
                <div class="divide-y divide-slate-700/50">
                  <% @top_rivals.each_with_index do |entry, index| %>
                    <div class="p-4 hover:bg-slate-700/30 transition-colors group">
                      <div class="flex items-start gap-3">
                        <!-- Rank Badge -->
                        <div class="flex-shrink-0">
                          <div class="w-10 h-10 rounded-xl <%= index == 0 ? 'bg-gradient-to-br from-yellow-400 to-orange-500 shadow-lg shadow-orange-500/30' : (index == 1 ? 'bg-gradient-to-br from-slate-300 to-slate-400' : 'bg-gradient-to-br from-amber-600 to-amber-700') %> flex items-center justify-center text-white font-bold text-sm">
                            <% if index == 0 %>
                              <i class="fas fa-crown"></i>
                            <% else %>
                              <%= index + 1 %>
                            <% end %>
                          </div>
                        </div>
                        
                        <!-- Player Info -->
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-2 mb-1">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-xs font-bold">
                              <%= entry[:profile].username[0..1].upcase %>
                            </div>
                            <%= link_to entry[:profile].username, profile_path(entry[:profile]), class: "font-semibold text-white hover:text-pink-400 transition-colors truncate" %>
                          </div>
                          
                          <!-- Stats Row -->
                          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400 mb-3">
                            <span class="inline-flex items-center">
                              <i class="fas fa-swords text-pink-400 mr-1"></i>
                              <%= head_to_head_label(entry[:matches_together]) %>
                            </span>
                            <span class="inline-flex items-center">
                              <i class="fas fa-clock text-purple-400 mr-1"></i>
                              <%= last_played_label(entry[:matches_together], entry[:last_played_at]) %>
                            </span>
                          </div>
                          
                          <!-- Challenge Button -->
                          <%= link_to new_match_path(opponent_profile_id: entry[:profile].id, return_to_organization_id: @organization.id),
                                      class: "inline-flex items-center px-4 py-2 rounded-lg bg-gradient-to-r from-pink-500 to-purple-500 text-white text-xs font-semibold hover:shadow-lg hover:shadow-pink-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all" do %>
                            <i class="fas fa-swords mr-1.5"></i> Challenge
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="p-6 text-center">
                  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-slate-700/50 text-slate-500 mb-3">
                    <i class="fas fa-user-friends text-xl"></i>
                  </div>
                  <p class="text-sm text-slate-400 mb-1">No rivals yet</p>
                  <p class="text-xs text-slate-500">Log matches to discover your rivals</p>
                </div>
              <% end %>
            </div>

            <!-- Challengers You're Ducking -->
            <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
              <div class="flex items-center justify-between p-4 border-b border-slate-700 bg-gradient-to-r from-blue-500/10 to-purple-500/10">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center">
                    <i class="fas fa-running text-white text-sm"></i>
                  </div>
                  <h3 class="text-lg font-bold text-white">Who You're Ducking</h3>
                </div>
                <span class="text-xs text-slate-400 bg-slate-700/50 px-2 py-1 rounded-full">Least faced</span>
              </div>

              <% if @viewer_profile.nil? %>
                <div class="p-6 text-center">
                  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-purple-500/20 text-blue-400 mb-3">
                    <i class="fas fa-lock text-xl"></i>
                  </div>
                  <p class="text-sm text-slate-400 mb-4">
                    Join to see who you haven't faced yet
                  </p>
                  <%= link_to join_organization_path(@organization),
                              data: { turbo_method: :post },
                              class: "inline-flex items-center px-4 py-2 rounded-lg bg-gradient-to-r from-blue-500 to-purple-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-blue-500/20 transition-all" do %>
                    <i class="fas fa-user-plus mr-2"></i> Join Gym
                  <% end %>
                </div>
              <% elsif @ducking_opponents.present? %>
                <div class="divide-y divide-slate-700/50">
                  <% @ducking_opponents.each_with_index do |entry, index| %>
                    <div class="p-4 hover:bg-slate-700/30 transition-colors group">
                      <div class="flex items-start gap-3">
                        <!-- Rank Badge -->
                        <div class="flex-shrink-0">
                          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center text-white font-bold text-sm">
                            <%= index + 1 %>
                          </div>
                        </div>
                        
                        <!-- Player Info -->
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-2 mb-1">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white text-xs font-bold">
                              <%= entry[:profile].username[0..1].upcase %>
                            </div>
                            <%= link_to entry[:profile].username, profile_path(entry[:profile]), class: "font-semibold text-white hover:text-blue-400 transition-colors truncate" %>
                          </div>
                          
                          <!-- Stats Row -->
                          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400 mb-3">
                            <span class="inline-flex items-center">
                              <i class="fas fa-swords text-blue-400 mr-1"></i>
                              <%= head_to_head_label(entry[:matches_together]) %>
                            </span>
                            <% if entry[:last_played_at].present? %>
                              <span class="inline-flex items-center">
                                <i class="fas fa-clock text-cyan-400 mr-1"></i>
                                <%= last_played_label(entry[:matches_together], entry[:last_played_at]) %>
                              </span>
                            <% else %>
                              <span class="inline-flex items-center text-yellow-400">
                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                Never played!
                              </span>
                            <% end %>
                          </div>
                          
                          <!-- Face Them Button -->
                          <%= link_to new_match_path(opponent_profile_id: entry[:profile].id, return_to_organization_id: @organization.id),
                                      class: "inline-flex items-center px-4 py-2 rounded-lg bg-slate-700 text-white text-xs font-semibold hover:bg-slate-600 border border-slate-600 hover:border-blue-500/50 hover:scale-[1.02] active:scale-[0.98] transition-all" do %>
                            <i class="fas fa-bolt mr-1.5 text-yellow-400"></i> Face Them
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="p-6 text-center">
                  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-green-500/20 text-green-400 mb-3">
                    <i class="fas fa-check-circle text-xl"></i>
                  </div>
                  <p class="text-sm text-white font-medium mb-1">Great job!</p>
                  <p class="text-xs text-slate-400">You've faced everyone recently</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Call to Action for Non-Members -->
        <% unless @organization.member?(current_user) %>
          <div class="mt-6 bg-gradient-to-r from-purple-900/30 to-pink-900/30 backdrop-blur-sm rounded-xl border border-purple-500/30 p-6 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-purple-500/20 text-purple-400 mb-4">
              <i class="fas fa-user-plus text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Join <%= @organization.name %></h3>
            <p class="text-slate-300 mb-4 max-w-md mx-auto">
              Become a member to compete in leaderboards, track your progress, and connect with other players.
            </p>
            <%= link_to join_organization_path(@organization),
                        data: { turbo_method: :post },
                        class: "inline-block px-6 py-3 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all transform hover:-translate-y-0.5" do %>
              <i class="fas fa-user-plus mr-2"></i> <%= @organization.open? ? "Join Now" : "Request to Join" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Leaderboards Tab -->
      <div class="hidden" id="leaderboards" role="tabpanel" aria-labelledby="leaderboards-tab" data-organization-tabs-target="content">
        <div class="mb-6 flex justify-between items-center">
          <h2 class="text-2xl font-bold text-white">All Leaderboards</h2>
          <% if @organization.admin?(current_user) %>
            <%= link_to new_organization_leaderboard_path(@organization), class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
              <i class="fas fa-plus mr-2"></i> Create Leaderboard
            <% end %>
          <% end %>
        </div>

        <% if @leaderboards.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @leaderboards.each do |leaderboard| %>
              <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-700">
                  <div class="flex justify-between items-start">
                    <div class="flex items-center">
                      <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold">
                        <%= leaderboard.name[0..1].upcase %>
                      </div>
                      <div class="ml-3">
                        <h3 class="text-xl font-bold text-white"><%= leaderboard.name %></h3>
                        <div class="text-xs text-slate-400 mt-1">
                          <%= leaderboard.leaderboard_ratings.count %> players
                          -  <%= Match.where(leaderboard_id: leaderboard.id).count %> matches
                        </div>
                      </div>
                    </div>

                    <% if @organization.admin?(current_user) %>
                      <div class="flex space-x-2">
                        <%= link_to edit_organization_leaderboard_path(@organization, leaderboard), class: "text-slate-400 hover:text-white transition-colors" do %>
                          <i class="fas fa-edit"></i>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>

                <div class="p-4">
                  <% if leaderboard.description.present? %>
                    <p class="text-slate-300 text-sm mb-4"><%= leaderboard.description %></p>
                  <% end %>

                  <% user_rating = nil %>
                  <% if @organization.member?(current_user) %>
                    <% current_profile ||= current_user.profile_for(@organization) %>
                    <% user_rating = current_profile ? leaderboard.leaderboard_ratings.find_by(profile: current_profile) : nil %>
                  <% end %>
                  <% if user_rating %>
                    <div class="bg-slate-700/50 rounded-lg p-3 mb-4">
                      <div class="flex justify-between items-center">
                        <span class="text-sm text-slate-400">Your Rating</span>
                        <div>
                          <span class="text-lg font-bold text-purple-400"><%= user_rating.rating.round %></span>
                          <span class="text-xs text-slate-400">±<%= user_rating.rating_deviation.round %></span>
                        </div>
                      </div>
                      <div class="flex justify-between items-center mt-1">
                        <span class="text-xs text-slate-400">Rank</span>
                        <span class="text-sm text-slate-300">#<%= leaderboard.leaderboard_ratings.where('rating > ?', user_rating.rating).count + 1 %></span>
                      </div>
                      <div class="flex justify-between items-center mt-1">
                        <span class="text-xs text-slate-400">Record</span>
                        <span class="text-sm text-slate-300"><%= user_rating.wins %>W-<%= user_rating.losses %>L</span>
                      </div>
                    </div>
                  <% end %>

                  <div class="flex justify-between items-center">
                    <span class="text-sm font-medium text-slate-300">Top Players</span>
                    <%= link_to rankings_organization_leaderboard_path(@organization, leaderboard), class: "text-sm text-purple-400 hover:text-pink-400 transition-colors" do %>
                      View All <i class="fas fa-arrow-right ml-1"></i>
                    <% end %>
                  </div>

                  <div class="mt-2 space-y-2">
                    <% leaderboard.leaderboard_ratings.order(rating: :desc).limit(3).each_with_index do |rating, index| %>
                      <div class="flex justify-between items-center p-2 rounded bg-slate-700/50">
                        <div class="flex items-center">
                          <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold <%= index == 0 ? 'bg-yellow-400/20 text-yellow-400' : (index == 1 ? 'bg-slate-400/20 text-slate-400' : 'bg-amber-700/20 text-amber-700') %>">
                            <%= index + 1 %>
                          </div>
                          <span class="ml-2 text-sm text-white"><%= link_to rating.profile.username, profile_path(rating.profile), class: "hover:text-purple-300 transition-colors" %></span>
                        </div>
                        <span class="text-sm font-medium text-purple-400"><%= rating.rating.round %></span>
                      </div>
                    <% end %>
                  </div>

                  <div class="mt-4">
                    <%= link_to new_match_path(leaderboard_id: leaderboard.id), class: "w-full px-3 py-2 rounded-lg bg-slate-700 text-white text-sm font-medium hover:bg-slate-600 transition-all text-center block" do %>
                      <i class="fas fa-plus mr-2"></i> Log Match
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 p-12 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700 text-slate-500 mb-4">
              <i class="fas fa-trophy text-2xl"></i>
            </div>
            <p class="text-slate-400 mb-4">No leaderboards have been created yet</p>
            <% if @organization.admin?(current_user) %>
              <%= link_to new_organization_leaderboard_path(@organization), class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
                <i class="fas fa-plus mr-2"></i> Create First Leaderboard
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Members Tab -->
      <div class="hidden" id="members" role="tabpanel" aria-labelledby="members-tab" data-organization-tabs-target="content">
        <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <h2 class="text-2xl font-bold text-white">Members</h2>
          <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
            <div class="relative flex-grow sm:flex-grow-0">
              <input type="text" id="member-search" placeholder="Search members..." 
                     class="w-full bg-slate-700 border border-slate-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent touch-target"
                     data-action="input->organization-tabs#filterMembersSearch">
              <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                <i class="fas fa-search text-slate-400"></i>
              </div>
            </div>

            <% if @organization.admin?(current_user) %>
              <select id="member-status-filter" class="bg-slate-700 border border-slate-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent touch-target"
                      data-action="change->organization-tabs#filterMembersStatus">
                <option value="all">All Members</option>
                <option value="approved">Approved</option>
                <option value="pending">Pending</option>
              </select>
            <% end %>
          </div>
        </div>

        <p class="text-slate-400 text-sm mb-4">
          Membership status determines access, while admin and owner roles are granted separately once a member is approved.
        </p>

        <!-- Mobile Card View -->
        <div class="md:hidden space-y-3" id="members-cards">
          <% @organization.organization_memberships.includes(:organization_role, profile: :user).each do |membership| %>
            <div class="bg-slate-800/70 rounded-xl border border-slate-700 p-4 member-card"
                 data-username="<%= membership.profile.username.to_s.downcase %>"
                 data-status="<%= membership.status %>">
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center">
                  <div class="w-12 h-12 rounded-full bg-slate-700 flex items-center justify-center text-white font-bold text-lg">
                    <%= membership.profile.username.to_s[0..1].upcase %>
                  </div>
                  <div class="ml-3">
                    <div class="text-white font-medium text-lg">
                      <%= link_to membership.profile.username, profile_path(membership.profile), class: "hover:text-purple-300 transition-colors" %>
                    </div>
                    <div class="text-xs text-slate-400"><%= membership.profile.user&.email || "User unavailable" %></div>
                  </div>
                </div>
                <% if membership.status == "approved" %>
                  <span class="px-2 py-1 rounded-full text-xs font-medium bg-green-400/20 text-green-400">Approved</span>
                <% elsif membership.status == "pending" %>
                  <span class="px-2 py-1 rounded-full text-xs font-medium bg-yellow-400/20 text-yellow-400">Pending</span>
                <% end %>
              </div>
              
              <div class="grid grid-cols-3 gap-3 text-center mb-3">
                <div class="bg-slate-900/50 rounded-lg p-2">
                  <div class="text-xs text-slate-400">Matches</div>
                  <div class="text-sm font-bold text-white">
                    <%= Match.joins(:leaderboard, :match_participants)
                             .where(leaderboards: { organization_id: @organization.id })
                             .where(match_participants: { profile_id: membership.profile_id })
                             .distinct
                             .count %>
                  </div>
                </div>
                <div class="bg-slate-900/50 rounded-lg p-2">
                  <div class="text-xs text-slate-400">Rating</div>
                  <div class="text-sm font-bold text-purple-400">
                    <%= (LeaderboardRating.joins(:leaderboard)
                                          .where(profile_id: membership.profile_id, leaderboards: { organization_id: @organization.id })
                                          .maximum(:rating) || 1500).round %>
                  </div>
                </div>
                <div class="bg-slate-900/50 rounded-lg p-2">
                  <div class="text-xs text-slate-400">Joined</div>
                  <div class="text-sm font-medium text-slate-300"><%= membership.created_at.strftime("%b %Y") %></div>
                </div>
              </div>
              
              <% if @organization.admin?(current_user) %>
                <div class="flex items-center justify-between pt-3 border-t border-slate-700">
                  <div>
                    <% if @organization.owner?(membership.profile.user) %>
                      <span class="px-2 py-1 rounded-full text-xs font-medium bg-purple-400/20 text-purple-400">Owner</span>
                    <% elsif membership.admin? %>
                      <span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-400/20 text-blue-400">Admin</span>
                    <% else %>
                      <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-400/20 text-slate-400">Member</span>
                    <% end %>
                  </div>
                  <div class="flex items-center space-x-3">
                    <% if membership.status == "pending" %>
                      <%= link_to approve_member_organization_path(@organization, user_id: membership.user&.id), data: { turbo_method: :patch }, class: "w-10 h-10 flex items-center justify-center rounded-full bg-green-400/20 text-green-400 hover:bg-green-400/30 transition-colors touch-target" do %>
                        <i class="fas fa-check"></i>
                      <% end %>
                    <% end %>
                    <% if !@organization.owner?(membership.user) && membership.user&.id != current_user.id %>
                      <% if membership.admin? %>
                        <button class="w-10 h-10 flex items-center justify-center rounded-full bg-blue-400/20 text-blue-400 hover:bg-blue-400/30 transition-colors demote-admin-btn touch-target" data-user-id="<%= membership.user&.id %>">
                          <i class="fas fa-arrow-down"></i>
                        </button>
                      <% else %>
                        <button class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-700 text-slate-300 hover:bg-slate-600 transition-colors promote-admin-btn touch-target" data-user-id="<%= membership.user&.id %>">
                          <i class="fas fa-arrow-up"></i>
                        </button>
                      <% end %>
                      <button class="w-10 h-10 flex items-center justify-center rounded-full bg-red-400/20 text-red-400 hover:bg-red-400/30 transition-colors remove-member-btn touch-target" data-user-id="<%= membership.user&.id %>">
                        <i class="fas fa-user-minus"></i>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Desktop Table View -->
        <div class="hidden md:block bg-slate-800/70 rounded-xl border border-slate-700 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead class="bg-slate-700/50 text-xs uppercase text-slate-400">
              <tr>
                <th class="px-4 py-3">Member</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3">Joined</th>
                <th class="px-4 py-3">Matches</th>
                <th class="px-4 py-3">Highest Rating</th>
                <% if @organization.admin?(current_user) %>
                  <th class="px-4 py-3">Role</th>
                  <th class="px-4 py-3">Actions</th>
                <% end %>
              </tr>
              </thead>
              <tbody class="divide-y divide-slate-700" id="members-table-body">
              <% @organization.organization_memberships.includes(:organization_role, profile: :user).each do |membership| %>
                <tr class="hover:bg-slate-700/50 transition-colors">
                  <td class="px-4 py-3">
                    <div class="flex items-center">
                      <div class="w-10 h-10 rounded-full bg-slate-700 flex items-center justify-center text-white font-bold">
                        <%= membership.profile.username.to_s[0..1].upcase %>
                      </div>
                      <div class="ml-3">
                        <div class="text-white font-medium"><%= link_to membership.profile.username, profile_path(membership.profile), class: "hover:text-purple-300 transition-colors" %></div>
                        <div class="text-xs text-slate-400"><%= membership.profile.user&.email || "User unavailable" %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <% if membership.status == "approved" %>
                      <span class="px-2 py-1 rounded-full text-xs font-medium bg-green-400/20 text-green-400">Approved</span>
                    <% elsif membership.status == "pending" %>
                      <span class="px-2 py-1 rounded-full text-xs font-medium bg-yellow-400/20 text-yellow-400">Pending</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-slate-400 text-sm">
                    <%= membership.created_at.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-4 py-3 text-slate-400 text-sm">
                    <%= Match.joins(:leaderboard, :match_participants)
                             .where(leaderboards: { organization_id: @organization.id })
                             .where(match_participants: { profile_id: membership.profile_id })
                             .distinct
                             .count %>
                  </td>
                  <td class="px-4 py-3 text-purple-400 font-medium">
                    <%= (LeaderboardRating.joins(:leaderboard)
                                          .where(profile_id: membership.profile_id, leaderboards: { organization_id: @organization.id })
                                          .maximum(:rating) || 1500).round %>
                  </td>
                  <% if @organization.admin?(current_user) %>
                    <td class="px-4 py-3">
                      <% if @organization.owner?(membership.profile.user) %>
                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-purple-400/20 text-purple-400">Owner</span>
                      <% elsif membership.admin? %>
                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-400/20 text-blue-400">Admin</span>
                      <% else %>
                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-400/20 text-slate-400">Member</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <div class="flex items-center space-x-2">
                        <% if membership.status == "pending" %>
                          <%= link_to approve_member_organization_path(@organization, user_id: membership.user&.id), data: { turbo_method: :patch }, class: "text-green-400 hover:text-green-300 transition-colors" do %>
                            <i class="fas fa-check"></i>
                          <% end %>
                        <% end %>

                        <% if !@organization.owner?(membership.user) && membership.user&.id != current_user.id %>
                          <% if membership.admin? %>
                            <button class="text-blue-400 hover:text-blue-300 transition-colors demote-admin-btn" data-user-id="<%= membership.user&.id %>">
                              <i class="fas fa-arrow-down"></i>
                            </button>
                          <% else %>
                            <button class="text-slate-400 hover:text-white transition-colors promote-admin-btn" data-user-id="<%= membership.user&.id %>">
                              <i class="fas fa-arrow-up"></i>
                            </button>
                          <% end %>

                          <button class="text-red-400 hover:text-red-300 transition-colors remove-member-btn" data-user-id="<%= membership.user&.id %>">
                            <i class="fas fa-user-minus"></i>
                          </button>
                        <% end %>
                      </div>
                    </td>
                  <% end %>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Matches Tab -->
      <div class="hidden" id="matches" role="tabpanel" aria-labelledby="matches-tab" data-organization-tabs-target="content">
        <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <h2 class="text-2xl font-bold text-white">Recent Matches</h2>
          <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
            <div class="relative flex-grow sm:flex-grow-0">
              <input type="text" id="match-search" placeholder="Search matches..." 
                     class="w-full bg-slate-700 border border-slate-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent touch-target">
              <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                <i class="fas fa-search text-slate-400"></i>
              </div>
            </div>

            <select id="match-leaderboard-filter" class="bg-slate-700 border border-slate-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent touch-target"
                    data-action="change->organization-tabs#filterMatches">
              <option value="all">All Leaderboards</option>
              <% @leaderboards.each do |leaderboard| %>
                <option value="<%= leaderboard.id %>"><%= leaderboard.name %></option>
              <% end %>
            </select>
          </div>
        </div>

        <!-- Mobile Card View for Matches -->
        <div class="md:hidden space-y-3" id="matches-cards">
          <% if @recent_matches.any? %>
            <% @recent_matches.each do |match| %>
              <% primary_profile = match.profile1 %>
              <% opponent_profile = match.opponent_profile %>
              <% primary_participant = match.participant_for(primary_profile) %>
              <% opponent_participant = match.participant_for(opponent_profile) %>
              <div class="bg-slate-800/70 rounded-xl border border-slate-700 p-4 match-card"
                   data-leaderboard="<%= match.leaderboard.name.downcase %>">
                <!-- Match Header -->
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs text-slate-400"><%= match.created_at.strftime("%b %d, %Y") %></span>
                  <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-700 text-slate-300">
                    <%= match.leaderboard.name %>
                  </span>
                </div>
                
                <!-- Players -->
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center flex-1">
                    <div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
                      <%= (primary_profile&.username || "?")[0..1].upcase %>
                    </div>
                    <div class="ml-2">
                      <% if primary_profile %>
                        <%= link_to primary_profile.username, profile_path(primary_profile), class: "text-white font-medium hover:text-purple-400 block" %>
                      <% else %>
                        <span class="text-slate-400">Unknown</span>
                      <% end %>
                      <%= rating_change_badge(primary_participant) %>
                    </div>
                  </div>
                  
                  <div class="px-3 text-slate-500 font-bold">vs</div>
                  
                  <div class="flex items-center flex-1 justify-end">
                    <div class="mr-2 text-right">
                      <% if opponent_profile %>
                        <%= link_to opponent_profile.username, profile_path(opponent_profile), class: "text-white font-medium hover:text-pink-400 block" %>
                      <% else %>
                        <span class="text-slate-400">Unknown</span>
                      <% end %>
                      <%= rating_change_badge(opponent_participant) %>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-pink-500/20 flex items-center justify-center text-pink-400 font-bold">
                      <%= (opponent_profile&.username || "?")[0..1].upcase %>
                    </div>
                  </div>
                </div>
                
                <!-- Result & Actions -->
                <div class="flex items-center justify-between pt-3 border-t border-slate-700">
                  <div>
                    <% if match.is_draw %>
                      <span class="px-3 py-1 rounded-full text-sm font-medium bg-yellow-400/20 text-yellow-400">Draw</span>
                    <% elsif match.winner_profile_id.present? %>
                      <span class="px-3 py-1 rounded-full text-sm font-medium bg-green-400/20 text-green-400">
                        <i class="fas fa-trophy mr-1"></i> <%= match.winner_profile&.username %> won
                      </span>
                    <% else %>
                      <span class="text-slate-400 text-sm">No result</span>
                    <% end %>
                  </div>
                  <% if @organization.admin?(current_user) %>
                    <div class="flex items-center space-x-2">
                      <%= link_to match_path(match), class: "w-10 h-10 flex items-center justify-center rounded-full bg-slate-700 text-slate-300 hover:bg-slate-600 transition-colors touch-target" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      <%= link_to match_path(match), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove this match?" }, class: "w-10 h-10 flex items-center justify-center rounded-full bg-red-400/20 text-red-400 hover:bg-red-400/30 transition-colors touch-target" do %>
                        <i class="fas fa-trash"></i>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="bg-slate-800/70 rounded-xl border border-slate-700 p-8 text-center">
              <p class="text-slate-400">No matches have been logged yet.</p>
            </div>
          <% end %>
        </div>

        <!-- Desktop Table View for Matches -->
        <div class="hidden md:block bg-slate-800/70 rounded-xl border border-slate-700 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead class="bg-slate-700/50 text-xs uppercase text-slate-400">
              <tr>
                <th class="px-4 py-3">Players</th>
                <th class="px-4 py-3">Leaderboard</th>
                <th class="px-4 py-3">Result</th>
                <th class="px-4 py-3">Date</th>
                <% if @organization.admin?(current_user) %>
                  <th class="px-4 py-3">Actions</th>
                <% end %> </tr>
              </thead>
              <tbody class="divide-y divide-slate-700" id="matches-table-body">
              <% if @recent_matches.any? %>
                <% @recent_matches.each do |match| %>
                  <% primary_profile = match.profile1 %>
                  <% opponent_profile = match.opponent_profile %>
                  <% primary_participant = match.participant_for(primary_profile) %>
                  <% opponent_participant = match.participant_for(opponent_profile) %>
                  <tr class="hover:bg-slate-700/50 transition-colors">
                    <td class="px-4 py-3">
                      <div class="flex items-start">
                        <div class="flex items-center">
                          <div class="w-8 h-8 rounded-full bg-purple-500/20 flex items-center justify-center text-purple-400 text-xs">
                            <%= (primary_profile&.username || "?")[0..1].upcase %>
                          </div>
                          <span class="mx-1 text-slate-500">vs</span>
                          <div class="w-8 h-8 rounded-full bg-pink-500/20 flex items-center justify-center text-pink-400 text-xs">
                            <%= (opponent_profile&.username || "?")[0..1].upcase %>
                          </div>
                        </div>
                        <div class="ml-3 text-white font-medium">
                          <div class="flex items-center">
                            <% if primary_profile %>
                              <%= link_to primary_profile.username, profile_path(primary_profile), class: "hover:text-purple-400" %>
                            <% else %>
                              <span class="text-slate-400">Unknown</span>
                            <% end %>
                            <%= rating_change_badge(primary_participant) %>
                          </div>
                          <div class="text-xs text-slate-500 uppercase tracking-wider my-1">vs</div>
                          <div class="flex items-center">
                            <% if opponent_profile %>
                              <%= link_to opponent_profile.username, profile_path(opponent_profile), class: "hover:text-purple-400" %>
                            <% else %>
                              <span class="text-slate-400">Unknown</span>
                            <% end %>
                            <%= rating_change_badge(opponent_participant) %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-slate-300"> <%= match.leaderboard.name %> </td>
                    <td class="px-4 py-3">
                      <% if match.is_draw %>
                        <span class="text-yellow-400">Draw</span>
                      <% elsif match.winner_profile_id.present? %>
                        <span class="text-green-400"><%= match.winner_profile&.username %> won</span>
                      <% else %>
                        <span class="text-slate-400">No result</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3 text-slate-400 text-sm"> <%= match.created_at.strftime("%b %d, %Y") %> </td>
                    <% if @organization.admin?(current_user) %>
                      <td class="px-4 py-3">
                        <div class="flex items-center space-x-2">
                          <%= link_to match_path(match), class: "text-slate-400 hover:text-white transition-colors" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          <%= link_to match_path(match), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove this match?" }, class: "text-red-400 hover:text-red-300 transition-colors" do %>
                            <i class="fas fa-trash"></i>
                          <% end %>
                        </div>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="<%= @organization.admin?(current_user) ? 5 : 4 %>" class="px-4 py-6 text-center text-slate-400">
                    No matches have been logged yet.
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Manage Tab (Admin Only) -->
      <% if @organization.owner?(current_user) || @organization.admin?(current_user) %>
        <div class="hidden" id="manage" role="tabpanel" aria-labelledby="manage-tab" data-organization-tabs-target="content">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Gym Settings -->
            <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
              <div class="p-4 border-b border-slate-700">
                <h2 class="text-xl font-bold text-white">Gym Settings</h2>
              </div>

              <div class="p-4">
                <%= link_to edit_organization_path(@organization), class: "w-full px-4 py-3 rounded-lg bg-slate-700 text-white font-medium hover:bg-slate-600 transition-all mb-3 flex items-center justify-center" do %>
                  <i class="fas fa-edit mr-2"></i> Edit Gym Details
                <% end %>

                <%= link_to new_organization_leaderboard_path(@organization), class: "w-full px-4 py-3 rounded-lg bg-slate-700 text-white font-medium hover:bg-slate-600 transition-all mb-3 flex items-center justify-center" do %>
                  <i class="fas fa-plus mr-2"></i> Create New Leaderboard
                <% end %>

                <% if @organization.owner?(current_user) %>
                  <%= link_to organization_path(@organization), method: :delete, data: { confirm: "Are you sure you want to delete this gym? This action cannot be undone." }, class: "w-full px-4 py-3 rounded-lg bg-red-500/20 text-red-400 border border-red-500/30 font-medium hover:bg-red-500/30 transition-all flex items-center justify-center" do %>
                    <i class="fas fa-trash mr-2"></i> Delete Gym
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Pending Requests -->
            <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
              <div class="p-4 border-b border-slate-700">
                <h2 class="text-xl font-bold text-white">Pending Requests</h2>
              </div>

              <% pending_requests = @organization.organization_memberships.where(status: :pending).includes(profile: :user) %>

              <% if pending_requests.any? %>
                <div class="divide-y divide-slate-700" id="pending-requests-list">
                  <% pending_requests.each do |request| %>
                    <div id="pending-request-<%= request.user&.id %>" class="p-4 flex justify-between items-center">
                      <div class="flex items-center">
                        <div class="w-10 h-10 rounded-full bg-slate-700 flex items-center justify-center text-white font-bold">
                          <%= request.profile.username[0..1].upcase %>
                        </div>
                        <div class="ml-3">
                          <div class="text-white font-medium"><%= request.profile.username %></div>
                          <div class="text-xs text-slate-400">Requested <%= time_ago_in_words(request.created_at) %>
                            ago
                          </div>
                        </div>
                      </div>

                      <div class="flex space-x-2">
                        <%= link_to approve_member_organization_path(@organization, user_id: request.user&.id), data: { turbo_method: :patch }, class: "px-2 py-1 rounded bg-green-400/20 text-green-400 hover:bg-green-400/30 transition-colors" do %>
                          <i class="fas fa-check mr-1"></i> Approve
                        <% end %>

                        <%= link_to organization_membership_path(request), method: :delete, data: { confirm: "Are you sure you want to reject this request?" }, class: "px-2 py-1 rounded bg-red-400/20 text-red-400 hover:bg-red-400/30 transition-colors" do %>
                          <i class="fas fa-times mr-1"></i> Reject
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div id="pending-requests-list" class="p-8 text-center">
                  <p class="text-slate-400">No pending membership requests</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Fallback script in case Stimulus controller doesn't load -->
<script>
(function() {
  function initTabs() {
    const tabButtons = document.querySelectorAll('#gym-tabs [data-tabs-target]');
    const tabContents = document.querySelectorAll('#gym-content > div[role="tabpanel"]');
    
    if (tabButtons.length === 0) return;
    
    tabButtons.forEach(function(button) {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.dataset.tabsTarget;
        
        // Hide all tab contents
        tabContents.forEach(function(content) {
          content.classList.add('hidden');
          content.classList.remove('block');
        });
        
        // Remove active state from all buttons
        tabButtons.forEach(function(btn) {
          btn.classList.remove('active', 'text-purple-400', 'border-purple-500', 'font-semibold');
          btn.classList.add('border-transparent', 'text-slate-400');
        });
        
        // Show the selected tab content
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.classList.remove('hidden');
          targetEl.classList.add('block');
        }
        
        // Add active state to clicked button
        this.classList.add('active', 'text-purple-400', 'border-purple-500', 'font-semibold');
        this.classList.remove('border-transparent', 'text-slate-400');
      });
    });
  }
  
  // Initialize on various events to ensure it works
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabs);
  } else {
    initTabs();
  }
  document.addEventListener('turbo:load', initTabs);
  document.addEventListener('turbo:render', initTabs);
})();
</script>