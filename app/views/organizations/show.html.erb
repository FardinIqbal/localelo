<%= render "shared/layouts/page_shell",
           title: @organization.name,
           subtitle: @organization.description.presence || "Keep track of matches, members, and leaderboards in one place." do %>
  <div class="space-y-10">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="space-y-2 text-sm text-slate-500">
        <% if @organization.location.present? %>
          <p><i class="fas fa-map-marker-alt mr-1 text-slate-400"></i><%= @organization.location %></p>
        <% end %>
        <p><i class="fas fa-eye mr-1 text-slate-400"></i><%= @organization.open? ? "Public" : "Private" %> organization</p>
        <p><i class="fas fa-calendar mr-1 text-slate-400"></i>Created <%= @organization.created_at.strftime("%b %Y") %></p>
        <% if @organization.website.present? %>
          <p><i class="fas fa-link mr-1 text-slate-400"></i><%= link_to @organization.website, @organization.website, class: "text-slate-600 hover:text-slate-900", target: "_blank", rel: "noopener" %></p>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if @organization.owner?(current_user) || @organization.admin?(current_user) %>
          <%= link_to edit_organization_path(@organization), class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:text-slate-900" do %>
            <i class="fas fa-edit"></i>
            Edit gym
          <% end %>
          <%= link_to new_organization_leaderboard_path(@organization), class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:text-slate-900" do %>
            <i class="fas fa-plus"></i>
            New leaderboard
          <% end %>
        <% end %>
        <% if @organization.member?(current_user) %>
          <%= link_to leave_organization_path(@organization),
                      data: { turbo_method: :delete, turbo_confirm: "Leave this organization?" },
                      class: "inline-flex items-center gap-2 rounded-xl border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-600 hover:text-rose-700" do %>
            <i class="fas fa-sign-out-alt"></i>
            Leave
          <% end %>
        <% else %>
          <%= link_to join_organization_path(@organization),
                      data: { turbo_method: :post },
                      class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
            <i class="fas fa-user-plus"></i>
            <%= @organization.open? ? "Join" : "Request access" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <section>
      <h2 class="text-lg font-semibold text-slate-900">At a glance</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Members</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @organization.users.count %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Leaderboards</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @leaderboards.count %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Matches logged</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @organization.matches.count %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Founded</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @organization.created_at.strftime("%b %Y") %></dd>
        </div>
      </dl>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Leaderboards</h2>
        <% if @organization.admin?(current_user) %>
          <%= link_to "Create leaderboard", new_organization_leaderboard_path(@organization), class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
        <% end %>
      </div>
      <% if @leaderboards.any? %>
        <div class="grid gap-4 md:grid-cols-2">
          <% @leaderboards.each do |leaderboard| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-4">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <h3 class="text-base font-semibold text-slate-900"><%= leaderboard.name %></h3>
                  <p class="text-xs text-slate-500"><%= leaderboard.leaderboard_ratings.count %> players · <%= Match.where(leaderboard_id: leaderboard.id).count %> matches</p>
                  <% if leaderboard.description.present? %>
                    <p class="mt-2 text-sm text-slate-600"><%= leaderboard.description %></p>
                  <% end %>
                </div>
                <div class="flex flex-wrap gap-2 text-sm">
                  <%= link_to rankings_organization_leaderboard_path(@organization, leaderboard), class: "inline-flex items-center gap-1 text-slate-600 hover:text-slate-900" do %>
                    View rankings
                    <i class="fas fa-arrow-right text-xs"></i>
                  <% end %>
                </div>
              </div>
              <% if @organization.member?(current_user) %>
                <% current_profile ||= current_user.profile_for(@organization) %>
                <% user_rating = current_profile ? leaderboard.leaderboard_ratings.find_by(profile: current_profile) : nil %>
                <% if user_rating %>
                  <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
                    <p class="font-semibold text-slate-900">Your rating: <%= user_rating.rating.round %> (±<%= user_rating.rating_deviation.round %>)</p>
                    <p class="text-xs text-slate-500">Ranked #<%= leaderboard.leaderboard_ratings.where("rating > ?", user_rating.rating).count + 1 %></p>
                  </div>
                <% end %>
              <% end %>
              <div class="space-y-2 text-sm text-slate-600">
                <p class="font-semibold text-slate-900">Top players</p>
                <ul class="space-y-1">
                  <% leaderboard.leaderboard_ratings.order(rating: :desc).limit(3).each_with_index do |rating, index| %>
                    <li class="flex items-center justify-between">
                      <span class="flex items-center gap-2">
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-slate-300 text-xs font-semibold text-slate-600"><%= index + 1 %></span>
                        <%= link_to rating.profile.username, profile_path(rating.profile), class: "text-slate-700 hover:text-slate-900" %>
                      </span>
                      <span class="font-semibold text-slate-900"><%= rating.rating.round %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
              <% if @organization.member?(current_user) %>
                <div>
                  <%= link_to "Log a match", new_match_path(leaderboard_id: leaderboard.id), class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:text-slate-900" %>
                </div>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-slate-600">No leaderboards yet.</p>
      <% end %>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Members</h2>
        <p class="text-xs text-slate-500">Roles are granted after membership approval.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-3">Member</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Joined</th>
              <th class="px-4 py-3">Matches</th>
              <th class="px-4 py-3">Highest rating</th>
              <% if @organization.admin?(current_user) %>
                <th class="px-4 py-3">Role</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @organization.organization_memberships.includes(:organization_role, profile: :user).each do |membership| %>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">
                      <%= membership.profile.username.to_s[0..1].upcase %>
                    </span>
                    <div class="text-sm text-slate-700">
                      <%= link_to membership.profile.username, profile_path(membership.profile), class: "font-semibold text-slate-900 hover:text-slate-700" %>
                      <p class="text-xs text-slate-500"><%= membership.profile.user.email %></p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-slate-600">
                  <%= membership.status.capitalize %>
                </td>
                <td class="px-4 py-3 text-slate-500"><%= membership.created_at.strftime("%b %d, %Y") %></td>
                <td class="px-4 py-3 text-slate-500">
                  <%= Match.joins(:leaderboard, :match_participants)
                           .where(leaderboards: { organization_id: @organization.id })
                           .where(match_participants: { profile_id: membership.profile_id })
                           .distinct
                           .count %>
                </td>
                <td class="px-4 py-3 text-slate-500">
                  <%= (LeaderboardRating.joins(:leaderboard)
                                       .where(profile_id: membership.profile_id, leaderboards: { organization_id: @organization.id })
                                       .maximum(:rating) || 1500).round %>
                </td>
                <% if @organization.admin?(current_user) %>
                  <td class="px-4 py-3 text-slate-600">
                    <% if @organization.owner?(membership.profile.user) %>
                      Owner
                    <% elsif membership.admin? %>
                      Admin
                    <% else %>
                      Member
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Recent matches</h2>
        <%= link_to "View all matches", matches_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
      </div>
      <% recent_matches = Match.joins(:leaderboard).where(leaderboards: { organization_id: @organization.id }).order(created_at: :desc).limit(10) %>
      <% if recent_matches.any? %>
        <div class="space-y-3">
          <% recent_matches.each do |match| %>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm text-sm text-slate-600">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <p class="font-semibold text-slate-900">
                  <%= link_to match.profile1.username, profile_path(match.profile1), class: "hover:text-slate-700" %>
                  vs
                  <%= link_to match.opponent_profile.username, profile_path(match.opponent_profile), class: "hover:text-slate-700" %>
                </p>
                <p class="text-xs text-slate-500"><%= match.created_at.strftime("%b %d, %Y") %> · <%= match.leaderboard.name %></p>
              </div>
              <p class="text-xs text-slate-500">
                <% if match.is_draw %>
                  Draw
                <% elsif match.winner_profile_id.present? %>
                  <%= match.winner_profile.username %> won
                <% else %>
                  No result recorded
                <% end %>
              </p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-slate-600">No matches logged yet.</p>
      <% end %>
    </section>
  </div>
<% end %>
