<!-- app/views/organizations/new.html.erb -->
<div class="relative min-h-screen bg-slate-900 text-white">
  <!-- Decorative Background Elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-3xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="font-extrabold text-4xl md:text-5xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
        Create a New Gym
      </h1>
      <p class="text-slate-400 mt-2">Set up your gym's profile and start tracking matches and rankings.</p>
    </div>

    <%= form_with(model: @organization, local: true, class: "space-y-6") do |form| %>
      <% if @organization.errors.any? %>
        <div class="bg-red-900/50 border border-red-500 text-red-300 p-4 rounded-lg">
          <p class="font-semibold">Please correct the following errors:</p>
          <ul class="list-disc list-inside mt-2 text-sm">
            <% @organization.errors.full_messages.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Organization Name -->
      <div>
        <%= form.label :name, "Gym Name", class: "block text-sm font-medium text-slate-300 mb-1" %>
        <%= form.text_field :name, class: "bg-slate-800/70 border border-slate-700 text-white rounded-lg p-3 w-full focus:ring-2 focus:ring-purple-500 focus:border-transparent", required: true, placeholder: "Enter gym name" %>
      </div>

      <!-- Description -->
      <div>
        <%= form.label :description, "Description", class: "block text-sm font-medium text-slate-300 mb-1" %>
        <%= form.text_area :description, class: "bg-slate-800/70 border border-slate-700 text-white rounded-lg p-3 w-full focus:ring-2 focus:ring-purple-500 focus:border-transparent", rows: 4, placeholder: "Tell people about your gym, training focus, and community" %>
      </div>

      <!-- Location -->
      <div>
        <%= form.label :location, "Location", class: "block text-sm font-medium text-slate-300 mb-1" %>
        <%= form.text_field :location, class: "bg-slate-800/70 border border-slate-700 text-white rounded-lg p-3 w-full focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "City, State, or Country" %>
      </div>

      <!-- Website -->
      <div>
        <%= form.label :website, "Website or Social Media", class: "block text-sm font-medium text-slate-300 mb-1" %>
        <%= form.url_field :website, class: "bg-slate-800/70 border border-slate-700 text-white rounded-lg p-3 w-full focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "https://example.com" %>
      </div>

      <!-- Visibility -->
      <div>
        <%= form.label :visibility, "Visibility", class: "block text-sm font-medium text-slate-300 mb-1" %>
        <div class="grid grid-cols-2 gap-4 mt-2">
          <div class="bg-slate-800/70 border border-slate-700 rounded-lg p-4 cursor-pointer hover:border-purple-500 transition-colors <%= 'border-purple-500 ring-2 ring-purple-500' if @organization.open? || @organization.new_record? %>" data-visibility="open">
            <div class="flex items-center mb-2">
              <div class="w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 mr-3">
                <i class="fas fa-globe"></i>
              </div>
              <span class="font-medium text-white">Public</span>
            </div>
            <p class="text-sm text-slate-400">Anyone can view and join your gym without approval.</p>
            <%= form.radio_button :visibility, "open", class: "hidden visibility-radio", checked: @organization.new_record? || @organization.open? %>
          </div>

          <div class="bg-slate-800/70 border border-slate-700 rounded-lg p-4 cursor-pointer hover:border-purple-500 transition-colors <%= 'border-purple-500 ring-2 ring-purple-500' if @organization.restricted? %>" data-visibility="restricted">
            <div class="flex items-center mb-2">
              <div class="w-8 h-8 rounded-full bg-yellow-500/20 flex items-center justify-center text-yellow-400 mr-3">
                <i class="fas fa-lock"></i>
              </div>
              <span class="font-medium text-white">Private</span>
            </div>
            <p class="text-sm text-slate-400">Members need approval before they can join your gym.</p>
            <%= form.radio_button :visibility, "restricted", class: "hidden visibility-radio", checked: @organization.restricted? %>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4">
        <%= form.submit "Create Gym", class: "w-full px-4 py-3 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all transform hover:-translate-y-0.5" %>
      </div>
    <% end %>

    <div class="mt-8 text-center">
      <%= link_to organizations_path, class: "text-slate-400 hover:text-purple-400 text-sm" do %>
        <i class="fas fa-arrow-left mr-2"></i> Back to Gyms
      <% end %>
    </div>
  </div>
</div>

<script>
    document.addEventListener('turbo:load', function() {
        // Handle visibility option selection
        const visibilityOptions = document.querySelectorAll('[data-visibility]');
        const radioButtons = document.querySelectorAll('.visibility-radio');

        visibilityOptions.forEach(option => {
            option.addEventListener('click', function() {
                // Remove active class from all options
                visibilityOptions.forEach(opt => {
                    opt.classList.remove('border-purple-500', 'ring-2', 'ring-purple-500');
                });

                // Add active class to clicked option
                this.classList.add('border-purple-500', 'ring-2', 'ring-purple-500');

                // Check the corresponding radio button
                const visibility = this.dataset.visibility;
                document.querySelector(`input[value="${visibility}"]`).checked = true;
            });
        });
    });
</script>
