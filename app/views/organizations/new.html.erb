<%= render "shared/layouts/page_shell",
           title: "Create a gym",
           subtitle: "Set up your club profile so players know where to find you." do %>
  <%= form_with(model: @organization, local: true, class: "space-y-6") do |form| %>
    <% if @organization.errors.any? %>
      <div class="rounded-2xl border border-rose-300 bg-rose-50 p-4 text-sm text-rose-700">
        <p class="font-semibold">Please fix the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-4">
          <% @organization.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :name, "Gym name", class: "text-sm font-semibold text-slate-700" %>
        <%= form.text_field :name, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10", required: true %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :description, "Description", class: "text-sm font-semibold text-slate-700" %>
        <%= form.text_area :description, rows: 4, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10" %>
      </div>
      <div>
        <%= form.label :location, "Location", class: "text-sm font-semibold text-slate-700" %>
        <%= form.text_field :location, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10" %>
      </div>
      <div>
        <%= form.label :website, "Website", class: "text-sm font-semibold text-slate-700" %>
        <%= form.url_field :website, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10" %>
      </div>
    </div>

    <fieldset class="space-y-3">
      <legend class="text-sm font-semibold text-slate-700">Visibility</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block">
          <%= form.radio_button :visibility, "open", class: "peer sr-only", checked: @organization.new_record? || @organization.open? %>
          <div class="rounded-2xl border border-slate-300 bg-white px-4 py-4 text-sm text-slate-700 shadow-sm transition peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white">
            <p class="font-semibold">Public</p>
            <p class="mt-1 text-xs text-slate-500 peer-checked:text-white/80">Anyone can join immediately.</p>
          </div>
        </label>
        <label class="block">
          <%= form.radio_button :visibility, "restricted", class: "peer sr-only", checked: @organization.restricted? %>
          <div class="rounded-2xl border border-slate-300 bg-white px-4 py-4 text-sm text-slate-700 shadow-sm transition peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white">
            <p class="font-semibold">Private</p>
            <p class="mt-1 text-xs text-slate-500 peer-checked:text-white/80">Members request approval first.</p>
          </div>
        </label>
      </div>
    </fieldset>

    <div class="flex items-center justify-between">
      <%= link_to organizations_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-900" do %>
        Cancel
      <% end %>
      <%= form.submit "Create gym", class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
    </div>
  <% end %>
<% end %>
