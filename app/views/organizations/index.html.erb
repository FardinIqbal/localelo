<!-- app/views/organizations/index.html.erb -->

<div class="relative" data-controller="organization-search">
  <!-- Decorative background elements - Hidden on mobile for performance -->
  <div class="decorative-blur absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse z-0"></div>
  <div class="decorative-blur absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse z-0 delay-1000"></div>

  <!-- Main Content -->
  <div class="relative z-10">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="font-extrabold text-3xl md:text-5xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent mb-3">
        Find an Organization
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg">
        Browse organizations and request to join private ones or instantly join public ones.
      </p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-white/80 dark:bg-slate-800/80 mobile-blur rounded-xl border border-slate-200 dark:border-slate-700 p-4 md:p-6 mb-8 transition-all duration-300 hover:border-purple-500/30">
      <div class="flex flex-col gap-3 md:flex-row md:gap-4">
        <!-- Search Input -->
        <div class="relative flex-grow">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <i class="fas fa-search text-slate-500 dark:text-slate-400"></i>
          </div>
          <input
            type="text"
            id="search"
            placeholder="Search organizations..."
            class="w-full px-4 py-3 pl-11 bg-slate-50 dark:bg-slate-900/70 border-2 border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200 touch-target"
            data-organization-search-target="searchInput"
            data-action="input->organization-search#search"
          >
        </div>

        <!-- Filter by Visibility -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <i class="fas fa-filter text-slate-500 dark:text-slate-400"></i>
          </div>
          <select
            id="visibility-filter"
            class="w-full md:w-auto px-4 py-3 pl-11 pr-10 bg-slate-50 dark:bg-slate-900/70 border-2 border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 appearance-none transition-all duration-200 touch-target"
            data-organization-search-target="visibilityFilter"
            data-action="change->organization-search#filter"
          >
            <option value="">All Organizations</option>
            <option value="open">Public</option>
            <option value="restricted">Private</option>
          </select>
          <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
            <i class="fas fa-chevron-down text-slate-500 dark:text-slate-400 text-xs"></i>
          </div>
        </div>

        <!-- Create Organization Button -->
        <%= link_to new_organization_path,
                    class: "inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-0.5 active:scale-98 transition-all duration-200 touch-target touch-active" do %>
          <i class="fas fa-plus mr-2"></i>
          Create Gym
        <% end %>
      </div>
    </div>

    <!-- Organizations Grid -->
    <div class="bg-white/80 dark:bg-slate-800/80 mobile-blur rounded-xl border border-slate-200 dark:border-slate-700 p-4 md:p-6 transition-all duration-300 hover:border-purple-500/30">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Available Organizations</h2>

      <% if @organizations.present? %>
        <div id="organizations-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @organizations.each do |organization| %>
            <div class="organization-item group bg-white dark:bg-slate-900/70 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg overflow-hidden hover:shadow-lg hover:shadow-purple-500/20 transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/50"
                 data-organization-search-target="organizationItem"
                 data-name="<%= organization.name.downcase %>"
                 data-location="<%= organization.location&.downcase || '' %>"
                 data-visibility="<%= organization.visibility %>">

              <!-- Card Header with Background -->
              <div class="h-32 bg-gradient-to-r from-indigo-100 to-purple-100 dark:from-indigo-900/50 dark:to-purple-900/50 flex items-center justify-center relative overflow-hidden">
                <% if organization.name.present? %>
                  <div class="text-6xl font-bold text-slate-900/10 dark:text-white/10 absolute inset-0 flex items-center justify-center">
                    <%= organization.name.first.upcase %>
                  </div>
                <% end %>

                <!-- Visibility Badge -->
                <div class="absolute top-3 right-3">
                  <% if organization.open? %>
                    <span class="bg-green-900/70 text-green-300 text-xs px-2 py-1 rounded-md backdrop-blur-sm">
                      <i class="fas fa-lock-open mr-1"></i> Public
                    </span>
                  <% else %>
                    <span class="bg-yellow-900/70 text-yellow-300 text-xs px-2 py-1 rounded-md backdrop-blur-sm">
                      <i class="fas fa-lock mr-1"></i> Private
                    </span>
                  <% end %>
                </div>

                <!-- Location Badge -->
                <% if organization.location.present? %>
                  <div class="absolute bottom-3 left-3 bg-white/90 dark:bg-slate-900/80 backdrop-blur-sm rounded-md px-2 py-1 text-xs text-slate-700 dark:text-slate-300 flex items-center">
                    <i class="fas fa-map-marker-alt mr-1.5 text-pink-500"></i>
                    <%= organization.location %>
                  </div>
                <% end %>
              </div>

              <!-- Card Content -->
              <div class="p-5">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-pink-500 transition-colors duration-300 mb-2">
                  <%= organization.name %>
                </h3>

                <% if organization.description.present? %>
                  <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 line-clamp-2">
                    <%= organization.description %>
                  </p>
                <% end %>

                <!-- Stats Row -->
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center text-slate-600 dark:text-slate-400 text-sm">
                    <i class="fas fa-users mr-1.5 text-indigo-500 dark:text-indigo-400"></i>
                    <%= organization.organization_memberships.count %> members
                  </div>

                  <div class="flex items-center text-slate-600 dark:text-slate-400 text-sm">
                    <i class="fas fa-trophy mr-1.5 text-indigo-500 dark:text-indigo-400"></i>
                    <%= organization.leaderboards.count %> leaderboards
                  </div>
                </div>

                <!-- Join Button -->
                <% if organization.open? %>
                  <%= link_to join_organization_path(organization),
                              data: { turbo_method: :post },
                              class: "w-full inline-flex items-center justify-center font-medium rounded-lg transition-all duration-300 py-2.5 px-4 text-white bg-gradient-to-r from-green-600 to-emerald-500 hover:from-green-500 hover:to-emerald-400 shadow-lg shadow-green-500/20 hover:shadow-green-500/40 transform hover:-translate-y-1" do %>
                    <i class="fas fa-sign-in-alt mr-2"></i> Join Now
                  <% end %>
                <% else %>
                  <%= link_to join_organization_path(organization),
                              data: { turbo_method: :post },
                              class: "w-full inline-flex items-center justify-center font-medium rounded-lg transition-all duration-300 py-2.5 px-4 text-white bg-gradient-to-r from-yellow-600 to-amber-500 hover:from-yellow-500 hover:to-amber-400 shadow-lg shadow-yellow-500/20 hover:shadow-yellow-500/40 transform hover:-translate-y-1" do %>
                    <i class="fas fa-paper-plane mr-2"></i> Request to Join
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- No Results Message (Hidden by Default) -->
        <div id="no-results" class="py-12 text-center hidden" data-organization-search-target="noResults">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 mb-4">
            <i class="fas fa-search text-2xl"></i>
          </div>
          <p class="text-slate-600 dark:text-slate-400">No organizations found matching your search.</p>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="py-12 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 mb-4">
            <i class="fas fa-dumbbell text-2xl"></i>
          </div>
          <p class="text-slate-600 dark:text-slate-400 mb-4">No organizations available yet.</p>
          <p class="text-slate-500 dark:text-slate-500 mb-6">Be the first to create a gym or fitness club!</p>
          <%= link_to new_organization_path,
                      class: "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-300 px-5 py-3
                      text-white bg-gradient-to-r from-purple-600 to-pink-500
                      hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400
                      shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40
                      transform hover:-translate-y-1" do %>
            <i class="fas fa-plus mr-2"></i> Create Gym
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Search and filter now handled by Stimulus organization-search controller -->
