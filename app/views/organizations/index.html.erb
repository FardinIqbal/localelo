<!-- app/views/organizations/index.html.erb -->

<div class="relative">
  <!-- Decorative background elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="font-extrabold text-4xl md:text-5xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent mb-3">
        Find an Organization
      </h1>
      <p class="text-slate-400 text-lg">
        Browse organizations and request to join private ones or instantly join public ones.
      </p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-slate-900/60 backdrop-blur-xl rounded-2xl border border-white/10 shadow-xl shadow-purple-500/5 p-6 mb-8">
      <div class="flex flex-col md:flex-row gap-4">
        <!-- Search Input -->
        <div class="relative flex-grow">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-slate-400"></i>
          </div>
          <input
            type="text"
            id="search"
            placeholder="Search organizations..."
            class="w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300"
            onkeyup="filterOrganizations()"
          >
        </div>

        <!-- Filter by Visibility -->
        <div class="relative min-w-[200px]">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-filter text-slate-400"></i>
          </div>
          <select
            id="visibility-filter"
            onchange="filterOrganizations()"
            class="w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white appearance-none transition-all duration-300"
          >
            <option value="">All Organizations</option>
            <option value="open">Public</option>
            <option value="restricted">Private</option>
          </select>
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
            <i class="fas fa-chevron-down text-slate-400 text-xs"></i>
          </div>
        </div>

        <!-- Create Organization Button -->
        <%= link_to new_organization_path,
                    class: "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-300 px-5 py-3
                    text-white bg-gradient-to-r from-purple-600 to-pink-500
                    hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400
                    shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40
                    transform hover:-translate-y-1" do %>
          <i class="fas fa-plus mr-2"></i> Create Gym
        <% end %>
      </div>
    </div>

    <!-- Organizations Grid -->
    <div class="bg-slate-900/60 backdrop-blur-xl rounded-2xl border border-white/10 shadow-xl p-6">
      <h2 class="text-2xl font-bold text-white mb-6">Available Organizations</h2>

      <% if @organizations.present? %>
        <div id="organizations-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @organizations.each do |organization| %>
            <div class="organization-item group bg-slate-800/60 backdrop-blur-sm rounded-xl border border-white/10 shadow-lg overflow-hidden hover:shadow-purple-500/20 transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/30"
                 data-name="<%= organization.name.downcase %>"
                 data-location="<%= organization.location&.downcase || '' %>"
                 data-visibility="<%= organization.visibility %>">

              <!-- Card Header with Background -->
              <div class="h-32 bg-gradient-to-r from-indigo-900/50 to-purple-900/50 flex items-center justify-center relative overflow-hidden">
                <% if organization.name.present? %>
                  <div class="text-6xl font-bold text-white/10 absolute inset-0 flex items-center justify-center">
                    <%= organization.name.first.upcase %>
                  </div>
                <% end %>

                <!-- Visibility Badge -->
                <div class="absolute top-3 right-3">
                  <% if organization.open? %>
                    <span class="bg-green-900/70 text-green-300 text-xs px-2 py-1 rounded-md backdrop-blur-sm">
                      <i class="fas fa-lock-open mr-1"></i> Public
                    </span>
                  <% else %>
                    <span class="bg-yellow-900/70 text-yellow-300 text-xs px-2 py-1 rounded-md backdrop-blur-sm">
                      <i class="fas fa-lock mr-1"></i> Private
                    </span>
                  <% end %>
                </div>

                <!-- Location Badge -->
                <% if organization.location.present? %>
                  <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-sm rounded-md px-2 py-1 text-xs text-slate-300 flex items-center">
                    <i class="fas fa-map-marker-alt mr-1.5 text-pink-500"></i>
                    <%= organization.location %>
                  </div>
                <% end %>
              </div>

              <!-- Card Content -->
              <div class="p-5">
                <h3 class="text-xl font-bold text-white group-hover:text-pink-500 transition-colors duration-300 mb-2">
                  <%= organization.name %>
                </h3>

                <% if organization.description.present? %>
                  <p class="text-slate-400 text-sm mb-4 line-clamp-2">
                    <%= organization.description %>
                  </p>
                <% end %>

                <!-- Stats Row -->
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center text-slate-400 text-sm">
                    <i class="fas fa-users mr-1.5 text-indigo-400"></i>
                    <%= organization.organization_memberships.count %> members
                  </div>

                  <div class="flex items-center text-slate-400 text-sm">
                    <i class="fas fa-trophy mr-1.5 text-indigo-400"></i>
                    <%= organization.leaderboards.count %> leaderboards
                  </div>
                </div>

                <!-- Join Button -->
                <% if organization.open? %>
                  <%= link_to join_organization_path(organization),
                              data: { turbo_method: :post },
                              class: "w-full inline-flex items-center justify-center font-medium rounded-lg transition-all duration-300 py-2.5 px-4 text-white bg-gradient-to-r from-green-600 to-emerald-500 hover:from-green-500 hover:to-emerald-400 shadow-lg shadow-green-500/20 hover:shadow-green-500/40 transform hover:-translate-y-1" do %>
                    <i class="fas fa-sign-in-alt mr-2"></i> Join Now
                  <% end %>
                <% else %>
                  <%= link_to join_organization_path(organization),
                              data: { turbo_method: :post },
                              class: "w-full inline-flex items-center justify-center font-medium rounded-lg transition-all duration-300 py-2.5 px-4 text-white bg-gradient-to-r from-yellow-600 to-amber-500 hover:from-yellow-500 hover:to-amber-400 shadow-lg shadow-yellow-500/20 hover:shadow-yellow-500/40 transform hover:-translate-y-1" do %>
                    <i class="fas fa-paper-plane mr-2"></i> Request to Join
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- No Results Message (Hidden by Default) -->
        <div id="no-results" class="py-12 text-center hidden">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-800/80 text-slate-400 mb-4">
            <i class="fas fa-search text-2xl"></i>
          </div>
          <p class="text-slate-400">No organizations found matching your search.</p>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="py-12 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-800/80 text-slate-400 mb-4">
            <i class="fas fa-dumbbell text-2xl"></i>
          </div>
          <p class="text-slate-400 mb-4">No organizations available yet.</p>
          <p class="text-slate-500 mb-6">Be the first to create a gym or fitness club!</p>
          <%= link_to new_organization_path,
                      class: "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-300 px-5 py-3
                      text-white bg-gradient-to-r from-purple-600 to-pink-500
                      hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400
                      shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40
                      transform hover:-translate-y-1" do %>
            <i class="fas fa-plus mr-2"></i> Create Gym
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
    function filterOrganizations() {
        let query = document.getElementById('search').value.toLowerCase().trim();
        let visibilityFilter = document.getElementById('visibility-filter').value.toLowerCase();
        let organizations = document.querySelectorAll('.organization-item');
        let noResults = document.getElementById('no-results');
        let visibleCount = 0;

        organizations.forEach(org => {
            let name = org.getAttribute('data-name');
            let location = org.getAttribute('data-location');
            let visibility = org.getAttribute('data-visibility');
            let matchesQuery = name.includes(query) || location.includes(query);
            let matchesVisibility = visibilityFilter === "" || visibility === visibilityFilter;

            if (matchesQuery && matchesVisibility) {
                org.style.display = "block";
                visibleCount++;
            } else {
                org.style.display = "none";
            }
        });

        // Show/hide no results message
        if (visibleCount === 0 && document.querySelectorAll('.organization-item').length > 0) {
            noResults.style.display = "block";
        } else {
            noResults.style.display = "none";
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        filterOrganizations();
    });
</script>
