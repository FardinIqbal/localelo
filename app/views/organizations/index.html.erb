<div>
  <!-- Page Header -->
  <h1 class="font-bold text-4xl">Find an Organization</h1>
  <p class="text-gray-600 text-lg">
    Browse organizations and request to join private ones or instantly join public ones.
  </p>

  <!-- Search Input -->
  <div class="mt-4">
    <input type="text" id="search" placeholder="Search organizations..."
           class="border p-2 w-full rounded-md focus:ring focus:ring-indigo-300 transition"
           onkeyup="filterOrganizations()">
  </div>

  <!-- Organizations List -->
  <div class="mt-6">
    <ul id="organizations-list" class="space-y-4">
      <% @organizations.each do |organization| %>
        <% unless organization.organization_memberships.exists?(user: current_user) %>
          <li class="flex justify-between items-center p-4 bg-white rounded-lg shadow-md transition hover:shadow-lg organization-item">
            <div>
              <!-- Organization Name & Details -->
              <h2 class="text-xl font-medium text-indigo-600"><%= organization.name %></h2>
              <p class="text-gray-600 text-sm">Location: <%= organization.location.presence || "Not specified" %></p>
              <p class="text-gray-600 text-sm">Members: <%= organization.organization_memberships.count %></p>
              <p class="text-gray-600 text-sm">Visibility: <%= organization.visibility.humanize %></p>
            </div>

            <!-- Join Button -->
            <% if organization.visibility == "open" %>
              <%= button_to "Join", join_organization_path(organization),
                            method: :post,
                            class: "bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition shadow-md" %>
            <% else %>
              <%= button_to "Request to Join", join_organization_path(organization),
                            method: :post,
                            class: "bg-yellow-500 text-white px-4 py-2 rounded-md hover:bg-yellow-600 transition shadow-md" %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>

  <!-- Create Organization Button -->
  <div class="mt-8">
    <%= link_to "Create New Organization", new_organization_path,
                class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition" %>
  </div>
</div>

<script>
    function filterOrganizations() {
        let query = document.getElementById('search').value.toLowerCase().trim();
        let organizations = document.querySelectorAll('.organization-item');

        organizations.forEach(org => {
            let name = org.querySelector('h2').innerText.toLowerCase();
            org.style.display = name.includes(query) ? "flex" : "none";
        });
    }
</script>
