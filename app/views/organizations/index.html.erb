<%= render "shared/layouts/page_shell",
           title: "Find an organization",
           subtitle: "Browse clubs that are already active or start a new one in a few seconds." do %>
  <section data-controller="organization-filters" class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex-1">
        <label for="organization-search" class="text-sm font-medium text-slate-700">Search</label>
        <div class="mt-2 flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
          <i class="fas fa-search text-slate-400"></i>
          <input id="organization-search"
                 type="search"
                 placeholder="Search by name or location"
                 class="w-full border-0 p-0 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0"
                 data-organization-filters-target="query"
                 data-action="input->organization-filters#filter">
        </div>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <div>
          <label for="organization-visibility" class="text-sm font-medium text-slate-700">Visibility</label>
          <select id="organization-visibility"
                  class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10"
                  data-organization-filters-target="visibility"
                  data-action="change->organization-filters#filter">
            <option value="">All organizations</option>
            <option value="open">Public</option>
            <option value="restricted">Private</option>
          </select>
        </div>
        <%= link_to new_organization_path,
                    class: "sm:ml-4 inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
          <i class="fas fa-plus mr-2"></i>
          Create gym
        <% end %>
      </div>
    </div>

    <% if @organizations.present? %>
      <div data-organization-filters-target="list" class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        <% @organizations.each do |organization| %>
          <article class="flex h-full flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
                   data-organization-filters-target="item"
                   data-name="<%= organization.name.to_s.downcase %>"
                   data-location="<%= organization.location.to_s.downcase %>"
                   data-visibility="<%= organization.visibility %>">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="text-lg font-semibold text-slate-900"><%= organization.name %></h2>
                  <% if organization.location.present? %>
                    <p class="text-sm text-slate-500"><i class="fas fa-map-marker-alt mr-1 text-slate-400"></i><%= organization.location %></p>
                  <% end %>
                </div>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
                  <%= organization.open? ? "Public" : "Private" %>
                </span>
              </div>
              <% if organization.description.present? %>
                <p class="text-sm leading-6 text-slate-600"><%= truncate(organization.description, length: 130) %></p>
              <% end %>
            </div>
            <dl class="mt-6 grid grid-cols-2 gap-3 text-sm text-slate-600">
              <div class="rounded-xl border border-slate-200 px-3 py-2">
                <dt class="text-xs uppercase tracking-wide text-slate-500">Members</dt>
                <dd class="mt-1 font-semibold text-slate-900"><%= organization.organization_memberships.count %></dd>
              </div>
              <div class="rounded-xl border border-slate-200 px-3 py-2">
                <dt class="text-xs uppercase tracking-wide text-slate-500">Leaderboards</dt>
                <dd class="mt-1 font-semibold text-slate-900"><%= organization.leaderboards.count %></dd>
              </div>
            </dl>
            <div class="mt-6">
              <% if organization.open? %>
                <%= link_to join_organization_path(organization),
                            data: { turbo_method: :post },
                            class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600" do %>
                  <i class="fas fa-user-plus"></i>
                  Join now
                <% end %>
              <% else %>
                <%= link_to join_organization_path(organization),
                            data: { turbo_method: :post },
                            class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
                  <i class="fas fa-envelope"></i>
                  Request access
                <% end %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
      <div data-organization-filters-target="empty" class="hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-500">
        <p>No organizations match those filters yet.</p>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
        <p class="text-base">No organizations available yet. Be the first to create one.</p>
        <div class="mt-4">
          <%= link_to "Create a gym", new_organization_path, class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
