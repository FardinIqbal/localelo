<!-- Hero Section -->
<section class="bg-gradient-to-b from-blue-700 to-blue-800 text-white pb-12">
  <div class="container mx-auto px-6 pt-12 pb-16">
    <!-- Main Content -->
    <div class="flex flex-col lg:flex-row items-center justify-between">
      <!-- Left Column: Text Content -->
      <div class="lg:w-1/2 text-center lg:text-left mb-8 lg:mb-0">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          Elevate Your Gym's <span class="bg-white text-blue-700 px-2 py-1 rounded">Competition</span>
        </h1>
        <p class="text-xl mt-6 text-blue-100 max-w-lg mx-auto lg:mx-0">
          The simplest way to track No-Gi BJJ Elo ratings, organize matches, and build a thriving competitive culture at your gym.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row justify-center lg:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
          <% if user_signed_in? %>
            <%= link_to "My Gyms Dashboard", gyms_path, class: "inline-block px-8 py-3 bg-white text-blue-700 hover:bg-blue-50 rounded-lg text-lg font-semibold transition duration-300" %>
            <%= link_to "Create New Match", "#", class: "inline-block px-8 py-3 bg-blue-600 text-white border border-blue-400 hover:bg-blue-500 rounded-lg text-lg font-semibold transition duration-300" %>
          <% else %>
            <%= link_to "Sign Up Free", new_user_registration_path, class: "inline-block px-8 py-3 bg-white text-blue-700 hover:bg-blue-50 rounded-lg text-lg font-semibold transition duration-300" %>
            <%= link_to "Learn More", "#features", class: "inline-block px-8 py-3 bg-transparent text-white border border-white hover:bg-blue-600 rounded-lg text-lg font-semibold transition duration-300" %>
          <% end %>
        </div>

        <!-- Stats -->
        <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 gap-4">
          <div class="text-center p-3 bg-blue-800 bg-opacity-50 rounded-lg">
            <p class="text-3xl font-bold">100+</p>
            <p class="text-sm text-blue-200">Gyms Using RankedBJJ</p>
          </div>
          <div class="text-center p-3 bg-blue-800 bg-opacity-50 rounded-lg">
            <p class="text-3xl font-bold">10k+</p>
            <p class="text-sm text-blue-200">Matches Tracked</p>
          </div>
          <div class="text-center p-3 bg-blue-800 bg-opacity-50 rounded-lg sm:col-span-1 col-span-2">
            <p class="text-3xl font-bold">5k+</p>
            <p class="text-sm text-blue-200">Active Athletes</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Image/Graphic -->
      <div class="lg:w-1/2 flex justify-center lg:justify-end">
        <div class="relative">
          <!-- Main graphic - replace with your own image or keep this placeholder -->
          <div class="bg-white p-4 rounded-lg shadow-xl max-w-md">
            <div class="bg-gray-50 rounded border border-gray-200 p-3 mb-2">
              <h3 class="font-bold text-blue-700 mb-2 text-lg">NYC BJJ Academy Leaderboard</h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center p-2 bg-blue-50 rounded">
                  <div class="flex items-center">
                    <div class="bg-blue-700 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">1</div>
                    <span class="ml-2 font-medium text-gray-800">John Smith</span>
                  </div>
                  <span class="font-bold text-blue-700">1856</span>
                </div>
                <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                  <div class="flex items-center">
                    <div class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">2</div>
                    <span class="ml-2 font-medium text-gray-800">Alex Chen</span>
                  </div>
                  <span class="font-bold text-blue-700">1798</span>
                </div>
                <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                  <div class="flex items-center">
                    <div class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">3</div>
                    <span class="ml-2 font-medium text-gray-800">Sarah Lee</span>
                  </div>
                  <span class="font-bold text-blue-700">1742</span>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 rounded border border-gray-200 p-3">
              <div class="flex justify-between mb-2">
                <span class="text-sm font-medium text-gray-600">Recent Match:</span>
                <span class="text-sm text-blue-600">2h ago</span>
              </div>
              <div class="flex justify-between items-center">
                <div class="text-center">
                  <div class="font-bold text-gray-800">John</div>
                  <div class="text-sm text-gray-600">1856 (+12)</div>
                </div>
                <div class="px-3 py-1 rounded bg-green-100 text-green-800 font-medium">WIN</div>
                <div class="px-3 py-1 rounded bg-red-100 text-red-800 font-medium">LOSS</div>
                <div class="text-center">
                  <div class="font-bold text-gray-800">Mike</div>
                  <div class="text-sm text-gray-600">1723 (-12)</div>
                </div>
              </div>
            </div>
          </div>
          <!-- Decorative elements -->
          <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-blue-600 rounded-full opacity-20"></div>
          <div class="absolute -top-4 -left-4 w-16 h-16 bg-blue-600 rounded-full opacity-20"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave Divider (using Font Awesome icons instead of SVG) -->
  <div class="w-full text-center text-gray-50">
    <div class="flex justify-center overflow-hidden">
      <i class="fa-solid fa-wave-square text-8xl transform rotate-180"></i>
      <i class="fa-solid fa-wave-square text-8xl transform rotate-180"></i>
      <i class="fa-solid fa-wave-square text-8xl transform rotate-180"></i>
      <i class="fa-solid fa-wave-square text-8xl transform rotate-180"></i>
      <i class="fa-solid fa-wave-square text-8xl transform rotate-180"></i>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="py-16 bg-gradient-to-b from-gray-50 to-gray-100">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-800 mb-4 relative">
      Why Gyms Love RankedBJJ
      <div class="absolute w-24 h-1 bg-blue-600 bottom-0 left-1/2 transform -translate-x-1/2 mt-2"></div>
    </h2>
    <p class="text-center text-gray-600 max-w-2xl mx-auto mb-12">The simplest solution to boost member engagement and create a thriving competitive atmosphere.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Feature Cards -->
      <% features = [
        { icon: 'fa-chart-line', title: 'Accurate Elo Rating System', desc: 'Track progress with our proven Elo algorithm that accurately reflects skill progression and competitive performance.' },
        { icon: 'fa-trophy', title: 'Leaderboards & Rankings', desc: 'Foster healthy competition with real-time leaderboards that showcase top performers at your gym.' },
        { icon: 'fa-users', title: 'Boost Member Retention', desc: 'Keep practitioners engaged and coming back with measurable progress and friendly competition.' },
        { icon: 'fa-mobile-alt', title: 'Easy-to-Use Interface', desc: 'Simple, intuitive design makes tracking matches and viewing stats effortless for gym owners and members alike.' },
        { icon: 'fa-handshake', title: 'Match Organization', desc: 'Easily create and manage matches, track outcomes, and maintain a complete history of all competitions.' },
        { icon: 'fa-chart-pie', title: 'Insightful Analytics', desc: 'Gain valuable insights into member performance trends, match statistics, and gym activity.' }
      ] %>

      <% features.each do |feature| %>
        <div class="group bg-white p-8 rounded-xl shadow-md hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 relative overflow-hidden">
          <!-- Decorative Background Elements -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-full -mr-16 -mt-16 transition-transform duration-500 group-hover:scale-150"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-blue-50 rounded-full -ml-12 -mb-12 transition-transform duration-500 group-hover:scale-150"></div>

          <!-- Icon Container -->
          <div class="relative">
            <div class="flex items-center justify-center w-16 h-16 bg-blue-100 text-blue-700 rounded-2xl mb-6 transform transition-all duration-300 group-hover:rotate-6 group-hover:scale-110">
              <i class="fas <%= feature[:icon] %> text-2xl"></i>
            </div>
          </div>

          <!-- Content -->
          <div class="relative">
            <h3 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-blue-700 transition-colors duration-300">
              <%= feature[:title] %>
            </h3>
            <p class="text-gray-600 mb-4">
              <%= feature[:desc] %>
            </p>

            <!-- Learn More Link -->
            <div class="flex items-center text-blue-600 font-medium opacity-0 transform translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
              <span>Learn more</span>
              <i class="fas fa-arrow-right ml-2 transform group-hover:translate-x-2 transition-transform duration-300"></i>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Enhanced Testimonial -->
    <div class="mt-16 max-w-3xl mx-auto">
      <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 border-l-4 border-blue-600 relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-full -mr-16 -mt-16"></div>
        <div class="absolute -left-2 -bottom-2 text-blue-200 opacity-20 transform scale-150">
          <i class="fas fa-quote-left text-8xl"></i>
        </div>

        <div class="relative">
          <p class="text-gray-600 italic mb-6 text-lg leading-relaxed">
            "Since implementing RankedBJJ at our academy, we've seen a 35% increase in member engagement and retention. The competitive atmosphere has elevated everyone's game, and our students love tracking their progress."
          </p>

          <div class="flex items-center">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg group-hover:scale-110 transition-transform duration-300">
              JC
            </div>
            <div class="ml-4">
              <p class="font-bold text-gray-800 text-lg">John Carlos</p>
              <p class="text-blue-600">Owner, Elite BJJ Academy</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced CTA -->
    <div class="mt-16 text-center">
      <h3 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6">
        Ready to elevate your gym's competitive culture?
      </h3>
      <%= link_to new_user_registration_path, class: "inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg text-lg font-semibold transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/30 transform hover:-translate-y-1 group" do %>
        <span>Get Started Today</span>
        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform duration-300"></i>
      <% end %>
    </div>
  </div>

  <!-- Floating Icon Section with Font Awesome -->
  <div class="container mx-auto px-6 mt-16">
    <div class="flex justify-center space-x-12 md:space-x-24">
      <div class="text-center">
        <i class="fas fa-medal text-5xl text-blue-600 animate-float"></i>
        <p class="mt-4 font-medium text-gray-700">Verified Matches</p>
      </div>
      <div class="text-center">
        <i class="fas fa-chart-line text-5xl text-blue-600 animate-float" style="animation-delay: 0.5s;"></i>
        <p class="mt-4 font-medium text-gray-700">Track Progress</p>
      </div>
      <div class="text-center">
        <i class="fas fa-trophy text-5xl text-blue-600 animate-float" style="animation-delay: 1s;"></i>
        <p class="mt-4 font-medium text-gray-700">Win Rewards</p>
      </div>
    </div>
  </div>
</section>

<!-- Additional Bottom Section with Font Awesome -->
<section class="py-12 bg-blue-700 text-white">
  <div class="container mx-auto px-6 text-center">
    <div class="flex justify-center mb-6">
      <i class="fas fa-bolt-lightning text-6xl text-yellow-300 mr-4"></i>
      <i class="fas fa-fire text-6xl text-orange-500"></i>
    </div>
    <h2 class="text-3xl font-bold mb-6">Start Your Journey Today</h2>
    <p class="text-xl mb-8 max-w-2xl mx-auto">Join the fastest growing BJJ ranking system and elevate your gym's competitive spirit.</p>
    <%= link_to new_user_registration_path, class: "inline-flex items-center px-8 py-4 bg-white text-blue-700 rounded-lg text-lg font-semibold transition-all duration-300 hover:bg-blue-50 transform hover:-translate-y-1" do %>
      <i class="fas fa-user-plus mr-2"></i> Create Free Account
    <% end %>
  </div>
</section>