<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-900">Coming soon</h2>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">Roadmap</span>
  </div>
  <ul class="space-y-3 text-sm text-slate-600">
    <% [
         { icon: 'trophy', text: t("dashboard.roadmap.items.achievements") },
         { icon: 'mobile-alt', text: t("dashboard.roadmap.items.mobile_app") },
         { icon: 'chart-line', text: t("dashboard.roadmap.items.advanced_stats") },
         { icon: 'file-export', text: t("dashboard.roadmap.items.export") },
         { icon: 'users', text: t("dashboard.roadmap.items.friends_rivals") }
       ].each do |item| %>
      <li class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white text-slate-500">
          <i class="fas fa-<%= item[:icon] %>"></i>
        </span>
        <span><%= item[:text] %></span>
      </li>
    <% end %>
  </ul>
</div>
