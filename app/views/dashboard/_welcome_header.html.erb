<div class="flex flex-col md:flex-row justify-between items-start md:items-center">
  <div>
    <h1 class="font-extrabold text-4xl md:text-5xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      Welcome, <%= current_user.first_name || current_user.username %>
    </h1>
    <p class="text-slate-600 dark:text-slate-400 mt-1">Track your matches, rankings, and gym memberships</p>
  </div>
  <div class="mt-4 md:mt-0 text-slate-500 dark:text-slate-400 text-sm">
    <%= Time.now.strftime("%A, %B %d, %Y") %>
  </div>
</div>