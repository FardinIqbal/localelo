<div class="p-6">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      <%= @scoped_organization ? @scoped_organization.name : "Your Organizations" %>
    </h2>

    <% if @scoped_organization %>
      <%= link_to organization_path(@scoped_organization),
                  class: "px-3 py-1 rounded-lg bg-slate-700 text-purple-400 text-sm hover:bg-slate-600 transition-all transform hover:-translate-y-0.5" do %>
        View <%= @scoped_organization.name %> <i class="fas fa-arrow-right ml-1"></i>
      <% end %>
    <% else %>
      <%= link_to organizations_path,
                  class: "px-3 py-1 rounded-lg bg-slate-700 text-purple-400 text-sm hover:bg-slate-600 transition-all transform hover:-translate-y-0.5" do %>
        View All <i class="fas fa-arrow-right ml-1"></i>
      <% end %>
    <% end %>
  </div>

  <% profiles ||= [] %>
  <% if profiles.any? %>
    <div class="space-y-3">
      <% profiles.each do |profile| %>
        <% org = profile.organization %>
        <div class="bg-slate-700/50 rounded-lg p-4 border border-slate-600 hover:border-purple-500/50 transition-all">
          <div class="flex items-center">
            <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold shadow-lg shadow-purple-500/20">
              <%= org.name[0..1].upcase %>
            </div>

            <div class="ml-3">
              <div class="flex items-center">
                <%= link_to org.name, organization_path(org),
                            class: "text-white font-medium hover:text-purple-400 transition-colors" %>

                <% if org.visibility == 0 %>
                  <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-green-400/20 text-green-400">Public</span>
                <% elsif org.visibility == 1 %>
                  <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-yellow-400/20 text-yellow-400">Private</span>
                <% end %>

                <% if org.user_id == current_user.id %>
                  <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-purple-400/20 text-purple-400">Owner</span>
                <% end %>
              </div>

              <div class="text-xs text-slate-400 mt-1 flex items-center">
                <i class="fas fa-users mr-1"></i> <%= pluralize(org.users.count, 'member') %>
                <% if org.location.present? %>
                  <span class="mx-1">- </span>
                  <i class="fas fa-map-marker-alt mr-1"></i> <%= org.location %>
                <% end %>
              </div>
            </div>
          </div>
          <% if org.leaderboards.any? %>
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
              <% org.leaderboards.first(4).each do |leaderboard| %>
                <% user_rating = profile.leaderboard_ratings.find { |rating| rating.leaderboard_id == leaderboard.id } %>
                <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/70 border border-slate-700 hover:border-purple-400/30 transition-all">
                  <div class="flex items-center">
                    <i class="fas fa-trophy text-purple-400 mr-2"></i>
                    <span class="text-sm text-slate-300"><%= leaderboard.name %></span>
                  </div>
                  <span class="text-sm font-medium px-2 py-0.5 rounded-lg bg-purple-500/20 text-purple-400">
                    <%= user_rating&.rating || 1500 %> Elo
                  </span>
                </div>
              <% end %>
            </div>

            <% if org.leaderboards.count > 4 %>
              <div class="mt-3 text-center">
                <%= link_to organization_path(org),
                            class: "inline-block px-3 py-1 rounded-lg bg-slate-800 text-xs text-purple-400 hover:bg-slate-700 transition-all" do %>
                  <i class="fas fa-plus mr-1"></i> <%= org.leaderboards.count - 4 %> more leaderboards
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="mt-3 p-3 rounded-lg bg-slate-800/50 border border-slate-700 text-sm text-slate-400 flex items-center justify-center">
              <i class="fas fa-info-circle mr-2"></i> No leaderboards created yet
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-10 text-slate-400">
      <div class="w-20 h-20 rounded-full bg-slate-800/70 flex items-center justify-center mb-4">
        <i class="fas fa-building text-3xl text-purple-400/70"></i>
      </div>
      <p class="text-lg mb-4">You are not part of any gyms yet</p>
      <%= link_to organizations_path,
                  class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all transform hover:-translate-y-0.5" do %>
        <i class="fas fa-users mr-2"></i> Find Gyms to Join
      <% end %>
    </div>
  <% end %>
</div>
