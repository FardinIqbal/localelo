<div class="p-6">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      <%= @scoped_organization ? @scoped_organization.name : "Your Organizations" %>
    </h2>

    <% if @scoped_organization %>
      <%= link_to organization_path(@scoped_organization),
                  class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-purple-400 hover:text-white hover:bg-slate-700/50 transition-all duration-200 group" do %>
        <span>View <%= @scoped_organization.name %></span>
        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-0.5 transition-transform duration-200"></i>
      <% end %>
    <% else %>
      <%= link_to organizations_path,
                  class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-purple-400 hover:text-white hover:bg-slate-700/50 transition-all duration-200 group" do %>
        <span>View All</span>
        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-0.5 transition-transform duration-200"></i>
      <% end %>
    <% end %>
  </div>

  <% profiles ||= [] %>
  <% if profiles.any? %>
    <div class="space-y-4">
      <% profiles.each do |profile| %>
        <% org = profile.organization %>
        <div class="bg-slate-900/50 rounded-xl p-5 border border-slate-700 hover:border-purple-500/50 hover:bg-slate-900/70 transition-all duration-300 group">
          <div class="flex items-center">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-purple-500/30 group-hover:scale-105 transition-transform duration-300">
              <%= org.name[0..1].upcase %>
            </div>

            <div class="ml-4 flex-1 min-w-0">
              <div class="flex items-center flex-wrap gap-2">
                <%= link_to org.name, organization_path(org),
                            class: "text-white font-semibold hover:text-purple-400 transition-colors duration-200 truncate" %>

                <% if org.visibility == 0 %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-500/10 text-green-400 border border-green-500/30">Public</span>
                <% elsif org.visibility == 1 %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/30">Private</span>
                <% end %>

                <% if org.owner?(current_user) %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-500/10 text-purple-400 border border-purple-500/30">Owner</span>
                <% end %>
              </div>

              <div class="text-xs text-slate-400 mt-2 flex items-center flex-wrap gap-3">
                <span class="flex items-center">
                  <i class="fas fa-users mr-1.5"></i>
                  <%= pluralize(org.users.count, 'member') %>
                </span>
                <% if org.location.present? %>
                  <span class="flex items-center">
                    <i class="fas fa-map-marker-alt mr-1.5"></i>
                    <%= org.location %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
          <% if org.leaderboards.any? %>
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% org.leaderboards.first(4).each do |leaderboard| %>
                <% user_rating = profile.leaderboard_ratings.find { |rating| rating.leaderboard_id == leaderboard.id } %>
                <div class="flex justify-between items-center p-3 rounded-lg bg-slate-800/70 border border-slate-700 hover:border-purple-400/50 transition-all duration-200 group">
                  <div class="flex items-center min-w-0 flex-1 mr-3">
                    <i class="fas fa-trophy text-purple-400 mr-2 text-sm flex-shrink-0"></i>
                    <span class="text-sm text-slate-300 font-medium truncate"><%= leaderboard.name %></span>
                  </div>
                  <span class="text-sm font-semibold px-3 py-1 rounded-lg bg-purple-500/20 text-purple-400 border border-purple-500/30 flex-shrink-0 group-hover:bg-purple-500/30 transition-colors duration-200">
                    <%= user_rating&.rating || 1500 %>
                  </span>
                </div>
              <% end %>
            </div>

            <% if org.leaderboards.count > 4 %>
              <div class="mt-4 text-center">
                <%= link_to organization_path(org),
                            class: "inline-flex items-center px-4 py-2 rounded-lg text-xs font-medium text-purple-400 hover:text-white hover:bg-slate-800/80 border border-slate-700 hover:border-purple-500/50 transition-all duration-200" do %>
                  <i class="fas fa-plus mr-2"></i>
                  <span><%= org.leaderboards.count - 4 %> more leaderboards</span>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="mt-4 p-4 rounded-lg bg-slate-800/50 border border-slate-700 text-sm text-slate-400 flex items-center justify-center">
              <i class="fas fa-info-circle mr-2"></i>
              <span>No leaderboards created yet</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-slate-400">
      <div class="w-24 h-24 rounded-full bg-slate-800/70 flex items-center justify-center mb-6 shadow-lg">
        <i class="fas fa-building text-4xl text-purple-400/70"></i>
      </div>
      <p class="text-lg font-medium text-slate-300 mb-2">You are not part of any gyms yet</p>
      <p class="text-sm text-slate-500 mb-6">Join or create a gym to start tracking your matches</p>
      <%= link_to organizations_path,
                  class: "inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-0.5 active:scale-98 transition-all duration-200" do %>
        <i class="fas fa-users mr-2"></i>
        Find Gyms to Join
      <% end %>
    </div>
  <% end %>
</div>
