<% profiles ||= [] %>
<div class="space-y-6">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-xl font-semibold text-slate-900">
      <%= @scoped_organization ? @scoped_organization.name : "Your organizations" %>
    </h2>
    <% if @scoped_organization %>
      <%= link_to organization_path(@scoped_organization), class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900" do %>
        View organization
        <i class="fas fa-arrow-right text-xs"></i>
      <% end %>
    <% else %>
      <%= link_to organizations_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900" do %>
        View all
        <i class="fas fa-arrow-right text-xs"></i>
      <% end %>
    <% end %>
  </div>

  <% if profiles.any? %>
    <div class="space-y-4">
      <% profiles.each do |profile| %>
        <% org = profile.organization %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <%= link_to org.name, organization_path(org), class: "text-lg font-semibold text-slate-900 hover:text-slate-700" %>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-500">
                  <%= org.open? ? "Public" : "Private" %>
                </span>
                <% if org.owner?(current_user) %>
                  <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-medium text-white">Owner</span>
                <% end %>
              </div>
              <div class="flex flex-wrap gap-3 text-xs text-slate-500">
                <span class="flex items-center gap-1">
                  <i class="fas fa-users"></i>
                  <%= pluralize(org.users.count, "member") %>
                </span>
                <% if org.location.present? %>
                  <span class="flex items-center gap-1">
                    <i class="fas fa-map-marker-alt"></i>
                    <%= org.location %>
                  </span>
                <% end %>
              </div>
            </div>
            <div class="text-sm text-slate-500">
              Joined <%= profile.created_at.strftime("%b %Y") %>
            </div>
          </div>

          <% if org.leaderboards.any? %>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <% org.leaderboards.first(4).each do |leaderboard| %>
                <% user_rating = profile.leaderboard_ratings.find { |rating| rating.leaderboard_id == leaderboard.id } %>
                <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm">
                  <p class="font-medium text-slate-700"><%= leaderboard.name %></p>
                  <span class="font-semibold text-slate-900"><%= user_rating&.rating&.round || 1500 %></span>
                </div>
              <% end %>
            </div>
            <% if org.leaderboards.count > 4 %>
              <div class="mt-4 text-sm">
                <%= link_to "View all leaderboards", organization_path(org), class: "text-slate-600 hover:text-slate-900" %>
              </div>
            <% end %>
          <% else %>
            <p class="mt-4 text-sm text-slate-500">No leaderboards yet.</p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
      <p class="text-base font-semibold">You are not part of any organizations yet.</p>
      <p class="mt-2 text-sm text-slate-500">Join an existing club or create a new one to start logging matches.</p>
      <div class="mt-4">
        <%= link_to "Find a gym", organizations_path, class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
      </div>
    </div>
  <% end %>
</div>
