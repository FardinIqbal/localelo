<div class="p-6">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      Leaderboard Spotlight
    </h2>

    <% if @most_active_leaderboard.present? %>
      <span class="px-3 py-1 rounded-full bg-purple-500/20 text-purple-400 text-sm font-medium">
        <i class="fas fa-fire mr-1"></i> Most Active
      </span>
    <% end %>
  </div>

  <% if @most_active_leaderboard.present? %>
    <div class="bg-slate-50 dark:bg-slate-700/50 rounded-lg p-4 border border-slate-200 dark:border-slate-600 hover:border-purple-500/50 transition-all">
      <div class="flex justify-between items-center">
        <div>
          <h3 class="font-bold text-lg text-slate-900 dark:text-white"><%= @most_active_leaderboard.name %></h3>

          <div class="flex items-center text-slate-500 dark:text-slate-400 text-sm mt-1">
            <i class="fas fa-building mr-2"></i>
            <%= @most_active_leaderboard.organization.name %>
          </div>

          <div class="mt-3 flex space-x-3">
            <div class="px-3 py-1 rounded-lg bg-slate-200 dark:bg-slate-600/50 text-sm text-slate-700 dark:text-white">
              <i class="fas fa-users mr-1"></i>
              <%= @most_active_leaderboard.leaderboard_ratings.count %> Players
            </div>

            <div class="px-3 py-1 rounded-lg bg-slate-200 dark:bg-slate-600/50 text-sm text-slate-700 dark:text-white">
              <i class="fas fa-trophy mr-1"></i>
              <%= @most_active_leaderboard.sport || "Sport" %>
            </div>
          </div>
        </div>

        <%= link_to rankings_organization_leaderboard_path(@most_active_leaderboard.organization, @most_active_leaderboard),
                    class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all transform hover:-translate-y-0.5" do %>
          <i class="fas fa-chart-line mr-2"></i> <%= t("dashboard.leaderboard_spotlight.view_full") %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-10 text-slate-500 dark:text-slate-400">
      <div class="w-20 h-20 rounded-full bg-slate-100 dark:bg-slate-800/70 flex items-center justify-center mb-4">
        <i class="fas fa-trophy text-3xl text-purple-500/70 dark:text-purple-400/70"></i>
      </div>

      <p class="text-lg"><%= t("dashboard.leaderboard_spotlight.empty") %></p>

      <%= link_to organizations_path,
                  class: "mt-4 px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all transform hover:-translate-y-0.5" do %>
        <i class="fas fa-search mr-2"></i> Find Organizations
      <% end %>
    </div>
  <% end %>
</div>
