<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-900">Leaderboard spotlight</h2>
    <% if @most_active_leaderboard.present? %>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">Most active</span>
    <% end %>
  </div>

  <% if @most_active_leaderboard.present? %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-2">
          <p class="text-lg font-semibold text-slate-900"><%= @most_active_leaderboard.name %></p>
          <p class="text-sm text-slate-500"><i class="fas fa-building mr-1"></i><%= @most_active_leaderboard.organization.name %></p>
          <div class="flex flex-wrap gap-2 text-xs text-slate-500">
            <span class="inline-flex items-center gap-1 rounded-full border border-slate-300 px-3 py-1 font-semibold text-slate-600">
              <i class="fas fa-users"></i>
              <%= @most_active_leaderboard.leaderboard_ratings.count %> players
            </span>
            <% if @most_active_leaderboard.sport.present? %>
              <span class="inline-flex items-center gap-1 rounded-full border border-slate-300 px-3 py-1 font-semibold text-slate-600">
                <i class="fas fa-trophy"></i>
                <%= @most_active_leaderboard.sport %>
              </span>
            <% end %>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to rankings_organization_leaderboard_path(@most_active_leaderboard.organization, @most_active_leaderboard),
                      class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
            View rankings
            <i class="fas fa-arrow-right text-xs"></i>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
      <p class="text-base font-semibold">No leaderboard activity yet.</p>
      <p class="mt-2 text-sm text-slate-500">Start logging matches to highlight the busiest ladder.</p>
      <div class="mt-4">
        <%= link_to "Explore organizations", organizations_path, class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
      </div>
    </div>
  <% end %>
</div>
