<div class="flex flex-wrap gap-3">
  <%= link_to new_match_path,
              class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
    <i class="fas fa-plus"></i>
    Log a match
  <% end %>

  <%= link_to organizations_path,
              class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" do %>
    <i class="fas fa-users"></i>
    Browse gyms
  <% end %>

  <%= link_to new_organization_path,
              class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" do %>
    <i class="fas fa-building"></i>
    Create a gym
  <% end %>
</div>
