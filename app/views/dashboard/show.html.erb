<h1 class="font-bold text-4xl">Welcome, <%= current_user.first_name || current_user.email %></h1>

<h2 class="text-2xl font-semibold mt-4">Your Organizations</h2>
<% if @organizations.any? %>
  <ul class="list-disc ml-6">
    <% @organizations.each do |org| %>
      <li>
        <%= link_to org.name, organization_path(org.slug), class: "text-blue-500 hover:underline" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-600">You are not part of any organizations. <%= link_to "Join one", organizations_path, class: "text-blue-500 hover:underline" %></p>
<% end %>

<h2 class="text-2xl font-semibold mt-6">Recent Matches</h2>
<% if @recent_matches.any? %>
  <ul class="list-disc ml-6">
    <% @recent_matches.each do |match| %>
      <li>
        <%= link_to "Match vs #{match.opponent_id == current_user.id ? match.user1.username : match.opponent.username}", match_path(match), class: "text-blue-500 hover:underline" %>
        - <strong><%= match.winner_id == current_user.id ? "You Won" : (match.winner_id.nil? ? "Draw" : "You Lost") %></strong>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-600">No recent matches logged.</p>
<% end %>
