<!-- REVAMPED DASHBOARD VIEW FOR LOCALELO ===================================
     Purpose: A visually rich, mobile-first landing page with all the new partials
     integrated and enhanced using design from the older dashboard.
-->

<div class="relative min-h-screen bg-gradient-to-br from-slate-900 to-slate-800 text-white overflow-x-hidden">

  <!-- Decorative Background Elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-6 space-y-8">

    <!-- Welcome Header -->
    <%= render "dashboard/welcome_header" %>

    <!-- Quick Actions -->
    <%= render "dashboard/quick_actions" %>

    <!-- Stat Cards Row -->
    <%= render "dashboard/performance_stats" %>

    <!-- Match Verifications -->
    <div class="bg-slate-800/70 rounded-xl border border-slate-700">
      <%= render "dashboard/match_verifications", matches: @pending_matches %>
    </div>

    <!-- My Organizations -->
    <div class="bg-slate-800/70 rounded-xl border border-slate-700">
      <%= render "dashboard/my_organizations" %>
    </div>

    <!-- Recent Activity Toggle + Match Feed -->
    <div class="bg-slate-800/70 rounded-xl border border-slate-700">
      <%= render "dashboard/recent_activity" %>
    </div>

    <!-- Leaderboard Spotlight -->
    <div class="bg-slate-800/70 rounded-xl border border-slate-700">
      <%= render "dashboard/leaderboard_spotlight" %>
    </div>

    <!-- Roadmap / Teaser -->
    <div class="bg-slate-800/70 rounded-xl border border-slate-700">
      <%= render "dashboard/roadmap_teaser" %>
    </div>

  </div>

  <!-- Turbo Stream Channels -->
  <%= turbo_stream_from "user_#{current_user.id}verifications" %>
  <%= turbo_stream_from "user#{current_user.id}activity" %>
  <%= turbo_stream_from "user#{current_user.id}_organizations" %>

</div>
