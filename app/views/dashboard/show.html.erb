<!--
  NEW DASHBOARD VIEW FOR LOCALELO
  ======================================
  Purpose: This is the user's main landing page after login. It shows:
  - Matches to verify (if someone logged a match with you as opponent)
  - Recent match activity across all organizations you are part of
  - Leaderboard spotlight (most active leaderboard)
  - Roadmap / teaser box (optional future-facing section)

  DESIGN GOALS:
  -------------
  - Mobile-first layout with desktop enhancements
  - Only show essential, actionable user info
  - Use Turbo Streams for live updates (no reload)
  - Use Stimulus for toggles and polling fallback
  - Strong accessibility (ARIA support, keyboard nav)
  - Empty states for all components
  - i18n-ready (all text wrapped in translation keys)
-->

<div class="relative min-h-screen bg-gradient-to-br from-slate-900 to-slate-800 text-white">
  <div class="relative z-10 max-w-5xl mx-auto px-4 py-6 space-y-8">

    <!-- Matches to Verify (Live via Turbo Streams) -->
    <!-- This section no longer uses turbo-frame because we rely on turbo_stream_from and DOM targeting instead -->
    <!-- Turbo Stream updates from the server will dynamically remove <li id="verify_match_#{match.id}"> -->
    <%= render "dashboard/match_verifications", matches: @pending_matches %>

    <!-- Recent Activity (Toggle between All and Mine) -->
    <!-- This pulls in the full <section> with Stimulus controller, buttons, and turbo frame -->
    <%= render "dashboard/recent_activity", matches: @recent_matches %>

    <!-- Leaderboard Spotlight (Most Active) -->
    <!-- IMPLEMENTATION LATER -->

    <!-- Roadmap / Feature Teaser (Optional future section) -->
    <!-- IMPLEMENTATION LATER -->

  </div>

  <!-- Turbo Stream subscriptions -->
  <!-- Enables real-time updates for both verifications and activity -->
  <%= turbo_stream_from "user_#{current_user.id}_verifications" %>
  <%= turbo_stream_from "user_#{current_user.id}_activity" %>
</div>
