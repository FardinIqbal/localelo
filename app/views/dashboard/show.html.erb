<!-- REVAMPED DASHBOARD VIEW FOR LOCALELO ===================================
     Purpose: A visually rich, mobile-first landing page with all the new partials
     integrated and enhanced using design from the older dashboard.
-->

<div class="relative min-h-screen text-white">

  <!-- Decorative Background Elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse z-0 pointer-events-none"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse z-0 pointer-events-none" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-8 space-y-6">

    <!-- Welcome Header -->
    <%= render "dashboard/welcome_header", profile: @profile %>

    <!-- Quick Actions -->
    <%= render "dashboard/quick_actions", profile: @profile %>

    <!-- Context Switcher -->
    <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl border border-slate-700 px-6 py-5 transition-all duration-300 hover:border-purple-500/30">
      <label for="dashboard-organization-selector" class="block text-sm font-semibold text-slate-300 uppercase tracking-wide mb-3">
        Viewing Dashboard For:
      </label>
      <select id="dashboard-organization-selector"
              name="organization"
              data-controller="context-switcher"
              data-action="change->context-switcher#switch"
              class="w-full px-4 py-3 bg-slate-900/70 border-2 border-slate-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200">
        <option value="all">All Organizations</option>
        <% @selectable_organizations.each do |org| %>
          <option value="<%= org.id %>"><%= org.name %></option>
        <% end %>
      </select>
    </div>

    <!-- Stat Cards Row -->
    <%= render "dashboard/performance_stats", profile: @profile, stats: @profile_stats %>

    <!-- My Organizations -->
    <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl border border-slate-700 transition-all duration-300 hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10">
      <%= render "dashboard/my_organizations", profiles: @profiles %>
    </div>

    <!-- Recent Activity Toggle + Match Feed -->
    <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl border border-slate-700 transition-all duration-300 hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10">
      <%= render "dashboard/recent_activity", profile: @profile, matches_all: @recent_matches_all, matches_mine: @recent_matches_mine %>
    </div>

    <!-- Leaderboard Spotlight -->
    <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl border border-slate-700 transition-all duration-300 hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10">
      <%= render "dashboard/leaderboard_spotlight" %>
    </div>

    <!-- Roadmap / Teaser -->
    <div class="bg-slate-800/80 backdrop-blur-xl rounded-xl border border-slate-700 transition-all duration-300 hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10">
      <%= render "dashboard/roadmap_teaser" %>
    </div>

  </div>

  <!-- Turbo Stream Channels -->
  <%= turbo_stream_from "user#{current_user.id}activity" %>
  <%= turbo_stream_from "user#{current_user.id}_organizations" %>

</div>
