<!-- app/views/dashboard/_match_verifications.html.erb -->
<div class="p-6">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      <%= t('dashboard.matches_to_verify.title') %>
    </h2>

    <% if matches.any? %>
  <span class="px-3 py-1 rounded-full bg-orange-500/20 text-orange-400 text-sm font-medium">
    <%= pluralize(matches.count, 'match') %> pending
  </span>
    <% end %>

  </div>

  <% if matches.any? %>
    <div class="space-y-3" role="list" aria-label="<%= t('dashboard.matches_to_verify.title') %>">
      <% matches.each do |match| %>
        <div id="verify_match_<%= match.id %>"
             class="bg-slate-700/50 rounded-lg p-4 border border-slate-600 hover:border-orange-500/50 transition-all"
             data-controller="verify-match"
             data-verify-match-id-value="<%= match.id %>">

          <div class="flex flex-col md:flex-row justify-between md:items-center">
            <div class="space-y-3">

              <!-- Match Players -->
              <div class="flex items-center">
                <div class="w-10 h-10 rounded-full bg-slate-600 flex items-center justify-center">
                  <%= match.user1.first_name&.first || match.user1.username.first %>
                </div>
                <span class="mx-3 text-slate-400">vs</span>
                <div class="w-10 h-10 rounded-full bg-slate-600 flex items-center justify-center ring-2 ring-purple-400">
                  <%= current_user.first_name&.first || current_user.username.first %>
                </div>
              </div>

              text

              <!-- Match Details -->
              <div class="space-y-1">
                <p class="text-sm text-slate-300">
                  <%= t("dashboard.matches_to_verify.logged_by",
                        user: match.user1.username,
                        time: l(match.match_time || match.created_at, format: :short)) %>
                </p>

                <p class="text-sm">
                  <span class="text-slate-400"><%= t("dashboard.matches_to_verify.claimed_winner") %>:</span>
                  <span class="font-medium">
                    <%= if match.winner_id == current_user.id
                          t("dashboard.matches_to_verify.you")
                        else
                          match.winner_id.present? ?
                            (match.user1.first_name || match.user1.username) :
                            t("dashboard.matches_to_verify.draw")
                        end %>
                  </span>
                </p>

                <div class="flex items-center text-sm text-slate-400">
                  <i class="fas fa-trophy mr-2"></i>
                  <%= match.leaderboard.name %>
                </div>
              </div>
            </div>

            <div class="flex space-x-3 mt-4 md:mt-0">
              <button
                type="button"
                class="px-4 py-2 rounded-lg bg-gradient-to-r from-green-500 to-emerald-500 text-white font-medium hover:shadow-lg hover:shadow-green-500/20 transition-all transform hover:-translate-y-0.5"
                data-action="click->verify-match#confirmVerify"
                aria-label="<%= t('dashboard.actions.verify') %>">
                <i class="fas fa-check mr-2"></i> <%= t("dashboard.actions.verify") %>
              </button>

              <button
                type="button"
                class="px-4 py-2 rounded-lg bg-gradient-to-r from-red-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-red-500/20 transition-all transform hover:-translate-y-0.5"
                data-action="click->verify-match#confirmDeny"
                aria-label="<%= t('dashboard.actions.deny') %>">
                <i class="fas fa-times mr-2"></i> <%= t("dashboard.actions.deny") %>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-10 text-slate-400" role="status">
      <div class="w-20 h-20 rounded-full bg-slate-800/70 flex items-center justify-center mb-4">
        <i class="fas fa-check-circle text-3xl text-green-400/70"></i>
      </div>
      <p class="text-lg"><%= t("dashboard.matches_to_verify.empty") %></p>
    </div>
  <% end %>
</div>
