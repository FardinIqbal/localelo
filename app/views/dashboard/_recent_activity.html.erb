<div class="space-y-6" data-controller="toggle">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-xl font-semibold text-slate-900">
      <%= @scoped_organization ? "Recent activity · #{@scoped_organization.name}" : "Recent activity" %>
    </h2>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button"
              data-action="toggle#switch"
              data-toggle-target="all"
              aria-selected="<%= params[:view] != 'mine' %>"
              class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold <%= params[:view] != 'mine' ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 text-slate-600 hover:text-slate-900' %>">
        <i class="fas fa-globe"></i>
        Everyone
      </button>
      <button type="button"
              data-action="toggle#switch"
              data-toggle-target="mine"
              aria-selected="<%= params[:view] == 'mine' %>"
              class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold <%= params[:view] == 'mine' ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 text-slate-600 hover:text-slate-900' %>">
        <i class="fas fa-user"></i>
        Just me
      </button>
      <%= link_to matches_path, class: "inline-flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900" do %>
        View all
        <i class="fas fa-arrow-right text-xs"></i>
      <% end %>
    </div>
  </div>

  <% matches_all ||= [] %>
  <% matches_mine ||= [] %>
  <% profile ||= nil %>
  <%= turbo_frame_tag "recent_activity" do %>
    <% matches = params[:view] == "mine" ? matches_mine : matches_all %>

    <% if matches.present? %>
      <div class="space-y-3">
        <% matches.each do |match| %>
          <%= render partial: "dashboard/match_card", locals: { match: match, current_user: current_user, current_profile: profile } %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
        <p class="text-base font-semibold">No matches yet.</p>
        <p class="mt-2 text-sm text-slate-500">Log a match to start the activity feed.</p>
        <div class="mt-4">
          <%= link_to (@scoped_organization ? new_match_path(organization_id: @scoped_organization.id) : new_match_path),
                      class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
            Log a match
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
