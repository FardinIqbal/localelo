<div data-controller="toggle" class="space-y-2">
  <!-- Toggle Buttons -->
  <div role="tablist" class="flex gap-2">
    <button type="button"
            data-action="toggle#switch"
            data-toggle-target="all"
            aria-selected="<%= params[:view] != 'mine' %>"
            class="btn">
      <%= t("dashboard.recent_activity.all") %>
    </button>

    <button type="button"
            data-action="toggle#switch"
            data-toggle-target="mine"
            aria-selected="<%= params[:view] == 'mine' %>"
            class="btn">
      <%= t("dashboard.recent_activity.mine") %>
    </button>
  </div>

  <!-- Turbo Frame: recent match list -->
  <%= turbo_frame_tag "recent_activity" do %>
    <% matches = params[:view] == "mine" ? @recent_matches_mine : @recent_matches_all %>
    <% if matches.any? %>
      <div class="space-y-2">
        <% matches.each do |match| %>
          <%= render partial: "dashboard/match_card", locals: { match: match, current_user: current_user } %>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted"><%= t("dashboard.empty_states.no_matches") %></p>
    <% end %>
  <% end %>
</div>
