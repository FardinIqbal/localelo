<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= match.leaderboard.name %></p>
      <p class="text-lg font-semibold text-slate-900">
        <%= match.user1.first_name || match.user1.username %>
        vs
        <%= match.opponent.first_name || match.opponent.username %>
      </p>
      <p class="text-xs text-slate-500">Logged <%= time_ago_in_words(match.created_at) %> ago</p>
    </div>
    <div class="text-right text-sm text-slate-600">
      <% if match.is_draw %>
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1 text-sm font-semibold text-slate-700">
          <i class="fas fa-handshake"></i>
          Draw
        </span>
      <% elsif match.winner_id.present? %>
        <% if match.winner_id == current_user.id %>
          <span class="inline-flex items-center gap-2 rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-700">
            <i class="fas fa-trophy"></i>
            Victory
          </span>
        <% elsif match.user1_id == current_user.id || match.opponent_id == current_user.id %>
          <span class="inline-flex items-center gap-2 rounded-full bg-rose-100 px-3 py-1 text-sm font-semibold text-rose-700">
            <i class="fas fa-times"></i>
            Defeat
          </span>
        <% else %>
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1 text-sm font-semibold text-slate-700">
            <i class="fas fa-flag"></i>
            <%= match.winner_id == match.user1_id ? (match.user1.first_name || match.user1.username) : (match.opponent.first_name || match.opponent.username) %> won
          </span>
        <% end %>
      <% end %>
      <% elo_change = match.elo_change_for_user(current_user) %>
      <% if elo_change.present? %>
        <p class="mt-2 text-xs text-slate-500">Rating change: <%= elo_change.positive? ? "+" : "" %><%= elo_change %> ELO</p>
      <% end %>
      <div class="mt-2">
        <%= link_to match_path(match), class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900" do %>
          View details
          <i class="fas fa-arrow-right text-xs"></i>
        <% end %>
      </div>
    </div>
  </div>
</article>
