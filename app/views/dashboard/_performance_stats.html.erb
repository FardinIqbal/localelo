<% stats ||= {} %>
<% profile ||= nil %>
<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total matches</p>
    <p class="mt-3 text-3xl font-semibold text-slate-900"><%= stats[:total_matches] || 0 %></p>
    <p class="mt-2 text-xs text-slate-500">All time</p>
  </div>

  <% if @scoped_organization %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Win / loss</p>
      <p class="mt-3 text-3xl font-semibold text-slate-900"><%= stats[:win_loss_ratio] || "0.0" %></p>
      <p class="mt-2 text-xs text-slate-500"><%= stats[:total_wins] || 0 %> W · <%= stats[:total_losses] || 0 %> L</p>
    </div>
  <% end %>

  <% if @scoped_organization %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Highest rating</p>
      <p class="mt-3 text-3xl font-semibold text-slate-900"><%= stats[:highest_elo] || 1500 %></p>
      <p class="mt-2 text-xs text-slate-500">Peak</p>
    </div>
  <% end %>

  <% if @scoped_organization %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Average rating</p>
      <p class="mt-3 text-3xl font-semibold text-slate-900"><%= stats[:average_elo] || 1500 %></p>
      <p class="mt-2 text-xs text-slate-500">Across the organization</p>
    </div>
  <% end %>
</div>
