<!-- app/views/devise/sessions/new.html.erb -->
<section class="min-h-screen w-full flex items-center justify-center px-4 py-12 relative overflow-hidden">
  <!-- Animated background elements -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-950 z-0"></div>

  <!-- Decorative orbs -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-600/20 rounded-full filter blur-3xl animate-pulse-slow"></div>
  <div
    class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-pink-600/20 rounded-full filter blur-3xl animate-pulse-slow"
    style="animation-delay: 1s;"
  ></div>

  <div
    class="bg-slate-900/40 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl shadow-purple-500/10 max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 overflow-hidden z-10"
  >
    <!-- Left Column: Info/Marketing (hidden on mobile) -->
    <div
      class="hidden md:flex flex-col justify-center p-8 bg-gradient-to-br from-indigo-900/90 to-purple-900/90 text-white backdrop-blur-md relative overflow-hidden"
    >
      <!-- Subtle animated gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600/10 to-pink-500/10 animate-pulse-slow"></div>

      <h2 class="text-2xl font-bold tracking-tight mb-4 relative">
        Welcome Back to
        <span
          class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          LocalElo
        </span>
      </h2>
      <p class="text-indigo-200 mb-6 text-sm">
        Track matches, analyze performance, and stay ahead of the competition!
      </p>

      <ul class="space-y-3 text-sm">
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Real-time leaderboards for all players
        </li>
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Automatic Elo tracking for match results
        </li>
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          AI-powered insights to improve skills
        </li>
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Group events and tournaments made simple
        </li>
      </ul>

      <div class="mt-8 italic text-sm text-indigo-200 border-l-2 border-pink-500/50 pl-4">
        "Victorious warriors win first and then go to war."
        <span class="block mt-1 text-xs text-indigo-300">— Sun Tzu</span>
      </div>

      <!-- Stats with subtle glow -->
      <div class="mt-8 grid grid-cols-2 gap-4">
        <div class="bg-white/5 backdrop-blur-sm rounded-lg p-3 border border-white/10">
          <div class="text-pink-400 font-bold">500+</div>
          <div class="text-xs text-indigo-200">Active Clubs</div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm rounded-lg p-3 border border-white/10">
          <div class="text-pink-400 font-bold">50k+</div>
          <div class="text-xs text-indigo-200">Matches Tracked</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Sign-In Form -->
    <div class="p-8 bg-slate-900/60 backdrop-blur-md">
      <!-- Mobile Header (visible only on mobile) -->
      <div class="md:hidden text-center mb-6">
        <h2
          class="text-xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Sign In
        </h2>
        <div class="flex justify-center mt-2">
          <div
            class="w-12 h-1 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full"
          ></div>
        </div>
      </div>

      <!-- Devise Sign-In Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-envelope text-slate-400"></i>
          </div>
          <%= f.email_field :email, required: true, placeholder: "Email",
                            class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- Password -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-lock text-slate-400"></i>
          </div>
          <%= f.password_field :password, required: true, placeholder: "Password",
                               class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- Remember Me + Forgot Password -->
        <div class="flex items-center justify-between text-sm">
          <% if devise_mapping.rememberable? %>
            <div class="flex items-center">
              <%= f.check_box :remember_me,
                              class: "h-4 w-4 text-purple-600 focus:ring-purple-500 bg-slate-800 border-white/20 rounded" %>
              <%= f.label :remember_me,
                          class: "ml-2 text-slate-300" %>
            </div>
          <% end %>
          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot password?", new_password_path(resource_name),
                        class: "text-purple-400 hover:text-pink-400 transition-colors duration-300" %>
          <% end %>
        </div>

        <!-- Sign In Button -->
        <div class="mt-6">
          <%= f.submit "Sign In",
                       class: "w-full bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 text-white py-3 rounded-xl font-medium transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-500/20" %>
        </div>
      <% end %>

      <!-- Sign Up Prompt -->
      <p class="text-center text-sm text-slate-400 mt-6">
        New to LocalElo?
        <%= link_to "Create an Account", new_registration_path(resource_name),
                    class: "text-purple-400 font-medium hover:text-pink-400 transition-colors duration-300" %>
      </p>

      <!-- Social Login Options -->
      <div class="mt-8">
        <div class="relative flex items-center">
          <div class="flex-grow border-t border-white/10"></div>
          <span class="flex-shrink mx-4 text-slate-400 text-xs"
          >or sign in with</span
          >
          <div class="flex-grow border-t border-white/10"></div>
        </div>

        <div class="flex justify-center space-x-4 mt-4">
          <button
            class="flex items-center justify-center w-12 h-12 rounded-full bg-slate-800/80 border border-white/10 shadow-md text-slate-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 hover:-translate-y-1 hover:text-white"
          >
            <i class="fab fa-google"></i>
          </button>
          <button
            class="flex items-center justify-center w-12 h-12 rounded-full bg-slate-800/80 border border-white/10 shadow-md text-slate-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 hover:-translate-y-1 hover:text-white"
          >
            <i class="fab fa-facebook-f"></i>
          </button>
          <button
            class="flex items-center justify-center w-12 h-12 rounded-full bg-slate-800/80 border border-white/10 shadow-md text-slate-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 hover:-translate-y-1 hover:text-white"
          >
            <i class="fab fa-apple"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
