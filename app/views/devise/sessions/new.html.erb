<section class="min-h-screen bg-gray-100 flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white shadow-lg rounded-lg p-8">

    <!-- Header -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800">Sign In to LocalElo</h2>
      <p class="text-gray-600 text-sm">Log in to manage your organization's rankings and match history.</p>
    </div>

    <!-- Sign-In Form -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Email -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <%= f.email_field :email, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- Password -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <%= f.password_field :password, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- Remember Me -->
      <div class="flex items-center justify-between">
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded transition-all duration-300 hover:scale-110" %>
            <%= f.label :remember_me, class: "ml-2 text-sm text-gray-600 hover:text-blue-600 transition-colors duration-300" %>
          </div>
        <% end %>

        <%- if devise_mapping.recoverable? %>
          <%= link_to "Forgot password?", new_password_path(resource_name),
                      class: "text-sm text-blue-600 hover:text-blue-700 font-medium transition-all duration-300 hover:underline" %>
        <% end %>
      </div>

      <!-- Submit Button -->
      <div class="mt-4">
        <%= f.submit "Sign In", class: "w-full bg-indigo-600 text-white py-2 rounded-lg font-semibold hover:bg-indigo-700 transition" %>
      </div>
    <% end %>

    <!-- Sign Up Link -->
    <p class="text-center text-sm text-gray-600 mt-4">
      Don't have an account?
      <%= link_to "Sign up", new_registration_path(resource_name), class: "text-indigo-600 font-semibold hover:underline" %>
    </p>
  </div>
</section>
