<section class="min-h-screen bg-gray-100 flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white shadow-lg rounded-lg p-8">

    <!-- Header -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800">Create Your LocalElo Account</h2>
      <p class="text-gray-600 text-sm">Easily manage rankings and match history for your gym or club.</p>
    </div>

    <!-- Sign-Up Form -->
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Username (Required) -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Username</label>
        <%= f.text_field :username, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- First Name -->
      <div>
        <label class="block text-sm font-medium text-gray-700">First Name</label>
        <%= f.text_field :first_name, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- Last Name -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Last Name</label>
        <%= f.text_field :last_name, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <%= f.email_field :email, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- Password -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <%= f.password_field :password, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Confirm Password</label>
        <%= f.password_field :password_confirmation, required: true, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring focus:border-indigo-300" %>
      </div>

      <% if @minimum_password_length %>
        <p class="text-xs text-gray-500">At least <%= @minimum_password_length %> characters required.</p>
      <% end %>

      <!-- Submit Button -->
      <div class="mt-4">
        <%= f.submit "Create Account", class: "w-full bg-indigo-600 text-white py-2 rounded-lg font-semibold hover:bg-indigo-700 transition" %>
      </div>
    <% end %>

    <!-- Sign In Link -->
    <p class="text-center text-sm text-gray-600 mt-4">
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "text-indigo-600 font-semibold hover:underline" %>
    </p>
  </div>
</section>
