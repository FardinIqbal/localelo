<!-- app/views/devise/registrations/new.html.erb -->
<section class="min-h-screen w-full flex items-center justify-center px-4 py-12 relative overflow-hidden">
  <!-- Animated background elements -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-950 z-0"></div>

  <!-- Decorative orbs - Hidden on mobile for performance -->
  <div class="decorative-blur absolute top-1/3 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full filter blur-3xl animate-pulse-slow"></div>
  <div class="decorative-blur absolute bottom-1/3 left-1/4 w-64 h-64 bg-pink-600/20 rounded-full filter blur-3xl animate-pulse-slow delay-1500"></div>

  <div
    class="bg-slate-900/40 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl shadow-purple-500/10 max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 overflow-hidden z-10"
  >
    <!-- Left Column: Info/Marketing (hidden on mobile) -->
    <div
      class="hidden md:flex flex-col justify-center p-8 bg-gradient-to-br from-indigo-900/90 to-purple-900/90 text-white backdrop-blur-md relative overflow-hidden"
    >
      <!-- Subtle animated gradient overlay -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-purple-600/10 to-pink-500/10 animate-pulse-slow"
      ></div>

      <h2 class="text-2xl font-bold tracking-tight mb-4 relative">
        Take Your Club to the Next Level with
        <span
          class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          LocalElo
        </span>
      </h2>

      <p class="text-indigo-200 mb-6 text-sm">
        Register now and effortlessly manage your personal or club rankings.
      </p>

      <ul class="space-y-3 text-sm">
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Simple setup for any one-on-one sport
        </li>
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Automated Elo updates for every match
        </li>
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Track performance with AI-driven insights
        </li>
        <li class="flex items-center">
          <i class="fas fa-check-circle mr-2 text-pink-400"></i>
          Motivate members with friendly competition
        </li>
      </ul>

      <div class="mt-8 italic text-sm text-indigo-200 border-l-2 border-pink-500/50 pl-4">
        "The successful warrior is the average person with laser-like focus."
        <span class="block mt-1 text-xs text-indigo-300"
        >— Bruce Lee</span
        >
      </div>

      <!-- Live activity indicator -->
      <div class="mt-8 bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-white/10">
        <div class="flex items-center mb-3">
          <div
            class="h-2 w-2 rounded-full bg-green-500 animate-pulse mr-2"
          ></div>
          <span class="text-xs text-indigo-200">Live Activity</span>
        </div>
        <div class="text-xs text-indigo-300 space-y-2">
          <div class="flex items-center justify-between">
            <span>New users today</span>
            <span class="text-pink-400 font-medium">24</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Matches tracked today</span>
            <span class="text-pink-400 font-medium">187</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Sign-Up Form -->
    <div class="p-8 bg-slate-900/60 backdrop-blur-md">
      <!-- Mobile Header (visible only on mobile) -->
      <div class="md:hidden text-center mb-6">
        <h2
          class="text-xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Join LocalElo
        </h2>
        <div class="flex justify-center mt-2">
          <div
            class="w-12 h-1 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full"
          ></div>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="h-1.5 bg-slate-800/80 rounded-full mb-6 overflow-hidden">
        <div
          class="h-full bg-gradient-to-r from-purple-500 to-pink-500 rounded-full w-0 transition-all duration-500"
          id="progressBar"
        ></div>
      </div>

      <!-- Social Login Buttons -->
      <div class="mb-6">
        <div class="flex justify-center space-x-4">
          <button
            class="flex items-center justify-center w-12 h-12 rounded-full bg-slate-800/80 border border-white/10 shadow-md text-slate-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 hover:-translate-y-1 hover:text-white"
          >
            <i class="fab fa-google"></i>
          </button>
          <button
            class="flex items-center justify-center w-12 h-12 rounded-full bg-slate-800/80 border border-white/10 shadow-md text-slate-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 hover:-translate-y-1 hover:text-white"
          >
            <i class="fab fa-facebook-f"></i>
          </button>
          <button
            class="flex items-center justify-center w-12 h-12 rounded-full bg-slate-800/80 border border-white/10 shadow-md text-slate-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 hover:-translate-y-1 hover:text-white"
          >
            <i class="fab fa-apple"></i>
          </button>
        </div>

        <div class="relative flex items-center my-6">
          <div class="flex-grow border-t border-white/10"></div>
          <span class="flex-shrink mx-4 text-slate-400 text-xs"
          >or with email</span
          >
          <div class="flex-grow border-t border-white/10"></div>
        </div>
      </div>

      <!-- Devise Sign-Up Form -->
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4", id: "registrationForm" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Username -->
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <i class="fas fa-user text-slate-400"></i>
          </div>
          <%= f.text_field :username, required: true, placeholder: "Username",
                           class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- First Name -->
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <i class="fas fa-id-card text-slate-400"></i>
          </div>
          <%= f.text_field :first_name, required: true, placeholder: "First Name",
                           class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- Last Name -->
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <i class="fas fa-id-card text-slate-400"></i>
          </div>
          <%= f.text_field :last_name, required: true, placeholder: "Last Name",
                           class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- Email -->
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <i class="fas fa-envelope text-slate-400"></i>
          </div>
          <%= f.email_field :email, required: true, placeholder: "Email",
                            class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- Password -->
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <i class="fas fa-lock text-slate-400"></i>
          </div>
          <%= f.password_field :password, required: true, placeholder: "Password",
                               class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <!-- Password Confirmation -->
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <i class="fas fa-lock text-slate-400"></i>
          </div>
          <%= f.password_field :password_confirmation, required: true, placeholder: "Confirm Password",
                               class: "w-full pl-10 px-3 py-3 bg-slate-800/50 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-white placeholder-slate-400 transition-all duration-300" %>
        </div>

        <% if @minimum_password_length %>
          <p class="text-xs text-slate-400 bg-slate-800/30 p-2 rounded-lg border border-white/5">
            <i class="fas fa-info-circle mr-1 text-purple-400"></i>
            At least <%= @minimum_password_length %> characters required.
          </p>
        <% end %>

        <!-- Submit Button -->
        <div class="mt-6">
          <%= f.submit "Create Account",
                       class: "w-full bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 text-white py-3 rounded-xl font-medium transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-500/20" %>
        </div>
      <% end %>

      <!-- Sign In Prompt -->
      <p class="text-center text-sm text-slate-400 mt-6">
        Already have an account?
        <%= link_to "Sign in", new_session_path(resource_name),
                    class: "text-purple-400 font-medium hover:text-pink-400 transition-colors duration-300" %>
      </p>
    </div>
  </div>
</section>

<script>
    document.addEventListener('turbo:load', function() {
        // Form progress tracker
        const formInputs = document.querySelectorAll('#registrationForm input');
        const progressBar = document.getElementById('progressBar');
        const totalFields = formInputs.length;

        function updateProgress() {
            const completedFields = Array.from(formInputs).filter(
                input => input.value.trim() !== ''
            ).length;
            const progressPercentage = Math.min(
                100,
                Math.round((completedFields / totalFields) * 100)
            );
            progressBar.style.width = `${progressPercentage}%`;

            // Add glow effect when progress is complete
            if (progressPercentage === 100) {
                progressBar.classList.add('shadow-md', 'shadow-pink-500/50');
            } else {
                progressBar.classList.remove('shadow-md', 'shadow-pink-500/50');
            }
        }

        formInputs.forEach(input => {
            input.addEventListener('input', updateProgress);

            // Add focus effects
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('ring-1', 'ring-purple-500/50');
            });
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('ring-1', 'ring-purple-500/50');
            });
        });

        // Initialize progress
        updateProgress();
    });
</script>
