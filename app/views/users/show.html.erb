<!-- Player Profile Header -->
<section class="bg-gradient-to-r from-blue-700 to-blue-800 text-white py-10 px-4 md:px-6">
  <div class="container mx-auto">
    <div class="flex flex-col md:flex-row items-center md:items-start">
      <!-- Player Avatar -->
      <div class="w-32 h-32 rounded-full bg-white flex items-center justify-center mb-6 md:mb-0 md:mr-8 shadow-lg border-4 border-white overflow-hidden">
        <i class="fas fa-user text-5xl text-blue-700"></i>
      </div>

      <!-- Player Info -->
      <div class="text-center md:text-left flex-grow">
        <h1 class="text-3xl md:text-4xl font-bold mb-2">John Smith</h1>
        <div class="flex flex-wrap justify-center md:justify-start items-center mb-4">
          <span class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-semibold mr-3 mb-2">
            <i class="fas fa-certificate mr-1"></i> Blue Belt
          </span>
          <span class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-semibold mr-3 mb-2">
            <i class="fas fa-medal mr-1"></i> Rank: #2
          </span>
          <span class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-semibold mr-3 mb-2">
            <i class="fas fa-chart-line mr-1"></i> Elo: 1856
          </span>
        </div>
        <p class="text-blue-100 max-w-xl">
          Member since June 2023 • NYC BJJ Academy • 45 matches
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="mt-6 md:mt-0 flex flex-col md:flex-row md:items-start space-y-3 md:space-y-0 md:space-x-3">
        <%= link_to new_match_path, class: "bg-white text-blue-700 hover:bg-blue-50 py-2 px-4 rounded-lg font-medium transition duration-300" do %>
          <i class="fas fa-gamepad mr-2"></i> Log a Match
        <% end %>

        <%= link_to "#", class: "bg-transparent text-white border border-white hover:bg-blue-600 py-2 px-4 rounded-lg font-medium transition duration-300" do %>
          <i class="fas fa-edit mr-2"></i> Edit Profile
        <% end %>
      </div>
    </div>
  </div>

  <!-- Wave Divider -->
  <div class="w-full mt-10">
    <div class="relative h-20 overflow-hidden">
      <div class="absolute bottom-0 w-full">
        <i class="fas fa-water text-gray-50 text-8xl w-full" style="display: block;"></i>
      </div>
    </div>
  </div>
</section>

<!-- Stats Cards Section -->
<section class="py-10 bg-gray-50">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Win/Loss Record -->
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-gray-800">Win/Loss Record</h3>
          <i class="fas fa-trophy text-blue-600 text-2xl"></i>
        </div>
        <div class="flex justify-between items-center mb-4">
          <div class="text-center">
            <div class="text-3xl font-bold text-green-600">32</div>
            <div class="text-sm text-gray-500">Wins</div>
          </div>
          <div class="h-16 w-0.5 bg-gray-200"></div>
          <div class="text-center">
            <div class="text-3xl font-bold text-red-600">13</div>
            <div class="text-sm text-gray-500">Losses</div>
          </div>
          <div class="h-16 w-0.5 bg-gray-200"></div>
          <div class="text-center">
            <div class="text-3xl font-bold text-blue-600">71%</div>
            <div class="text-sm text-gray-500">Win Rate</div>
          </div>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-3">
          <div class="bg-blue-600 h-3 rounded-full" style="width: 71%"></div>
        </div>
      </div>

      <!-- Elo History -->
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-gray-800">Elo History</h3>
          <i class="fas fa-chart-line text-blue-600 text-2xl"></i>
        </div>
        <div class="flex flex-col space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Starting Elo:</span>
            <span class="font-semibold">1500</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Current Elo:</span>
            <span class="font-semibold">1856</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Highest Elo:</span>
            <span class="font-semibold">1892</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Gain/Loss (30 days):</span>
            <span class="font-semibold text-green-600">+42</span>
          </div>
        </div>
      </div>

      <!-- Gym Rankings -->
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-gray-800">Gym Rankings</h3>
          <i class="fas fa-medal text-blue-600 text-2xl"></i>
        </div>
        <div class="space-y-4">
          <div class="flex items-center p-2 bg-blue-50 rounded-lg">
            <div class="bg-blue-700 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">2</div>
            <div class="ml-3">
              <div class="font-medium">NYC BJJ Academy</div>
              <div class="text-sm text-gray-500">Rank #2 of 48 members</div>
            </div>
            <div class="ml-auto font-bold text-blue-700">1856</div>
          </div>
          <div class="flex items-center p-2 bg-gray-50 rounded-lg">
            <div class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">5</div>
            <div class="ml-3">
              <div class="font-medium">Ronin BJJ</div>
              <div class="text-sm text-gray-500">Rank #5 of 32 members</div>
            </div>
            <div class="ml-auto font-bold text-blue-700">1780</div>
          </div>
          <div class="flex items-center p-2 bg-gray-50 rounded-lg">
            <div class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">1</div>
            <div class="ml-3">
              <div class="font-medium">Gracie NYC</div>
              <div class="text-sm text-gray-500">Rank #1 of 15 members</div>
            </div>
            <div class="ml-auto font-bold text-blue-700">1820</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

