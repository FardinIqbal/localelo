<div class="relative min-h-screen bg-slate-900 text-white">
  <!-- Decorative Background Elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-6">
    <!-- Profile Header -->
    <div class="mb-8">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
        <!-- Profile Icon/Initial -->
        <div class="w-24 h-24 md:w-32 md:h-32 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-4xl md:text-5xl font-bold shadow-lg shadow-purple-500/20">
          <%= @user.username ? @user.username[0].upcase : 'U' %>
        </div>

        <!-- User Info -->
        <div>
          <h1 class="font-extrabold text-3xl md:text-4xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
            <%= @user.first_name %> <%= @user.last_name %>
          </h1>
          <p class="text-slate-400 mt-1">@<%= @user.username %></p>
          <div class="flex items-center mt-2 text-slate-400 text-sm">
            <i class="fas fa-envelope mr-2"></i>
            <%= @user.email %>
          </div>

          <!-- Action Buttons -->
          <div class="mt-4 flex flex-wrap gap-3">
            <% if current_user == @user %>
              <%= link_to edit_user_path(@user), class: "px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white font-medium hover:bg-slate-700 transition-all transform hover:-translate-y-0.5" do %>
                <i class="fas fa-edit mr-2"></i> Edit Profile
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Organizations</div>
        <div class="text-2xl font-bold text-white mt-1"><%= @user.organizations.count %></div>
        <div class="mt-2 text-xs text-purple-400">
          <i class="fas fa-users mr-1"></i> Member
        </div>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Leaderboards</div>
        <div class="text-2xl font-bold text-white mt-1"><%= @user.leaderboard_ratings.count %></div>
        <div class="mt-2 text-xs text-pink-400">
          <i class="fas fa-chart-line mr-1"></i> Active
        </div>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Total Matches</div>
        <div class="text-2xl font-bold text-white mt-1"><%= @user.matches.count %></div>
        <div class="mt-2 text-xs text-purple-400">
          <i class="fas fa-trophy mr-1"></i> All time
        </div>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Win Rate</div>
        <% total_matches = @user.matches.count %>
        <% wins = Match.where(winner_id: @user.id).count %>
        <% win_rate = total_matches > 0 ? (wins.to_f / total_matches * 100).round : 0 %>
        <div class="text-2xl font-bold text-white mt-1"><%= win_rate %>%</div>
        <div class="mt-2 text-xs text-pink-400">
          <i class="fas fa-percentage mr-1"></i> Success rate
        </div>
      </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 mb-6 overflow-hidden">
      <div class="flex overflow-x-auto scrollbar-hide">
        <button class="tab-button flex-1 py-4 px-4 text-center border-b-2 border-purple-500 font-medium text-purple-400" data-target="overview">
          <i class="fas fa-home mr-2"></i> Overview
        </button>
        <button class="tab-button flex-1 py-4 px-4 text-center border-b-2 border-transparent font-medium text-slate-400 hover:text-white transition-colors" data-target="organizations">
          <i class="fas fa-users mr-2"></i> Organizations
        </button>
        <button class="tab-button flex-1 py-4 px-4 text-center border-b-2 border-transparent font-medium text-slate-400 hover:text-white transition-colors" data-target="leaderboards">
          <i class="fas fa-trophy mr-2"></i> Leaderboards
        </button>
        <button class="tab-button flex-1 py-4 px-4 text-center border-b-2 border-transparent font-medium text-slate-400 hover:text-white transition-colors" data-target="matches">
          <i class="fas fa-gamepad mr-2"></i> Matches
        </button>
      </div>
    </div>

    <!-- Tab Content: Overview -->
    <div class="tab-content" id="overview">
      <!-- ELO History Chart -->
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden mb-6">
        <div class="flex justify-between items-center p-4 border-b border-slate-700">
          <h2 class="text-xl font-bold text-white">Elo History</h2>
          <div class="flex space-x-2">
            <button class="text-xs px-2 py-1 rounded bg-purple-500 text-white" data-period="30">30 Days</button>
            <button class="text-xs px-2 py-1 rounded bg-slate-700 text-slate-300 hover:bg-slate-600" data-period="90">90
              Days
            </button>
            <button class="text-xs px-2 py-1 rounded bg-slate-700 text-slate-300 hover:bg-slate-600" data-period="all">All
              Time
            </button>
          </div>
        </div>
        <div class="p-4 h-64">
          <% if @elo_history && @elo_history.any? %>
            <div class="relative h-full" id="elo-chart">
              <!-- Chart will be rendered here with JavaScript -->
              <div class="absolute inset-0 flex items-center justify-center text-slate-500">
                <i class="fas fa-chart-line text-4xl"></i>
              </div>
            </div>
          <% else %>
            <div class="h-full flex flex-col items-center justify-center text-slate-500">
              <i class="fas fa-chart-line text-4xl mb-3"></i>
              <p class="text-slate-400">Play matches to see Elo history</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Recent Matches -->
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden mb-6">
        <div class="flex justify-between items-center p-4 border-b border-slate-700">
          <h2 class="text-xl font-bold text-white">Recent Matches</h2>
          <%= link_to matches_path, class: "text-purple-400 text-sm hover:text-pink-400 transition-colors" do %>
            View All <i class="fas fa-arrow-right ml-1"></i>
          <% end %>
        </div>

        <% recent_matches = @user.matches.order(created_at: :desc).limit(5) %>
        <% if recent_matches.any? %>
          <div class="divide-y divide-slate-700">
            <% recent_matches.each do |match| %>
              <% opponent = (match.user1_id == @user.id ? match.opponent : match.user1) %>
              <div class="p-4 hover:bg-slate-700/50 transition-colors">
                <div class="flex justify-between items-center">
                  <div class="flex items-center">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold">
                      <%= opponent.username[0..1].upcase %>
                    </div>
                    <div class="ml-3">
                      <div class="text-white font-medium"><%= opponent.username %></div>
                      <div class="text-xs text-slate-400 mt-0.5">
                        <%= match.leaderboard.organization.name %> • <%= match.created_at.strftime("%b %d, %Y") %>
                      </div>
                    </div>
                  </div>

                  <div class="flex items-center">
                    <% if match.is_draw %>
                      <span class="text-yellow-400 font-medium">Draw</span>
                    <% elsif match.winner_id == @user.id %>
                      <span class="text-green-400 font-medium">Won</span>
                    <% else %>
                      <span class="text-red-400 font-medium">Lost</span>
                    <% end %>

                    <div class="ml-3 px-2 py-1 rounded-md text-xs font-medium <%= match.elo_change && match.elo_change > 0 ? 'bg-green-400/20 text-green-400' : 'bg-red-400/20 text-red-400' %>">
                      <%= match.elo_change ? (match.elo_change > 0 ? "+#{match.elo_change}" : match.elo_change) : "0" %>
                      Elo
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-12 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700 text-slate-500 mb-4">
              <i class="fas fa-trophy text-2xl"></i>
            </div>
            <p class="text-slate-400 mb-4">No matches played yet</p>
            <%= link_to new_match_path, class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
              <i class="fas fa-plus mr-2"></i> Log Your First Match
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tab Content: Organizations -->
    <div class="tab-content hidden" id="organizations">
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
        <div class="flex justify-between items-center p-4 border-b border-slate-700">
          <h2 class="text-xl font-bold text-white">Organizations</h2>
        </div>

        <% if @user.organizations.any? %>
          <div class="divide-y divide-slate-700">
            <% @user.organizations.each do |org| %>
              <% profile = @user.profile_for(org) %>
              <div class="p-4 hover:bg-slate-700/50 transition-colors">
                <div class="flex items-center">
                  <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold">
                    <%= org.name[0..1].upcase %>
                  </div>
                  <div class="ml-3">
                    <div class="flex items-center">
                      <%= link_to org.name, organization_path(org), class: "text-white font-medium hover:text-purple-400 transition-colors" %>

                      <% if org.visibility == 0 %>
                        <span class="ml-2 text-xs px-1.5 py-0.5 rounded bg-green-400/20 text-green-400">Public</span>
                      <% elsif org.visibility == 1 %>
                        <span class="ml-2 text-xs px-1.5 py-0.5 rounded bg-yellow-400/20 text-yellow-400">Private</span>
                      <% end %>

                      <% if org.user_id == @user.id %>
                        <span class="ml-2 text-xs px-1.5 py-0.5 rounded bg-purple-400/20 text-purple-400">Owner</span>
                      <% end %>
                    </div>

                    <div class="text-xs text-slate-400 mt-1">
                      <%= pluralize(org.users.count, 'member') %>
                      <% if org.location.present? %>
                        • <%= org.location %>
                      <% end %>
                    </div>
                  </div>
                </div>

                <% if org.leaderboards.any? %>
                  <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <% org.leaderboards.first(4).each do |leaderboard| %>
                      <% user_rating = profile ? leaderboard.leaderboard_ratings.find_by(profile: profile) : nil %>
                      <div class="flex justify-between items-center p-2 rounded bg-slate-700/50">
                        <span class="text-sm text-slate-300"><%= leaderboard.name %></span>
                        <span class="text-sm font-medium text-purple-400"><%= user_rating&.rating || 1500 %> Elo</span>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="mt-3 text-sm text-slate-500">No leaderboards yet</div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-12 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700 text-slate-500 mb-4">
              <i class="fas fa-building text-2xl"></i>
            </div>
            <p class="text-slate-400 mb-4">Not a member of any organizations yet</p>
            <%= link_to organizations_path, class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
              <i class="fas fa-users mr-2"></i> Find Organizations
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tab Content: Leaderboards -->
    <div class="tab-content hidden" id="leaderboards">
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
        <div class="flex justify-between items-center p-4 border-b border-slate-700">
          <h2 class="text-xl font-bold text-white">Leaderboards</h2>
        </div>

        <% if @user.leaderboard_ratings.any? %>
          <div class="divide-y divide-slate-700">
            <% @user.leaderboard_ratings.includes(:leaderboard).each do |rating| %>
              <div class="p-4 hover:bg-slate-700/50 transition-colors">
                <div class="flex justify-between items-center">
                  <div>
                    <div class="text-white font-medium"><%= rating.leaderboard.name %></div>
                    <div class="text-xs text-slate-400 mt-0.5"><%= rating.leaderboard.organization.name %></div>
                  </div>

                  <div class="flex items-center">
                    <div class="text-lg font-bold text-purple-400"><%= rating.rating %></div>
                    <div class="ml-3 px-2 py-1 rounded-md text-xs font-medium bg-slate-700 text-slate-300">
                      Rank #<%= rating.leaderboard.leaderboard_ratings.where('rating > ?', rating.rating).count + 1 %>
                    </div>
                  </div>
                </div>
                <div class="mt-2 flex items-center text-sm text-slate-400">
                  <span class="mr-4"><i class="fas fa-trophy text-green-400 mr-1"></i> <%= rating.wins %> wins</span>
                  <span><i class="fas fa-times text-red-400 mr-1"></i> <%= rating.losses %> losses</span>
                </div>

                <!-- Rank information -->
                <div class="mt-3 flex items-center">
  <span class="px-2 py-1 text-xs font-medium rounded-md bg-slate-700 text-slate-300">
    Rank #<%= rating.leaderboard.leaderboard_ratings.where('rating > ?', rating.rating).count + 1 %>
  </span>
                  <% if rating.leaderboard.organization.admin?(current_user) %>
                    <%= link_to organization_leaderboard_path(rating.leaderboard.organization, rating.leaderboard), class: "ml-auto text-xs text-purple-400 hover:text-pink-400 transition-colors" do %>
                      <i class="fas fa-arrow-right ml-1"></i> View Leaderboard
                    <% end %>
                  <% end %>
                </div>
              </div>
              </div>
            <% end %>
            </div>
        <% else %>
          <div class="p-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700 text-slate-500 mb-4">
              <i class="fas fa-trophy text-2xl"></i>
            </div>
            <p class="text-slate-400 mb-4">No leaderboard ratings yet</p>
            <%= link_to organizations_path, class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
              <i class="fas fa-users mr-2"></i> Find Organizations to Join
            <% end %>
          </div>
        <% end %>
        </div>
  </div>

  <!-- Tab Content: Matches -->
  <div class="tab-content hidden" id="matches">
    <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
      <div class="flex justify-between items-center p-4 border-b border-slate-700">
        <h2 class="text-xl font-bold text-white">Match History</h2>
      </div>

      <% user_matches = @user.matches.order(created_at: :desc) %>
      <% if user_matches.any? %>
        <div class="divide-y divide-slate-700">
          <% user_matches.each do |match| %>
            <div class="p-4 hover:bg-slate-700/50 transition-colors">
              <div class="flex justify-between items-center">
                <div class="flex items-center">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold">
                    <% opponent = match.user1_id == @user.id ? match.opponent : match.user1 %>
                    <%= opponent.username[0..1].upcase %>
                  </div>
                  <div class="ml-3">
                    <div class="text-white font-medium">
                      <%= match.user1_id == @user.id ? "You" : match.user1.username %> vs
                      <%= match.opponent_id == @user.id ? "You" : match.opponent.username %>
                    </div>
                    <div class="text-xs text-slate-400 mt-0.5">
                      <%= match.leaderboard.organization.name %> • <%= match.created_at.strftime("%b %d, %Y") %>
                    </div>
                  </div>
                </div>

                <div class="flex items-center">
                  <% if match.is_draw %>
                    <span class="text-yellow-400 font-medium">Draw</span>
                  <% elsif match.winner_id == @user.id %>
                    <span class="text-green-400 font-medium">Won</span>
                  <% else %>
                    <span class="text-red-400 font-medium">Lost</span>
                  <% end %>

                  <% if match.elo_change.present? %>
                    <div class="ml-3 px-2 py-1 rounded-md text-xs font-medium <%= match.elo_change && match.elo_change > 0 ? 'bg-green-400/20 text-green-400' : 'bg-red-400/20 text-red-400' %>">
                      <%= match.elo_change ? (match.elo_change > 0 ? "+#{match.elo_change}" : match.elo_change) : "0" %>
                      Elo
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-12 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700 text-slate-500 mb-4">
            <i class="fas fa-gamepad text-2xl"></i>
          </div>
          <p class="text-slate-400 mb-4">No matches played yet</p>
          <%= link_to new_match_path, class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
            <i class="fas fa-plus mr-2"></i> Log Your First Match
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Tab switching functionality
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabContents = document.querySelectorAll('.tab-content');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Update all tab buttons to inactive
                tabButtons.forEach(btn => {
                    btn.classList.remove('border-purple-500', 'font-medium', 'text-purple-400');
                    btn.classList.add('border-transparent', 'text-slate-400');
                });

                // Make this button active
                button.classList.remove('border-transparent', 'text-slate-400');
                button.classList.add('border-purple-500', 'font-medium', 'text-purple-400');

                // Show the correct tab content and hide others
                const targetId = button.dataset.target;
                tabContents.forEach(content => {
                    content.classList.add('hidden');
                });
                document.getElementById(targetId).classList.remove('hidden');
            });
        });

