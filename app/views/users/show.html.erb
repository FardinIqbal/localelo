<!-- USER PROFILE HEADER - Enhanced with gradient animation -->
<section class="bg-gradient-to-r from-indigo-600 to-purple-700 text-white py-16 px-4 md:px-6 relative overflow-hidden transform transition-all duration-500 hover:shadow-2xl">
  <!-- Animated background particles -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="particles-container opacity-20"></div>
  </div>

  <div class="container mx-auto relative z-10">
    <div class="text-center transform transition-all duration-500 hover:scale-105">
      <div class="inline-block mb-4 p-2 rounded-full bg-white/10 backdrop-blur-sm">
        <div class="w-24 h-24 md:w-32 md:h-32 rounded-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-3xl font-bold border-4 border-white/30">
          <%= @user.full_name.first %>
        </div>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-2 tracking-tight"><%= @user.full_name %></h1>
      <p class="text-indigo-200 inline-block px-4 py-1 rounded-full bg-white/10 backdrop-blur-sm">
        <span class="mr-2">✦</span> Member since <%= @user.created_at.strftime("%B %Y") %> <span class="ml-2">✦</span>
      </p>
    </div>
  </div>
</section>

<!-- OVERALL PERFORMANCE SECTION - Glass morphism design -->
<section class="py-16 bg-gradient-to-b from-slate-100 to-white relative">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="text-3xl font-bold text-gray-800 mb-8 relative inline-block">
      Overall Performance
      <div class="h-1 w-1/2 bg-indigo-500 absolute bottom-0 left-0 rounded-full"></div>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- GLOBAL STATS CARD -->
      <div class="bg-white/80 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-white/50 transform transition-all duration-300 hover:translate-y-[-5px] hover:shadow-2xl">
        <div class="flex items-center mb-6">
          <div class="p-3 rounded-xl bg-indigo-100 text-indigo-600 mr-3">
            <i class="fas fa-chart-pie text-xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-gray-800">Global Stats</h3>
        </div>
        <div class="space-y-4 text-gray-700">
          <div class="flex justify-between items-center group">
            <p class="font-medium">Total Matches</p>
            <p class="font-bold text-indigo-600 group-hover:scale-110 transition-all"><%= @total_matches %></p>
          </div>
          <div class="flex justify-between items-center group">
            <p class="font-medium">Wins</p>
            <p class="font-bold text-green-600 group-hover:scale-110 transition-all"><%= @win_count %></p>
          </div>
          <div class="flex justify-between items-center group">
            <p class="font-medium">Losses</p>
            <p class="font-bold text-red-500 group-hover:scale-110 transition-all"><%= @loss_count %></p>
          </div>
          <div class="flex justify-between items-center group">
            <p class="font-medium">Win Rate</p>
            <p class="font-bold text-indigo-600 group-hover:scale-110 transition-all"><%= @win_rate %>%</p>
          </div>
          <div class="h-1 w-full bg-gray-100 rounded-full my-2">
            <div class="h-1 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full" style="width: <%= @win_rate %>%"></div>
          </div>
          <div class="flex justify-between items-center group">
            <p class="font-medium">Highest Elo</p>
            <p class="font-bold text-amber-500 group-hover:scale-110 transition-all"><%= @elo_highest %></p>
          </div>
          <div class="flex justify-between items-center group">
            <p class="font-medium">30-Day Elo Gain</p>
            <p class="font-bold <%= @elo_gain_last_30_days >= 0 ? 'text-green-600' : 'text-red-500' %> group-hover:scale-110 transition-all">
              <%= @elo_gain_last_30_days %>
            </p>
          </div>
        </div>
      </div>

      <!-- ANALYTICS CARD -->
      <div class="bg-white/80 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-white/50 transform transition-all duration-300 hover:translate-y-[-5px] hover:shadow-2xl">
        <div class="flex items-center mb-6">
          <div class="p-3 rounded-xl bg-purple-100 text-purple-600 mr-3">
            <i class="fas fa-brain text-xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-gray-800">Analytics</h3>
        </div>
        <div class="space-y-6 text-gray-700">
          <div>
            <p class="font-medium mb-2">Most Used Submission</p>
            <div class="p-3 rounded-xl bg-gradient-to-r from-purple-50 to-indigo-50 border border-indigo-100 group transition-all duration-300 hover:shadow-md">
              <p class="font-bold text-indigo-700 group-hover:text-purple-700 transition-all">
                <%= @most_used_submission %>
              </p>
            </div>
          </div>
          <div>
            <p class="font-medium mb-2">Top Rival</p>
            <div class="p-3 rounded-xl bg-gradient-to-r from-indigo-50 to-purple-50 border border-purple-100 group transition-all duration-300 hover:shadow-md">
              <p class="font-bold text-purple-700 group-hover:text-indigo-700 transition-all">
                <%= @top_rival[:opponent] %>
              </p>
              <p class="text-sm text-gray-500 mt-1">
                <%= @top_rival[:matches_played] %> matches played
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- RECENT PERFORMANCE CARD -->
      <div class="bg-white/80 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-white/50 transform transition-all duration-300 hover:translate-y-[-5px] hover:shadow-2xl">
        <div class="flex items-center mb-6">
          <div class="p-3 rounded-xl bg-blue-100 text-blue-600 mr-3">
            <i class="fas fa-bolt text-xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-gray-800">Recent Performance</h3>
        </div>
        <div class="space-y-6 text-gray-700">
          <div>
            <p class="font-medium mb-2">Current Streak</p>
            <div class="p-3 rounded-xl bg-gradient-to-r from-blue-50 to-green-50 border border-blue-100 group transition-all duration-300 hover:shadow-md">
              <p class="font-bold text-blue-700 group-hover:text-green-700 transition-all">
                2 Wins (Example)
              </p>
            </div>
          </div>
          <div>
            <p class="font-medium mb-2">Last 5 Matches</p>
            <div class="flex justify-between mt-3">
              <div class="w-12 h-12 rounded-full bg-green-500 text-white flex items-center justify-center transform transition hover:scale-110">W</div>
              <div class="w-12 h-12 rounded-full bg-red-500 text-white flex items-center justify-center transform transition hover:scale-110">L</div>
              <div class="w-12 h-12 rounded-full bg-green-500 text-white flex items-center justify-center transform transition hover:scale-110">W</div>
              <div class="w-12 h-12 rounded-full bg-green-500 text-white flex items-center justify-center transform transition hover:scale-110">W</div>
              <div class="w-12 h-12 rounded-full bg-red-500 text-white flex items-center justify-center transform transition hover:scale-110">L</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- GYM MEMBERSHIPS SECTION - Card hover effects -->
<section class="py-16 bg-gradient-to-b from-slate-50 to-indigo-50 relative">
  <div class="absolute top-0 right-0 w-full h-32 bg-gradient-to-b from-white to-transparent"></div>
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <h2 class="text-3xl font-bold text-gray-800 mb-8 relative inline-block">
      Your Gyms
      <div class="h-1 w-1/2 bg-indigo-500 absolute bottom-0 left-0 rounded-full"></div>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @gym_stats.each do |stats| %>
        <div class="bg-white rounded-2xl shadow-xl p-8 relative overflow-hidden transform transition-all duration-300 hover:translate-y-[-8px] hover:shadow-2xl border border-indigo-50 group">
          <!-- Background accent -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-indigo-500/10 to-transparent rounded-bl-full transform transition-all duration-500 group-hover:scale-125"></div>

          <!-- GYM NAME -->
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <span class="inline-block w-8 h-8 mr-2 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center">
              <i class="fas fa-dumbbell"></i>
            </span>
            <%= stats[:gym].name %>
          </h3>

          <!-- GYM STATS -->
          <div class="mb-8 space-y-3 text-gray-700">
            <div class="flex items-center group/item transition-all duration-300 hover:pl-2">
              <i class="fas fa-medal text-amber-500 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
              <div>
                <p class="text-sm text-gray-500">Rank</p>
                <p class="font-bold">#<%= stats[:rank] %></p>
              </div>
            </div>

            <div class="flex items-center group/item transition-all duration-300 hover:pl-2">
              <i class="fas fa-chart-line text-blue-600 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
              <div>
                <p class="text-sm text-gray-500">Elo</p>
                <p class="font-bold text-blue-700"><%= stats[:elo] %></p>
              </div>
            </div>

            <div class="flex items-center group/item transition-all duration-300 hover:pl-2">
              <i class="fas fa-trophy text-green-600 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
              <div>
                <p class="text-sm text-gray-500">Wins</p>
                <p class="font-bold text-green-700"><%= stats[:wins] %></p>
              </div>
            </div>

            <div class="flex items-center group/item transition-all duration-300 hover:pl-2">
              <i class="fas fa-times-circle text-red-500 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
              <div>
                <p class="text-sm text-gray-500">Losses</p>
                <p class="font-bold text-red-600"><%= stats[:losses] %></p>
              </div>
            </div>

            <div class="flex items-center group/item transition-all duration-300 hover:pl-2">
              <i class="fas fa-percentage text-blue-600 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
              <div>
                <p class="text-sm text-gray-500">Win Rate</p>
                <p class="font-bold text-blue-700"><%= stats[:win_rate] %>%</p>
              </div>
            </div>

            <!-- Progress bar for win rate -->
            <div class="h-2 w-full bg-gray-100 rounded-full my-2">
              <div class="h-2 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full transform transition-all duration-500" style="width: <%= stats[:win_rate] %>%"></div>
            </div>

            <% if stats[:most_faced_opponent].present? && stats[:most_faced_opponent] != "None" %>
              <div class="flex items-center group/item transition-all duration-300 hover:pl-2 mt-4">
                <i class="fas fa-user-friends text-purple-600 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
                <div>
                  <p class="text-sm text-gray-500">Rival in This Gym</p>
                  <p class="font-bold text-purple-700">
                    <%= stats[:most_faced_opponent] %>
                    <span class="text-sm font-normal text-gray-500">(<%= stats[:matches_against_rival] %> matches)</span>
                  </p>
                </div>
              </div>
            <% end %>

            <div class="flex items-center group/item transition-all duration-300 hover:pl-2 mt-4">
              <i class="fas fa-calendar-alt text-indigo-600 mr-3 text-lg group-hover/item:scale-110 transition-all"></i>
              <div>
                <p class="text-sm text-gray-500">Joined</p>
                <p class="font-bold text-indigo-700"><%= stats[:join_date] %></p>
              </div>
            </div>
          </div>

          <!-- GYM LINK BUTTON -->
          <%= link_to gym_path(stats[:gym]), class: "inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl font-semibold text-sm transition-all duration-300 hover:from-indigo-700 hover:to-purple-700 hover:shadow-lg hover:shadow-indigo-200 transform hover:-translate-y-1 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 focus:outline-none" do %>
            <span>Visit Gym</span>
            <i class="fas fa-arrow-right ml-2 transition-transform duration-300 group-hover:translate-x-1"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- RECENT MATCHES SECTION - Interactive Table -->
<section class="py-16 bg-white relative">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="text-3xl font-bold text-gray-800 mb-8 relative inline-block">
      Recent Matches
      <div class="h-1 w-1/2 bg-indigo-500 absolute bottom-0 left-0 rounded-full"></div>
    </h2>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-indigo-50">
      <table class="w-full">
        <thead>
        <tr class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white">
          <th class="py-4 px-6 text-left font-semibold">Date</th>
          <th class="py-4 px-6 text-left font-semibold">Opponent</th>
          <th class="py-4 px-6 text-left font-semibold">Result</th>
          <th class="py-4 px-6 text-left font-semibold">Elo Change</th>
        </tr>
        </thead>
        <tbody>
        <% @matches.each_with_index do |match, index| %>
          <tr class="border-b border-gray-100 transform transition-all duration-200 hover:bg-indigo-50/50 <%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>">
            <td class="py-4 px-6 text-gray-700"><%= match.match_time.strftime("%b %d, %Y") %></td>
            <td class="py-4 px-6">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center mr-3">
                  <%= match.opponent_for(@user)&.full_name&.first || "?" %>
                </div>
                <span class="font-medium text-gray-800"><%= match.opponent_for(@user)&.full_name || "Unknown" %></span>
              </div>
            </td>
            <td class="py-4 px-6">
              <% if match.winner_id == @user.id %>
                <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 font-medium inline-flex items-center">
                  <i class="fas fa-check-circle mr-1"></i> WIN
                </span>
              <% elsif match.winner_id.nil? %>
                <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 font-medium inline-flex items-center">
                  <i class="fas fa-equals mr-1"></i> DRAW
                </span>
              <% else %>
                <span class="px-3 py-1 rounded-full bg-red-100 text-red-800 font-medium inline-flex items-center">
                  <i class="fas fa-times-circle mr-1"></i> LOSS
                </span>
              <% end %>
            </td>
            <td class="py-4 px-6">
              <% if match.elo_change.to_i > 0 %>
                <span class="font-medium text-green-600 inline-flex items-center">
                  <i class="fas fa-arrow-up mr-1"></i> +<%= match.elo_change || "N/A" %>
                </span>
              <% elsif match.elo_change.to_i < 0 %>
                <span class="font-medium text-red-600 inline-flex items-center">
                  <i class="fas fa-arrow-down mr-1"></i> <%= match.elo_change || "N/A" %>
                </span>
              <% else %>
                <span class="font-medium text-gray-600"><%= match.elo_change || "N/A" %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Add CSS for animations -->
<style>
    /* Animated background particles */
    .particles-container {
        position: absolute;
        width: 100%;
        height: 100%;
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        background-size: 20px 20px;
        animation: particleAnimation 20s linear infinite;
    }

    @keyframes particleAnimation {
        0% {
            background-position: 0 0;
        }
        100% {
            background-position: 50px 50px;
        }
    }

    /* Add subtle animations when page loads */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    section {
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: calc(var(--section-index, 0) * 0.2s);
    }

    /* Add animation and transition classes */
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }
</style>

<!-- Add JavaScript for staggered animations -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Add section indices for staggered animations
        const sections = document.querySelectorAll('section');
        sections.forEach((section, index) => {
            section.style.setProperty('--section-index', index);
        });

        // Add intersection observer for elements to animate when they come into view
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-in');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.1
        });

        const animatedElements = document.querySelectorAll('.animate-on-scroll');
        animatedElements.forEach(el => {
            observer.observe(el);
        });
    });
</script>