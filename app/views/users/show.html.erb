        //     labels: labels,
        //     datasets: [{
        //       label: 'Elo Rating',
        //       data: data,
        //       borderColor: '#a855f7',
        //       backgroundColor: 'rgba(168, 85, 247, 0.1)',
        //       tension: 0.3,
        //       fill: true
        //     }]
        //   },
        //   options: {
        //     responsive: true,
        //     maintainAspectRatio: false,
        //     plugins: {
        //       legend: {
        //         display: false
        //       }
        //     },
        //     scales: {
        //       y: {
        //         grid: {
        //           color: 'rgba(255, 255, 255, 0.1)'
        //         },
        //         ticks: {
        //           color: '#94a3b8'
        //         }
        //       },
        //       x: {
