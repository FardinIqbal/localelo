<!-- Performance Stats Section -->
<section class="py-10 bg-gray-50">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-8">
      <i class="fas fa-chart-pie text-blue-600 mr-2"></i> Performance Statistics
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Performance Card 1 -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Match Outcomes</h3>
        <div class="flex justify-around">
          <div class="text-center">
            <div class="w-24 h-24 flex items-center justify-center mx-auto">
              <i class="fas fa-thumbs-up text-5xl text-green-500"></i>
            </div>
            <div class="mt-2 text-2xl font-bold text-gray-800">71%</div>
            <div class="text-sm text-gray-500">Win Rate</div>
          </div>
          <div class="text-center">
            <div class="w-24 h-24 flex items-center justify-center mx-auto">
              <i class="fas fa-thumbs-down text-5xl text-red-500"></i>
            </div>
            <div class="mt-2 text-2xl font-bold text-gray-800">29%</div>
            <div class="text-sm text-gray-500">Loss Rate</div>
          </div>
        </div>
      </div>

      <!-- Performance Card 2 -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Performance</h3>
        <div class="flex justify-between items-center">
          <span class="text-gray-600">Last 5 matches:</span>
          <div class="flex space-x-2">
            <span class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center text-white text-xs">W</span>
            <span class="w-6 h-6 bg-red-500 rounded-full flex items-center justify-center text-white text-xs">L</span>
            <span class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center text-white text-xs">W</span>
            <span class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center text-white text-xs">W</span>
            <span class="w-6 h-6 bg-red-500 rounded-full flex items-center justify-center text-white text-xs">L</span>
          </div>
        </div>
        <div class="mt-4 space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Win streak (best):</span>
            <span class="font-semibold">7 matches</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Current streak:</span>
            <span class="font-semibold text-green-600">Win - 1 match</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Monthly win rate:</span>
            <span class="font-semibold">75% (9/12)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Quick Actions Section -->
<section class="py-10 bg-white">
  <div class="container mx-auto px-4 md:px-6 text-center">
    <h2 class="text-2xl font-bold text-gray-800 mb-8">
      <i class="fas fa-bolt text-blue-600 mr-2"></i> Quick Actions
    </h2>

    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to "#", class: "bg-blue-600 hover:bg-blue-700 text-white py-3 px-6 rounded-lg font-medium transition duration-300 flex items-center" do %>
        <i class="fas fa-gamepad mr-2"></i> Log a New Match
      <% end %>

      <%= link_to "#", class: "bg-purple-600 hover:bg-purple-700 text-white py-3 px-6 rounded-lg font-medium transition duration-300 flex items-center" do %>
        <i class="fas fa-trophy mr-2"></i> View Leaderboard
      <% end %>

      <%= link_to "#", class: "bg-green-600 hover:bg-green-700 text-white py-3 px-6 rounded-lg font-medium transition duration-300 flex items-center" do %>
        <i class="fas fa-users mr-2"></i> Find Opponents
      <% end %>

      <%= link_to "#", class: "bg-gray-600 hover:bg-gray-700 text-white py-3 px-6 rounded-lg font-medium transition duration-300 flex items-center" do %>
        <i class="fas fa-info-circle mr-2"></i> How Elo Works
      <% end %>
    </div>
  </div>
</section>