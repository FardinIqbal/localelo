<%= form_with(model: @leaderboard, url: organization_leaderboards_path(@organization), local: true, class: "space-y-4") do |form| %>
  <%= form.hidden_field :organization_slug, value: @organization.slug %> <!-- This is the fix -->

  <div>
    <%= form.label :name, "Leaderboard Name", class: "block font-semibold" %>
    <%= form.text_field :name, class: "border p-2 w-full rounded-md", required: true %>
  </div>

  <div>
    <%= form.label :sport_type_id, "Sport Type", class: "block font-semibold" %>
    <%= form.collection_select :sport_type_id, SportType.all, :id, :name, prompt: "Select a sport type", class: "border p-2 w-full rounded-md" %>
  </div>

  <div>
    <%= form.submit "Create Leaderboard", class: "bg-blue-500 text-white px-4 py-2 mt-4 rounded-md hover:bg-blue-600" %>
  </div>
<% end %>
