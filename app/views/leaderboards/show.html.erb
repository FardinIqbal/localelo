<div class="relative min-h-screen">
  <!-- Decorative Background Elements -->
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0" style="animation-delay: 1.5s;"></div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-6">
    <!-- Page Header with Organization Context -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
      <div>
        <div class="flex items-center mb-2">
          <%= link_to organization_path(@organization), class: "text-slate-400 hover:text-purple-400 transition-colors mr-2" do %>
            <i class="fas fa-arrow-left mr-1"></i> <%= @organization.name %>
          <% end %>
          <span class="text-slate-500 mx-2">/</span>
          <h1 class="font-extrabold text-3xl md:text-4xl bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
            <%= @leaderboard.name %>
          </h1>
        </div>
        <% if @leaderboard.description.present? %>
          <p class="text-slate-400 mt-1 max-w-3xl">
            <%= @leaderboard.description %>
          </p>
        <% end %>
      </div>

      <!-- Action Buttons -->
      <% if @organization.admin?(current_user) %>
        <div class="mt-4 md:mt-0 flex space-x-3">
          <%= link_to edit_organization_leaderboard_path(@organization, @leaderboard), class: "px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white font-medium hover:bg-slate-700 transition-all transform hover:-translate-y-0.5" do %>
            <i class="fas fa-edit mr-2"></i> Edit
          <% end %>

          <%= link_to organization_leaderboard_path(@organization, @leaderboard),
                      method: :delete,
                      data: { confirm: "Are you sure you want to delete this leaderboard? This will remove all ratings and match history." },
                      class: "px-4 py-2 rounded-lg bg-red-900/50 border border-red-800/50 text-red-300 font-medium hover:bg-red-800/50 transition-all transform hover:-translate-y-0.5" do %>
            <i class="fas fa-trash-alt mr-2"></i> Delete
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Total Players</div>
        <div class="text-2xl font-bold text-white mt-1"><%= @leaderboard.leaderboard_ratings.count %></div>
        <div class="mt-2 text-xs text-purple-400">
          <i class="fas fa-users mr-1"></i> Active participants
        </div>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Matches Played</div>
        <% match_count = Match.where(leaderboard_id: @leaderboard.id).count %>
        <div class="text-2xl font-bold text-white mt-1"><%= match_count %></div>
        <div class="mt-2 text-xs text-pink-400">
          <i class="fas fa-gamepad mr-1"></i> Total competitions
        </div>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Average Rating</div>
        <% avg = @leaderboard.leaderboard_ratings.average(:rating)&.round || 1500 %>
        <div class="text-2xl font-bold text-white mt-1"><%= avg %></div>
        <div class="mt-2 text-xs text-purple-400">
          <i class="fas fa-chart-line mr-1"></i> Mean Elo
        </div>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Top Rating</div>
        <% top = @leaderboard.leaderboard_ratings.maximum(:rating) || 1500 %>
        <div class="text-2xl font-bold text-white mt-1"><%= top %></div>
        <div class="mt-2 text-xs text-pink-400">
          <i class="fas fa-trophy mr-1"></i> Highest Elo
        </div>
      </div>
    </div>

    <!-- Rankings Table -->
    <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
      <div class="flex justify-between items-center p-4 border-b border-slate-700">
        <h2 class="text-xl font-bold text-white">Leaderboard Rankings</h2>

        <% if current_user && @organization.organization_memberships.approved.by_user(current_user.id).exists? %>
          <%= link_to new_match_path(leaderboard_id: @leaderboard.id), class: "text-purple-400 text-sm hover:text-pink-400 transition-colors" do %>
            <i class="fas fa-plus mr-1"></i> Log Match
          <% end %>
        <% end %>
      </div>

      <% if @leaderboard.leaderboard_ratings.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-slate-700/50 text-slate-300 text-sm">
            <tr>
              <th class="p-4 w-16 text-center">#</th>
              <th class="p-4">Player</th>
              <th class="p-4 text-center">Rating</th>
              <th class="p-4 text-center">W</th>
              <th class="p-4 text-center">L</th>
              <th class="p-4 text-center">Win %</th>
              <th class="p-4 text-center">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-slate-700">
            <% @leaderboard.leaderboard_ratings.order(rating: :desc).each_with_index do |rating, index| %>
              <tr class="hover:bg-slate-700/50 transition-colors <%= rating.profile.user == current_user ? 'bg-purple-900/20' : '' %>">
                <td class="p-4 text-center">
                  <% if index < 3 %>
                    <div class="w-8 h-8 rounded-full mx-auto flex items-center justify-center
                                <%= index == 0 ? 'bg-gradient-to-br from-yellow-400 to-yellow-600 text-white' :
                                                                      index == 1 ? 'bg-gradient-to-br from-slate-300 to-slate-500 text-white' :
                                                                        'bg-gradient-to-br from-amber-600 to-amber-800 text-white' %>">
                      <%= index + 1 %>
                    </div>
                  <% else %>
                    <div class="w-8 h-8 rounded-full mx-auto flex items-center justify-center bg-slate-700 text-slate-300">
                      <%= index + 1 %>
                    </div>
                  <% end %>
                </td>
                <td class="p-4">
                  <div class="flex items-center">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold mr-3">
                      <%= rating.profile.username[0..1].upcase %>
                    </div>
                    <div>
                      <div class="font-medium text-white"><%= link_to rating.profile.username, profile_path(rating.profile), class: "hover:text-purple-300 transition-colors" %></div>
                      <div class="text-xs text-slate-400">
                        <% if rating.profile.user == current_user %>
                          <span class="text-purple-400">You</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="p-4 text-center font-bold text-lg text-purple-400"><%= rating.rating %></td>
                <td class="p-4 text-center text-green-400"><%= rating.wins %></td>
                <td class="p-4 text-center text-red-400"><%= rating.losses %></td>
                <td class="p-4 text-center">
                  <% win_percentage = rating.wins + rating.losses > 0 ? (rating.wins.to_f / (rating.wins + rating.losses) * 100).round : 0 %>
                  <span class="px-2 py-1 rounded-md text-xs font-medium bg-slate-700 text-slate-300">
                    <%= win_percentage %>%
                  </span>
                </td>
                <td class="p-4 text-center">
                  <% if current_user && rating.profile.user != current_user && @organization.organization_memberships.approved.by_user(current_user.id).exists? %>
                    <%= link_to new_match_path(opponent_profile_id: rating.profile.id, leaderboard_id: @leaderboard.id), class: "text-purple-400 hover:text-pink-400 transition-colors" do %>
                      <i class="fas fa-gamepad"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-12 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700 text-slate-500 mb-4">
            <i class="fas fa-trophy text-2xl"></i>
          </div>
          <p class="text-slate-400 mb-4">No players in this leaderboard yet</p>
          <% if current_user && @organization.organization_memberships.approved.by_user(current_user.id).exists? %>
            <%= link_to new_match_path(leaderboard_id: @leaderboard.id), class: "px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:shadow-lg hover:shadow-purple-500/20 transition-all" do %>
              <i class="fas fa-plus mr-2"></i> Log First Match
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Recent Matches -->
    <div class="mt-6 bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
      <div class="flex justify-between items-center p-4 border-b border-slate-700">
        <h2 class="text-xl font-bold text-white">Recent Matches</h2>
      </div>

      <% recent_matches = Match.where(leaderboard_id: @leaderboard.id).order(created_at: :desc).limit(5) %>
      <% if recent_matches.any? %>
        <div class="divide-y divide-slate-700">
          <% recent_matches.each do |match| %>
            <div class="p-4 hover:bg-slate-700/50 transition-colors">
              <div class="flex justify-between items-center">
                <div class="flex items-center">
                  <div class="flex items-center space-x-4">
                    <% if match.user1 && match.opponent %>
                      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold">
                        <%= match.user1.username[0..1].upcase %>
                      </div>
                      <div class="text-white font-medium"><%= match.user1.username %></div>
                      <div class="text-slate-400">vs</div>
                      <div class="text-white font-medium"><%= match.opponent.username %></div>
                      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-blue-500 flex items-center justify-center text-white font-bold">
                        <%= match.opponent.username[0..1].upcase %>
                      </div>
                    <% else %>
                      <div class="text-slate-400">Match data incomplete</div>
                    <% end %>
                  </div>
                </div>

                <div class="flex items-center">
                  <% if match.is_draw %>
                    <span class="text-yellow-400 font-medium">Draw</span>
                  <% elsif match.winner %>
                    <span class="text-white font-medium">Winner: </span>
                    <span class="ml-2 font-medium <%= match.winner_id == match.user1_id ? 'text-green-400' : 'text-red-400' %>">
                      <%= match.winner.username %>
                    </span>
                  <% else %>
                    <span class="text-slate-400">No result</span>
                  <% end %>
                  <div class="ml-3 text-xs text-slate-400">
                    <%= match.created_at.strftime("%b %d, %Y") %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center">
          <p class="text-slate-400">No matches have been played yet</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
