<% match_count = Match.where(leaderboard_id: @leaderboard.id).count %>
<% avg_rating = @leaderboard.leaderboard_ratings.average(:rating)&.round || 1500 %>
<% top_rating = @leaderboard.leaderboard_ratings.maximum(:rating)&.round || 1500 %>

<%= render "shared/layouts/page_shell",
           title: @leaderboard.name,
           subtitle: @leaderboard.description.presence || "Track standings and log new results for this leaderboard." do %>
  <div class="space-y-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-2 text-sm text-slate-500">
        <p><i class="fas fa-building mr-1 text-slate-400"></i><%= link_to @organization.name, organization_path(@organization), class: "text-slate-600 hover:text-slate-900" %></p>
        <p><i class="fas fa-users mr-1 text-slate-400"></i><%= @leaderboard.leaderboard_ratings.count %> players</p>
        <p><i class="fas fa-trophy mr-1 text-slate-400"></i><%= match_count %> matches logged</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if @organization.admin?(current_user) %>
          <%= link_to edit_organization_leaderboard_path(@organization, @leaderboard), class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:text-slate-900" do %>
            <i class="fas fa-edit"></i>
            Edit
          <% end %>
          <%= link_to organization_leaderboard_path(@organization, @leaderboard),
                      data: { turbo_method: :delete, turbo_confirm: "Delete this leaderboard? This cannot be undone." },
                      class: "inline-flex items-center gap-2 rounded-xl border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-600 hover:text-rose-700" do %>
            <i class="fas fa-trash"></i>
            Delete
          <% end %>
        <% end %>
        <% if current_user && @organization.organization_memberships.approved.by_user(current_user.id).exists? %>
          <%= link_to new_match_path(leaderboard_id: @leaderboard.id), class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" do %>
            <i class="fas fa-plus"></i>
            Log match
          <% end %>
        <% end %>
      </div>
    </div>

    <section>
      <h2 class="text-lg font-semibold text-slate-900">Stats</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Players</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @leaderboard.leaderboard_ratings.count %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Matches played</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= match_count %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Average rating</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= avg_rating %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Top rating</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= top_rating %></dd>
        </div>
      </dl>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Rankings</h2>
        <p class="text-xs text-slate-500">Sorted by rating.</p>
      </div>
      <% if @leaderboard.leaderboard_ratings.any? %>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="min-w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-4 py-3">Rank</th>
                <th class="px-4 py-3">Player</th>
                <th class="px-4 py-3">Rating</th>
                <th class="px-4 py-3">Wins</th>
                <th class="px-4 py-3">Losses</th>
                <th class="px-4 py-3">Win %</th>
                <th class="px-4 py-3">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @leaderboard.leaderboard_ratings.order(rating: :desc).each_with_index do |rating, index| %>
                <tr class="border-t border-slate-100">
                  <td class="px-4 py-3 text-slate-600"><%= index + 1 %></td>
                  <td class="px-4 py-3">
                    <%= link_to rating.profile.username, profile_path(rating.profile), class: "font-semibold text-slate-900 hover:text-slate-700" %>
                    <% if rating.profile.user == current_user %>
                      <span class="ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">You</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 font-semibold text-slate-900"><%= rating.rating.round %> <span class="text-xs text-slate-500">±<%= rating.rating_deviation.round %></span></td>
                  <td class="px-4 py-3 text-slate-600"><%= rating.wins %></td>
                  <td class="px-4 py-3 text-slate-600"><%= rating.losses %></td>
                  <td class="px-4 py-3 text-slate-600">
                    <% total = rating.wins + rating.losses %>
                    <%= total.positive? ? ((rating.wins.to_f / total) * 100).round : 0 %>%
                  </td>
                  <td class="px-4 py-3 text-slate-600">
                    <% if current_user && rating.profile.user != current_user && @organization.organization_memberships.approved.by_user(current_user.id).exists? %>
                      <%= link_to new_match_path(opponent_profile_id: rating.profile.id, leaderboard_id: @leaderboard.id), class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900" do %>
                        Challenge
                        <i class="fas fa-arrow-right text-xs"></i>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-slate-600">No players yet.</p>
      <% end %>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Recent matches</h2>
      </div>
      <% recent_matches = Match.where(leaderboard_id: @leaderboard.id).order(created_at: :desc).limit(10) %>
      <% if recent_matches.any? %>
        <div class="space-y-3">
          <% recent_matches.each do |match| %>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm text-sm text-slate-600">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <p class="font-semibold text-slate-900">
                  <%= match.user1.username %>
                  vs
                  <%= match.opponent.username %>
                </p>
                <p class="text-xs text-slate-500"><%= match.created_at.strftime("%b %d, %Y") %></p>
              </div>
              <p class="text-xs text-slate-500">
                <% if match.winner_id.present? %>
                  <%= match.winner_id == match.user1_id ? match.user1.username : match.opponent.username %> won
                <% else %>
                  No result recorded
                <% end %>
              </p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-slate-600">No matches yet.</p>
      <% end %>
    </section>
  </div>
<% end %>
