<!-- app/views/leaderboards/_rankings.html.erb -->
<div class="space-y-2">
  <% rankings.each_with_index do |rating, index| %>
    <div class="flex justify-between p-2 bg-slate-700 rounded-md">
      <div class="flex items-center space-x-3">
        <span class="text-white font-bold">#<%= index + 1 %></span>
        <span class="text-slate-300">
          <%= link_to rating.profile.username, profile_path(rating.profile), class: "hover:text-purple-300 transition-colors" %>
        </span>
      </div>
      <div class="text-right">
        <div class="text-green-400 font-semibold"><%= rating.rating.round %></div>
        <div class="text-xs text-slate-400">±<%= rating.rating_deviation.round %></div>
      </div>
    </div>
  <% end %>
</div>
