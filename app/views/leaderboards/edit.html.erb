<div>
  <h1 class="font-bold text-4xl">Edit Leaderboard</h1>

  <%= form_with(model: @leaderboard, url: organization_leaderboard_path(@organization, @leaderboard), method: :patch, local: true, class: "space-y-4") do |form| %>
    <div>
      <%= form.label :name, "Leaderboard Name", class: "block font-semibold" %>
      <%= form.text_field :name, class: "border p-2 w-full rounded-md", required: true %>
    </div>

    <div>
      <%= form.label :description, "Description", class: "block font-semibold" %>
      <%= form.text_area :description, class: "border p-2 w-full rounded-md", rows: 3 %>
    </div>

    <div>
      <%= form.submit "Update Leaderboard", class: "bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Organization", organization_path(@organization), class: "text-blue-500" %>
  </div>
</div>
