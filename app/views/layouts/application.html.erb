      <% end %>

      <%= link_to(
            new_user_registration_path,
            class:
              "mobile-nav-item block py-3 px-4 font-medium text-[var(--accent)] rounded-md transition-all duration-300 hover:bg-slate-700/50 mb-1"
          ) do %>
        <i class="fas fa-user-plus mr-3 w-6 text-center"></i>
        Sign Up
      <% end %>
