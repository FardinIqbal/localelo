<!DOCTYPE html>
<html lang="en">
<head>
  <title>LocalElo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Security Meta Tags -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Tailwind CSS -->
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

  <!-- Import JavaScript Dependencies -->
  <%= javascript_importmap_tags %>
</head>

<body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen">

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo -->
    <%= link_to "LocalElo", user_signed_in? ? authenticated_root_path : unauthenticated_root_path,
                class: "text-2xl font-bold text-indigo-600 hover:text-indigo-800 transition" %>

    <!-- Navigation Links (Desktop) -->
    <div class="hidden md:flex space-x-6 items-center">
      <% if user_signed_in? %>
        <%= link_to "Browse", organizations_path, class: "nav-link" %>
        <%= link_to "Log Match", new_match_path, class: "nav-link" %>

        <!-- Profile Dropdown -->
        <div class="relative group">
          <button class="nav-link flex items-center">
            <%= current_user.username || "Profile" %>
            <span class="ml-2">&#9662;</span>
          </button>
          <div class="absolute right-0 mt-2 w-48 bg-white border rounded-lg shadow-lg hidden group-hover:block">
            <%= link_to "Profile", user_path(current_user), class: "dropdown-item" %>
            <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "dropdown-item text-red-600" %>
          </div>
        </div>
      <% else %>
        <%= link_to "Join", organizations_path, class: "nav-link" %>
        <%= link_to "Sign In", new_user_session_path, class: "nav-link" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn-primary" %>
      <% end %>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-button" class="md:hidden text-gray-700 focus:outline-none">
      <i class="fas fa-bars text-2xl"></i>
    </button>
  </div>
</nav>

<!-- Mobile Navigation -->
<div id="mobile-menu" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50">
  <div class="bg-white w-64 h-full shadow-lg p-6 flex flex-col">
    <button id="close-mobile-menu" class="text-gray-700 text-2xl mb-4">&times;</button>

    <% if user_signed_in? %>
      <%= link_to "Browse", organizations_path, class: "mobile-nav-item" %>
      <%= link_to "Log Match", new_match_path, class: "mobile-nav-item" %>
      <%= link_to "Profile", user_path(current_user), class: "mobile-nav-item" %>
      <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "mobile-nav-item text-red-600" %>
    <% else %>
      <%= link_to "Join", organizations_path, class: "mobile-nav-item" %>
      <%= link_to "Sign In", new_user_session_path, class: "mobile-nav-item" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "mobile-nav-item btn-primary" %>
    <% end %>
  </div>
</div>

<!-- Flash Messages -->
<div class="container mx-auto px-6">
  <% flash.each do |type, message| %>
    <div class="flash-message flash-<%= type %>" role="alert">
      <p><%= message %></p>
      <button class="close-flash">&times;</button>
    </div>
  <% end %>
</div>

<!-- Main Content -->
<main class="container mx-auto px-6 flex-grow py-12">
  <%= yield %>
</main>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-6 mt-auto text-center text-sm">
  &copy; <%= Time.current.year %> LocalElo. All rights reserved.
  <div class="mt-2">
    <%= link_to "Privacy Policy", "#", class: "underline" %> |
    <%= link_to "Terms of Service", "#", class: "underline" %> |
    <%= link_to "Contact", "#", class: "underline" %>
  </div>
</footer>

<!-- JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Mobile menu toggle
        document.getElementById("mobile-menu-button").addEventListener("click", () => {
            document.getElementById("mobile-menu").classList.toggle("hidden");
        });

        document.getElementById("close-mobile-menu").addEventListener("click", () => {
            document.getElementById("mobile-menu").classList.add("hidden");
        });

        // Flash message auto-dismiss
        document.querySelectorAll(".flash-message").forEach(alert => {
            setTimeout(() => alert.classList.add("hidden"), 5000);
        });

        // Flash message manual close
        document.querySelectorAll(".close-flash").forEach(btn => {
            btn.addEventListener("click", (e) => e.target.parentElement.classList.add("hidden"));
        });
    });
</script>

</body>
</html>
