<!DOCTYPE html>
<html lang="en">
<head>
  <%= render 'shared/system/head' %>
</head>
<body
  class="retro-layout"
  data-controller="navigation flash bottom-nav tooltip table theme"
>
  <%= render 'shared/navigation/desktop_nav' %>
  <%= render 'shared/navigation/mobile_nav_menu' %>
  <%= render 'shared/system/flash_messages' %>

  <main
    class="retro-main opacity-0 translate-y-4 transition-all duration-500"
    data-navigation-target="mainContent"
  >
    <div class="retro-app">
      <%= yield %>
    </div>
  </main>

  <% if user_signed_in? %>
    <%= render 'shared/navigation/bottom_nav' %>
  <% end %>

  <%= render 'shared/system/toast_container' %>
</body>
</html>
