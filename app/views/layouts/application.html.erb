<!DOCTYPE html>
<html lang="en">
<head>
  <title>LocalElo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Security Meta Tags -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Tailwind CSS -->
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

  <!-- Import JavaScript Dependencies -->
  <%= javascript_importmap_tags %>
</head>

<body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen">

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo -->
    <%= link_to "LocalElo", root_path, class: "text-2xl font-bold text-indigo-600 hover:text-indigo-800 transition" %>

    <!-- Navigation Links -->
    <div class="hidden md:flex space-x-6">
      <% if user_signed_in? %>
        <%= link_to "My Organizations", organizations_path, class: "text-gray-700 hover:text-indigo-600 transition" %>
        <%= link_to "Leaderboards", organization_leaderboards_path(current_user.organizations.first), class: "text-gray-700 hover:text-indigo-600 transition" if current_user.organizations.any? %>
        <%= link_to "Log Match", new_match_path, class: "text-gray-700 hover:text-indigo-600 transition" %>
        <%= link_to "Profile", user_path(current_user), class: "text-gray-700 hover:text-indigo-600 transition" %>
        <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "text-red-600 hover:text-red-800 transition" %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "text-gray-700 hover:text-indigo-600 transition" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition" %>
      <% end %>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-button" class="md:hidden text-gray-700 focus:outline-none">
      <i class="fas fa-bars text-2xl"></i>
    </button>
  </div>
</nav>

<!-- Mobile Navigation (Hidden by Default) -->
<div id="mobile-menu" class="md:hidden hidden bg-white shadow-md">
  <% if user_signed_in? %>
    <%= link_to "My Organizations", organizations_path, class: "block px-6 py-3 text-gray-700 hover:bg-gray-100" %>
    <%= link_to "Leaderboards", organization_leaderboards_path(current_user.organizations.first), class: "block px-6 py-3 text-gray-700 hover:bg-gray-100" if current_user.organizations.any? %>
    <%= link_to "Log Match", new_match_path, class: "block px-6 py-3 text-gray-700 hover:bg-gray-100" %>
    <%= link_to "Profile", user_path(current_user), class: "block px-6 py-3 text-gray-700 hover:bg-gray-100" %>
    <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "text-red-600 hover:text-red-800 transition" %>
  <% else %>
    <%= link_to "Sign In", new_user_session_path, class: "block px-6 py-3 text-gray-700 hover:bg-gray-100" %>
    <%= link_to "Sign Up", new_user_registration_path, class: "block px-6 py-3 bg-indigo-600 text-white hover:bg-indigo-700" %>
  <% end %>
</div>

<!-- Flash Messages -->
<% if flash[:notice] %>
  <div class="bg-green-100 text-green-700 px-6 py-3 rounded-lg mx-6 mt-4">
    <p><%= flash[:notice] %></p>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="bg-red-100 text-red-700 px-6 py-3 rounded-lg mx-6 mt-4">
    <p><%= flash[:alert] %></p>
  </div>
<% end %>

<!-- Main Content -->
<main class="container mx-auto px-6 flex-grow py-12">
  <%= yield %>
</main>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-6 mt-auto">
  <div class="container mx-auto text-center text-sm">
    &copy; <%= Time.current.year %> LocalElo. All rights reserved.
  </div>
</footer>

<!-- Mobile Menu Toggle Script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mobileMenuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");

        mobileMenuButton.addEventListener("click", function() {
            mobileMenu.classList.toggle("hidden");
        });
    });
</script>

</body>
</html>
