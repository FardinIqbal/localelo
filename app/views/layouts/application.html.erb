<!-- Flash Messages -->
<div class="container mx-auto px-4 pt-4">
  <div id="flash-container">
    <% flash.each do |type, message| %>
      <%# Notice/Alert/Success styling classes below %>
      <% flash_class =
           case type
           when "notice" then "bg-indigo-900/50 text-indigo-300 border-l-4 border-indigo-500"
           when "alert"  then "bg-red-900/50 text-red-300 border-l-4 border-red-500"
           when "success" then "bg-green-900/50 text-green-300 border-l-4 border-green-500"
           else
             "bg-slate-800/50 text-slate-300 border-l-4 border-slate-500"
           end
      %>
      <div
        class="flash-message rounded-xl p-4 mb-4 flex justify-between items-center shadow-lg max-w-2xl mx-auto backdrop-blur-md <%= flash_class %>"
        role="alert"
      >
        <div class="flex items-center">
          <% if type == "notice" %>
            <i class="fas fa-info-circle mr-3 text-indigo-400"></i>
          <% elsif type == "alert" %>
            <i class="fas fa-exclamation-circle mr-3 text-red-400"></i>
          <% elsif type == "success" %>
            <i class="fas fa-check-circle mr-3 text-green-400"></i>
          <% end %>
          <p><%= message %></p>
        </div>
        <button class="close-flash text-lg hover:text-white transition-colors">&times;</button>
      </div>
    <% end %>
  </div>
</div>

<!-- Main Content (with bottom padding on mobile if user is signed in) -->
