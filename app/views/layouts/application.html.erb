                "px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 relative text-gray-400 hover:text-[var(--primary)]"
            ) do %>
          <i class="fas fa-search mr-1.5"></i>
          Explore
        <% end %>
        <%= link_to(
              new_user_session_path,
              class:
                "px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 relative text-gray-400 hover:text-[var(--primary)]"
            ) do %>
          <i class="fas fa-sign-in-alt mr-1.5"></i>
          Sign In
        <% end %>
        <%= link_to(
