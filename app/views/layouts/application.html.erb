<!DOCTYPE html>
<html lang="en">
<head>
  <title>LocalElo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="LocalElo - The simple & powerful ranking system for gyms and sports clubs">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Tailwind CSS -->
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap"
    rel="stylesheet"
    />

  <!-- FontAwesome Icons -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

  <!-- Import JavaScript Dependencies -->
  <%= javascript_importmap_tags %>

  <!-- Minimal Custom CSS (no @apply) -->
  <style>
      :root {
          /* Dark mode aesthetic with deep purples, indigos, and pink accents */
          --primary: #6366f1; /* Indigo-500 */
          --primary-light: #818cf8; /* Indigo-400 */
          --primary-dark: #4f46e5; /* Indigo-600 */
          --accent: #ec4899; /* Pink-500 */
          --accent-light: #f472b6; /* Pink-400 */
          --accent-dark: #db2777; /* Pink-600 */
          --success: #10b981;
          --warning: #f59e0b;
          --error: #ef4444;
          --bg-dark: #0f172a; /* Slate-900 */
          --bg-darker: #020617; /* Slate-950 */
          --text-light: #f8fafc; /* Slate-50 */
          --text-muted: #94a3b8; /* Slate-400 */
          --surface-dark: #1e293b; /* Slate-800 */
          --surface-darker: #0f172a; /* Slate-900 */
          --border-dark: #334155; /* Slate-700 */
          --transition-speed: 0.3s;
          --ease: cubic-bezier(0.4, 0, 0.2, 1);
          --radius-sm: 0.375rem;
          --radius-md: 0.5rem;
          --radius-lg: 0.75rem;
          --radius-xl: 1rem;
      }

      /* Smooth fade-in for main content */
      @keyframes fadeIn {
          from {
              opacity: 0;
              transform: translateY(10px);
          }
          to {
              opacity: 1;
              transform: translateY(0);
          }
      }
      .page-transition {
          animation: fadeIn 0.5s var(--ease);
      }

      /* Flash message animations */
      @keyframes slideIn {
          from {
              transform: translateY(-20px);
              opacity: 0;
          }
          to {
              transform: translateY(0);
              opacity: 1;
          }
      }
      @keyframes fadeOutFlash {
          from {
              opacity: 1;
          }
          to {
              opacity: 0;
          }
      }
      .flash-message {
          animation: slideIn 0.5s var(--ease), fadeOutFlash 0.5s var(--ease) 5s forwards;
      }

      /* Ripple effect */
      .ripple {
          position: absolute;
          border-radius: 50%;
          background-color: rgba(255, 255, 255, 0.3);
          transform: scale(0);
          animation: ripple 0.6s linear;
          pointer-events: none;
      }
      @keyframes ripple {
          to {
              transform: scale(4);
              opacity: 0;
          }
      }

      /* Toast animations */
      @keyframes toast-in {
          from {
              transform: translateY(20px);
              opacity: 0;
          }
          to {
              transform: translateY(0);
              opacity: 1;
          }
      }
      @keyframes toast-out {
          from {
              transform: translateY(0);
              opacity: 1;
          }
          to {
              transform: translateY(-20px);
              opacity: 0;
          }
      }

      /* Skeleton loading effect with purple glow */
      @keyframes shimmer {
          0% {
              transform: translateX(-100%);
          }
          100% {
              transform: translateX(100%);
          }
      }
      .skeleton-loader {
          background-color: var(--surface-dark);
          border-radius: 4px;
          position: relative;
          overflow: hidden;
      }
      .skeleton-loader div {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: linear-gradient(
                  90deg,
                  transparent,
                  rgba(129, 140, 248, 0.2),
                  transparent
          );
          animation: shimmer 1.5s infinite;
      }

      /* Hide bottom nav on scroll */
      .hidden-nav {
          transform: translateY(100%) !important;
      }

      /* The dropdown fade/slide effect with updated colors */
      .dropdown-menu {
          opacity: 0;
          visibility: hidden;
          transform: translateY(-10px);
          transition: all 0.3s var(--ease);
          z-index: 50;
      }
      .dropdown-trigger:hover .dropdown-menu,
      .dropdown-trigger:focus-within .dropdown-menu {
          opacity: 1;
          visibility: visible;
          transform: translateY(0);
      }

      /* Floating animation for decorative elements */
      @keyframes float {
          0%,
          100% {
              transform: translateY(0);
          }
          50% {
              transform: translateY(-10px);
          }
      }
      .animate-float {
          animation: float 3s ease-in-out infinite;
      }

      /* Slow pulse animation */
      @keyframes pulse-slow {
          0%,
          100% {
              opacity: 1;
          }
          50% {
              opacity: 0.7;
          }
      }
      .animate-pulse-slow {
          animation: pulse-slow 4s ease-in-out infinite;
      }

      /* Marquee animation for partner logos */
      @keyframes marquee {
          0% {
              transform: translateX(0);
          }
          100% {
              transform: translateX(-100%);
          }
      }
      .animate-marquee {
          animation: marquee 25s linear infinite;
      }
  </style>
</head>
<body
  class="min-h-screen flex flex-col"
  style="font-family: 'Inter', sans-serif; background: linear-gradient(135deg, var(--bg-darker) 0%, var(--bg-dark) 50%, var(--bg-darker) 100%); color: var(--text-light); transition: background-color var(--transition-speed) var(--ease);"
>
<!-- Desktop Navigation Bar -->
<nav
