    <!-- Logo -->
    <%= link_to(
          user_signed_in? ? authenticated_root_path : unauthenticated_root_path,
          class: 'text-2xl font-bold tracking-tight flex items-center cursor-pointer'
        ) do %>
          <span
            class="flex items-center"
            style="
            background: linear-gradient(90deg, var(--accent) 0%, var(--primary) 100%);
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
              transition: all var(--transition-speed) var(--ease);
            "
          >
            <i class="fas fa-chart-line mr-2"></i>
            LocalElo
          </span>
    <% end %>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center space-x-2">
      <% if user_signed_in? %>
        <%= link_to(
              organizations_path,
              class:
                "px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 relative text-gray-400 hover:text-[var(--primary)]
                nav-link #{'font-medium text-[var(--primary)]' if current_page?(organizations_path)}"
            ) do %>
          <i class="fas fa-users mr-1.5"></i>
          Gyms
        <% end %>

        <%= link_to(
              matches_path,
              class:
                "px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 relative text-gray-400 hover:text-[var(--primary)]
                nav-link #{'font-medium text-[var(--primary)]' if current_page?(matches_path)}"
            ) do %>
          <i class="fas fa-trophy mr-1.5"></i>
          Matches
        <% end %>

        <%= link_to(
              new_match_path,
              class:
                "inline-flex items-center justify-center font-medium rounded-md transition-all duration-300 h-10 px-4
