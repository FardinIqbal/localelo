<!DOCTYPE html>
<html lang="en">
<head>
  <%= render 'shared/system/head' %>
</head>
<body
      class="min-h-screen flex flex-col font-['Inter'] bg-gradient-to-br from-slate-50 via-white to-slate-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 text-slate-900 dark:text-slate-50"
      data-controller="navigation flash bottom-nav tooltip table theme"
>

<!-- Skip Links for Accessibility -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-purple-600 focus:text-white focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2">
  Skip to main content
</a>

<%= render 'shared/navigation/desktop_nav' %>         <!-- desktop nav -->
<%= render 'shared/navigation/mobile_nav_menu' %>     <!-- mobile nav/menu -->
<%= render 'shared/system/flash_messages' %>

<main
      id="main-content"
      class="container mx-auto px-4 flex-grow py-8 md:py-12 opacity-0 translate-y-4 transition-all duration-500 <%= 'pb-16' if user_signed_in? %>"
      data-navigation-target="mainContent"
      role="main"
      aria-label="Main content"
>
  <%= yield %>
</main>

<% if user_signed_in? %>
  <%= render 'shared/navigation/bottom_nav' %>       <!-- bottom nav -->
<% end %>

<%= render 'shared/system/toast_container' %>          <!-- toast container -->
</body>
</html>
