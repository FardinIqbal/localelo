<div class="container mx-auto max-w-lg px-6 py-10">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Create a Gym</h1>

  <div class="bg-white shadow-md rounded-lg p-6">
    <%= form_with model: @gym, local: true do |form| %>

      <!-- Gym Name Field -->
      <div class="mb-4">
        <%= form.label :name, "Gym Name", class: "block text-gray-700 font-medium mb-1" %>
        <%= form.text_field :name,
                            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring focus:ring-blue-300 focus:border-blue-500 transition duration-200" %>
      </div>

      <!-- Gym Subdomain Field -->
      <div class="mb-4">
        <%= form.label :subdomain, "Gym Subdomain", class: "block text-gray-700 font-medium mb-1" %>
        <%= form.text_field :subdomain,
                            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring focus:ring-blue-300 focus:border-blue-500 transition duration-200" %>
      </div>

      <!-- Submit Button -->
      <%= form.submit "Create Gym",
                      class: "w-full px-6 py-3 bg-blue-700 text-white font-semibold rounded-lg hover:bg-blue-800 transition duration-300" %>

    <% end %>
  </div>
</div>
