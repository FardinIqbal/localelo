<div class="container mx-auto px-6 py-10">
  <!-- Title -->
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Your Gyms</h1>

  <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center">
    <!-- Search Bar -->
    <div class="w-full lg:w-2/3 mb-4 lg:mb-0">
      <label for="gymSearch"></label><input type="text" id="gymSearch" placeholder="Search for gyms..."
                                            class="w-full p-3 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
    </div>

    <!-- Create Gym Button -->
    <%= link_to "Create a Gym", new_gym_path,
                class: "inline-block px-6 py-3 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition duration-300" %>
  </div>

  <!-- User's Gym List -->
  <% if @gyms.any? %>
    <ul id="gymList" class="mt-6 space-y-4">
      <% @gyms.each do |gym| %>
        <li class="bg-white shadow-md rounded-lg p-4 transition duration-300 hover:bg-gray-100">
          <%= link_to gym.name, gym_path(gym), class: "text-lg font-semibold text-blue-700 hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-600 mt-6">You are not part of any gyms yet.</p>
  <% end %>
</div>

<!-- JavaScript for Gym Search -->
<script>
    document.getElementById("gymSearch").addEventListener("input", function () {
        let searchQuery = this.value.toLowerCase();
        let gyms = document.querySelectorAll("#gymList li");

        gyms.forEach(gym => {
            let gymName = gym.textContent.toLowerCase();
            gym.style.display = gymName.includes(searchQuery) ? "block" : "none";
        });
    });
</script>
