<div class="container mx-auto p-6">
  <!--
    Hero Section - Clean & Focused
    1) Moved user's Elo & Rank to the top (Prominent display).
    2) Display total matches played, win rate, and current streak
       (using Font Awesome icons instead of emojis).
  -->
  <div class="relative bg-gradient-to-r from-blue-800 to-indigo-900 rounded-xl shadow-xl overflow-hidden mb-10">
    <div class="absolute inset-0 opacity-20 pattern-dots"></div>
    <div class="relative z-10 text-white text-center py-12 px-6">
      <!-- Gym Name & Tagline -->
      <h1 class="text-5xl font-extrabold tracking-tight mb-2"><%= @gym.name %></h1>
      <p class="text-xl text-blue-100 font-medium mb-4">Train Hard. Rank Higher. Become Legendary.</p>

      <!--
        NEW: Display Current User's Elo & Rank at the Top
        This gives immediate visibility of personal standing.
      -->
      <div class="mb-6">
        <% membership = @gym.gym_memberships.find_by(user: current_user) %>
        <% current_elo = membership&.elo || 'N/A' %>
        <% current_rank = membership&.rank || 'N/A' %>

        <p class="text-2xl font-bold">
          Elo: <span class="text-yellow-300"><%= current_elo %></span>
          | Rank: <span class="text-yellow-300">#<%= current_rank %></span>
        </p>
      </div>

      <!--
        NEW: Show Quick Stats at the Top (Total Matches, Win Rate, Streak).
        - For illustration, these placeholders assume you have methods like:
          current_user.total_matches_in_gym(@gym),
          current_user.win_rate_in_gym(@gym),
          current_user.current_streak_in_gym(@gym),
          current_user.streak_type_in_gym(@gym) => "winning" or "losing"
      -->
      <div class="flex justify-center space-x-6 text-blue-100">
        <div>
          <i class="fas fa-chart-bar"></i>
          Total Matches:
          <%= current_user.total_matches_in_gym(@gym) rescue 0 %>
        </div>
        <div>
          <i class="fas fa-percentage"></i>
          Win Rate:
          <%= current_user.win_rate_in_gym(@gym) rescue '0%' %>
        </div>
        <div>
          <!--
            If user is on a winning streak, show fa-fire
            If losing, show fa-exclamation-circle
          -->
          <% streak_type = current_user.streak_type_in_gym(@gym) rescue "none" %>
          <% streak_icon = streak_type == "winning" ? "fa-fire" : "fa-exclamation-circle" %>
          <i class="fas <%= streak_icon %>"></i>
          Streak:
          <%= current_user.current_streak_in_gym(@gym) rescue 0 %>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex justify-center mt-8 space-x-4">
        <%= link_to new_match_path(gym_id: @gym.id), class: "bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-bold py-3 px-6 rounded-lg transition transform hover:scale-105 shadow-lg flex items-center" do %>
          <i class="fas fa-plus-circle mr-2"></i>
          Log a Match
        <% end %>
        <%= link_to "#", class: "bg-blue-900 bg-opacity-50 hover:bg-opacity-70 text-white font-medium py-3 px-6 rounded-lg transition border border-blue-400 flex items-center" do %>
          <i class="fas fa-users mr-2"></i>
          View Members
        <% end %>
      </div>
    </div>
  </div>

  <!-- Two Column Section: Recent Matches + Your Stats -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
    <!-- Recent Matches (2/3 width on desktop) -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
        <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b">
          <h2 class="text-2xl font-bold text-gray-800">
            <i class="fas fa-trophy text-blue-600 mr-2"></i>
            Recent Matches
          </h2>
          <a href="#" class="text-blue-600 hover:text-blue-800 font-medium flex items-center">
            <span>View All</span>
            <i class="fas fa-chevron-right ml-1 text-xs"></i>
          </a>
        </div>

        <div class="divide-y divide-gray-100">
          <% @matches&.each do |match| %>
            <div class="p-5 hover:bg-blue-50 transition-colors">
              <div class="flex flex-wrap md:flex-nowrap items-center justify-between">
                <!-- Match Players -->
                <div class="w-full md:w-auto mb-3 md:mb-0">
                  <div class="flex items-center">
                    <div class="flex items-center mr-3">
                      <span class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-800 mr-2">
                        <i class="fas fa-user"></i>
                      </span>
                      <span class="font-medium <%= match.winner == match.user1 ? 'text-green-600 font-bold' : '' %>">
                        <%= match.user1&.full_name || "Unknown" %>
                      </span>
                    </div>
                    <span class="px-2 text-gray-500">vs</span>
                    <div class="flex items-center">
                      <span class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-800 mr-2">
                        <i class="fas fa-user"></i>
                      </span>
                      <span class="font-medium <%= match.winner == match.opponent ? 'text-green-600 font-bold' : '' %>">
                        <%= match.opponent&.full_name || "Unknown" %>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Match Details -->
                <div class="flex flex-col items-end space-y-1 md:space-y-0 md:flex-row md:items-center">
                  <!-- If there is a submission, show it -->
                  <% if match.submission.present? %>
                    <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm rounded-full mr-3 flex items-center">
                      <i class="fas fa-medal mr-1"></i>
                      <%= match.submission %>
                    </span>
                  <% end %>
                  <!-- Match Date -->
                  <span class="text-sm text-gray-500 whitespace-nowrap mr-3">
                    <i class="far fa-clock mr-1"></i>
                    <%= match.match_time.strftime("%b %d, %Y") %>
                  </span>

                  <!--
                    NEW: Elo Changes
                    This displays how much Elo the winner gained and how much the loser lost.
                    It assumes you have methods like match.elo_change_for_winner and match.elo_change_for_loser.
                  -->
                  <span class="text-sm text-gray-600 whitespace-nowrap">
                    <i class="fas fa-arrows-alt-v mr-1"></i>
                    Winner +<%= match.elo_change_for_winner || 0 %>
                    | Loser -<%= match.elo_change_for_loser || 0 %>
                  </span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Your Stats (1/3 width on desktop) -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100 h-full">
        <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b">
          <h2 class="text-2xl font-bold text-gray-800">
            <i class="fas fa-chart-line text-blue-600 mr-2"></i>
            Your Stats
          </h2>
        </div>

        <div class="p-6 space-y-4">
          <!--
            This section still shows personal stats.
            The "Current Rank" is also shown at the top now,
            but we can keep it here for redundancy or remove it.
          -->
          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <span class="text-gray-600">Current Rank</span>
            <span class="text-xl font-bold">#<%= @gym.gym_memberships.where(user: current_user).first&.rank || 'N/A' %></span>
          </div>

          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <span class="text-gray-600">Win Rate</span>
            <span class="font-bold text-green-600">60%</span>
          </div>

          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <span class="text-gray-600">Matches</span>
            <span class="font-bold">Won 3, Lost 2</span>
          </div>

          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <span class="text-gray-600">Top Submission</span>
            <span class="px-2 py-1 bg-blue-100 text-blue-800 text-sm rounded-lg">Armbar</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-gray-600">Biggest Elo Gain</span>
            <span class="font-bold text-green-600">+45</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--
    Leaderboard Section
    1) Could be made clickable so each user leads to a personal profile.
    2) Top 3 players are highlighted with distinct icons/colors.
  -->
  <div class="mb-10">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
      <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b">
        <h2 class="text-2xl font-bold text-gray-800">
          <i class="fas fa-crown text-blue-600 mr-2"></i>
          Leaderboard
        </h2>
        <a href="#" class="text-blue-600 hover:text-blue-800 font-medium flex items-center">
          <span>View Full Rankings</span>
          <i class="fas fa-chevron-right ml-1 text-xs"></i>
        </a>
      </div>

      <table class="w-full">
        <thead>
        <tr class="bg-gray-50 text-gray-600 text-sm uppercase">
          <th class="py-3 px-6 text-left">Rank</th>
          <th class="py-3 px-6 text-left">User</th>
          <th class="py-3 px-6 text-left">Elo</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        <% @gym.gym_memberships.includes(:user).order(elo: :desc).limit(5).each_with_index do |membership, index| %>
          <tr class="hover:bg-blue-50 transition-colors">
            <td class="py-4 px-6">
              <% if index == 0 %>
                <i class="fas fa-trophy text-yellow-500 mr-1"></i>
              <% elsif index == 1 %>
                <i class="fas fa-medal text-gray-400 mr-1"></i>
              <% elsif index == 2 %>
                <i class="fas fa-medal text-yellow-700 mr-1"></i>
              <% else %>
                <%= index + 1 %>
              <% end %>
            </td>
            <td class="py-4 px-6 flex items-center">
                <span class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-800 mr-2">
                  <i class="fas fa-user"></i>
                </span>
              <!--
                NEW: Could be linked to user profile:
                link_to membership.user.full_name, user_path(membership.user)
              -->
              <%= membership.user.full_name %>
            </td>
            <td class="py-4 px-6 font-bold"><%= membership.elo %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!--
    Gym Trends & Analytics (Not fully implemented in code, but here's where you could place it):
      - Most used submission in the entire gym, with counts.
      - Biggest Elo gainer this week.
      - Most active players (number of matches).
    You can create a new section here, or combine it with "Gym Information".
  -->

  <!-- Gym Information -->
  <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100 mb-6">
    <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b">
      <h2 class="text-xl font-bold text-gray-800">
        <i class="fas fa-info-circle text-blue-600 mr-2"></i>
        Gym Information
      </h2>
    </div>

    <div class="p-6 text-gray-600 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <p class="font-medium text-gray-700 mb-1">
          <i class="fas fa-map-marker-alt text-blue-600 mr-2"></i>Address
        </p>
        <p>123 Main Street, NYC, 10001</p>
      </div>

      <div>
        <p class="font-medium text-gray-700 mb-1">
          <i class="fas fa-user-tie text-blue-600 mr-2"></i>Owner
        </p>
        <p>John Doe</p>
      </div>

      <div>
        <p class="font-medium text-gray-700 mb-1">
          <i class="fas fa-clock text-blue-600 mr-2"></i>Training Hours
        </p>
        <p>Mon-Fri: 6AM-10PM | Sat-Sun: 8AM-8PM</p>
      </div>
    </div>
  </div>

  <!-- Flash Messages (Dismissible) -->
  <% if flash[:notice] %>
    <div id="flash-message" class="fixed bottom-5 right-5 bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-lg max-w-md animate-fade-in-up">
      <div class="flex items-center">
        <i class="fas fa-check-circle text-green-500 mr-2 text-lg"></i>
        <span><%= flash[:notice] %></span>
        <button onclick="document.getElementById('flash-message').remove();" class="ml-auto text-green-500 hover:text-green-700">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>
  <% end %>
</div>

<style>
    .pattern-dots {
        background-image: radial-gradient(rgba(255, 255, 255, 0.2) 10%, transparent 10%);
        background-size: 20px 20px;
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.5s ease-out;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
