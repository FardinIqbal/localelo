<div class="container mx-auto p-6 space-y-10">
  <!-- Gym Overview Banner -->
  <div class="relative bg-cover bg-center h-52 rounded-lg shadow-lg flex items-center p-6"
       style="background-image: url('https://source.unsplash.com/featured/?bjj,gym');">
    <div class="absolute inset-0 bg-black bg-opacity-50 rounded-lg"></div>
    <div class="relative z-10 text-white">
      <h1 class="text-4xl font-bold"><%= @gym.name %></h1>
      <p class="text-lg text-gray-300 mt-2">Train Hard. Rank Higher.</p>
      <%= link_to new_match_path(gym_id: @gym.id), class: "mt-4 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition flex items-center inline-block shadow-md" do %>
        <i class="fas fa-plus mr-2"></i>
        Log a Match
      <% end %>
    </div>
  </div>

  <!-- Leaderboard -->
  <section>
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Leaderboard</h2>
    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
      <table class="w-full border-collapse border border-gray-300">
        <thead>
        <tr class="bg-blue-700 text-white">
          <th class="p-3 text-left">Rank</th>
          <th class="p-3 text-left">User</th>
          <th class="p-3 text-left">Elo</th>
        </tr>
        </thead>
        <tbody>
        <% @gym.gym_memberships.includes(:user).order(elo: :desc).each_with_index do |membership, index| %>
          <tr class="<%= index.even? ? 'bg-gray-100' : 'bg-white' %> hover:bg-gray-200 transition">
            <td class="p-3 font-bold">
              <% if index == 0 %>
                <i class="fas fa-trophy text-yellow-500 mr-2"></i>
              <% elsif index == 1 %>
                <i class="fas fa-medal text-silver-500 mr-2"></i>
              <% elsif index == 2 %>
                <i class="fas fa-medal text-bronze-500 mr-2"></i>
              <% else %>
                <%= index + 1 %>
              <% end %>
            </td>
            <td class="p-3 flex items-center">
              <img src="https://i.pravatar.cc/40?u=<%= membership.user.id %>" class="rounded-full h-8 w-8 mr-3"/>
              <%= membership.user.email %>
            </td>
            <td class="p-3 font-semibold"><%= membership.elo %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Recent Matches -->
  <section>
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Recent Matches</h2>
    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
      <table class="w-full border-collapse border border-gray-300">
        <thead>
        <tr class="bg-blue-700 text-white">
          <th class="p-3 text-left">Player 1</th>
          <th class="p-3 text-left">Player 2</th>
          <th class="p-3 text-left">Winner</th>
          <th class="p-3 text-left">Submission</th>
          <th class="p-3 text-left">Date</th>
        </tr>
        </thead>
        <tbody>
        <% @matches&.each do |match| %>
          <tr class="hover:bg-gray-200 transition">
            <td class="p-3"><%= match.user1&.email || "Unknown" %></td>
            <td class="p-3"><%= match.opponent&.email || "Unknown" %></td>
            <td class="p-3 font-semibold
              <% if match.winner == current_user %>text-green-600
              <% else %>text-red-600
              <% end %>">
              <%= match.winner&.email || 'Draw' %>
            </td>
            <td class="p-3">
              <% if match.submission.present? %>
                  <span class="px-2 py-1 bg-blue-100 text-blue-800 text-sm rounded-lg">
                    <%= match.submission %>                  </span>
              <% else %>
                N/A
              <% end %>
            </td>
            <td class="p-3 text-sm text-gray-600"><%= match.match_time.strftime("%b %d, %Y %I:%M %p") %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Flash Messages (Dismissible) -->
  <% if flash[:notice] %>
    <div id="flash-message" class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4 shadow-md">
      <span class="block sm:inline"><%= flash[:notice] %></span>
      <button onclick="document.getElementById('flash-message').remove();" class="absolute top-0 bottom-0 right-0 px-4 py-3">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% end %>
</div>