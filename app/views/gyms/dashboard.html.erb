<h1><%= @gym.name %> - Dashboard</h1>

<h2>Leaderboard</h2>
<table>
  <tr>
    <th>Rank</th>
    <th>Player</th>
    <th>Elo</th>
  </tr>
  <% @players.each_with_index do |player, index| %>
    <tr>
      <td><%= index + 1 %></td>
      <td><%= player.user.email %></td>
      <td><%= player.elo %></td>
    </tr>
  <% end %>
</table>

<h2>Recent Matches</h2>
<table>
  <tr>
    <th>Player 1</th>
    <th>Player 2</th>
    <th>Winner</th>
    <th>Submission</th>
  </tr>
  <% @matches.each do |match| %>
    <tr>
      <td><%= match.player1.user.email %></td>
      <td><%= match.player2.user.email %></td>
      <td><%= match.winner ? match.winner.user.email : 'Draw' %></td>
      <td><%= match.submission || 'N/A' %></td>
    </tr>
  <% end %>
</table>

<h2>Pending Match Requests</h2>
<table>
  <tr>
    <th>Challenger</th>
    <th>Action</th>
  </tr>
  <% @pending_requests.each do |request| %>
    <tr>
      <td><%= request.challenger.user.email %></td>
      <td>
        <%= button_to "Accept", accept_match_request_path(request), method: :post %>
        <%= button_to "Decline", decline_match_request_path(request), method: :post %>
      </td>
    </tr>
  <% end %>
</table>

<h2>Challenge a Player</h2>
<table>
  <tr>
    <th>Player</th>
    <th>Elo</th>
    <th>Action</th>
  </tr>
  <% @players.each do |player| %>
    <% unless player.user == current_user %>
      <tr>
        <td><%= player.user.email %></td>
        <td><%= player.elo %></td>
        <td>
          <%= button_to "Challenge", match_requests_path(opponent_id: player.id), method: :post %>
        </td>
      </tr>
    <% end %>
  <% end %>
</table>

<h2>Notifications</h2>
<% @notifications = current_user.notifications.unread %>
<% if @notifications.any? %>
  <ul>
    <% @notifications.each do |notification| %>
      <li>
        <%= notification.message %>
        <%= link_to "Mark as Read", mark_as_read_notification_path(notification), method: :patch %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No new notifications.</p>
<% end %>
