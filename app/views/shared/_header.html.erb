<nav class="bg-slate-900/90 backdrop-blur-xl border-b border-white/10 sticky top-0 z-30 transition-all duration-300 hidden md:block">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">

    <!-- Logo -->
    <%= link_to(
          user_signed_in? ? authenticated_root_path : unauthenticated_root_path,
          class: 'text-2xl font-bold tracking-tight flex items-center cursor-pointer'
        ) do %>
        <span class="flex items-center bg-gradient-to-r from-pink-500 to-indigo-500 bg-clip-text text-transparent transition-all duration-300">
          <i class="fas fa-chart-line mr-2"></i>
          LocalElo
        </span>
    <% end %>

    <!-- Nav Links -->
    <div class="flex items-center space-x-2">
      <% if user_signed_in? %>
        <%= render 'shared/nav_link', text: 'Home', path: authenticated_root_path, icon: 'fa-home' %>
        <%= render 'shared/nav_link', text: 'Explore', path: organizations_path, icon: 'fa-search' %>
        <%= render 'shared/nav_link', text: 'My Organizations', path: account_organizations_path, icon: 'fa-users' %>
        <%= render 'shared/nav_link', text: 'Matches', path: matches_path, icon: 'fa-trophy' %>

        <!-- Log Match Button -->
        <%= link_to new_match_path,
                    class: "inline-flex items-center justify-center font-medium rounded-md transition-all duration-300 h-10 px-4 text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:bg-gradient-to-r hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-1 relative overflow-hidden" do %>
          <i class="fas fa-plus mr-1.5"></i>
          Log Match
        <% end %>

        <!-- Profile Dropdown -->
        <div class="relative ml-2" data-controller="profile-dropdown">
          <button
            type="button"
            class="px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 relative text-gray-400 hover:text-indigo-500 flex items-center"
            data-action="click->profile-dropdown#toggle"
          >
            <div class="w-8 h-8 bg-slate-700 rounded-full flex items-center justify-center mr-2 border border-white/10">
              <i class="fas fa-user text-white/70"></i>
            </div>
            <span><%= current_user.username || 'Profile' %></span>
            <i class="fas fa-chevron-down ml-1.5 text-xs"></i>
          </button>

          <div
            class="absolute right-0 mt-2 w-48 bg-slate-800/90 backdrop-blur-xl rounded-lg shadow-lg overflow-hidden border border-white/10 transform transition-all duration-300 z-50 hidden"
            data-profile-dropdown-target="menu"
          >
            <%= link_to user_path(current_user), class: "block px-4 py-2 text-sm w-full text-left transition-colors duration-300 text-white hover:bg-slate-700/50 hover:text-pink-500" do %>
              <i class="fas fa-user mr-2"></i> My Profile
            <% end %>

            <%= link_to '#', class: "block px-4 py-2 text-sm w-full text-left transition-colors duration-300 text-white hover:bg-slate-700/50 hover:text-pink-500" do %>
              <i class="fas fa-cog mr-2"></i> Settings
            <% end %>

            <div class="my-1 border-t border-white/5"></div>

            <%= button_to destroy_user_session_path, method: :delete,
                          class: "block px-4 py-2 text-sm w-full text-left transition-colors duration-300 text-red-400 hover:bg-slate-700/50 hover:text-red-300" do %>
              <i class="fas fa-sign-out-alt mr-2"></i> Logout
            <% end %>
          </div>
        </div>

      <% else %>
        <%= render 'shared/nav_link', text: 'Explore', path: organizations_path, icon: 'fa-search' %>
        <%= render 'shared/nav_link', text: 'Sign In', path: new_user_session_path, icon: 'fa-sign-in-alt' %>
        <%= render 'shared/nav_link', text: 'Sign Up', path: new_user_registration_path, icon: 'fa-user-plus' %>
      <% end %>
    </div>
  </div>
</nav>
