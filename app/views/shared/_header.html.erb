<header>
  <nav data-controller="navigation" data-navigation-target="navbar" class="bg-slate-800/90 backdrop-blur-sm transition-all duration-300">
    <div class="container mx-auto px-4">
      <div class="flex justify-between items-center py-4">
        <!-- Logo -->
        <div class="flex items-center">
          <%= link_to root_path, class: "text-xl font-bold text-white" do %>
            <span class="text-pink-500">ELO</span>Tracker
          <% end %>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-6">
          <% if user_signed_in? %>
            <%= link_to "Dashboard", authenticated_root_path, class: "nav-link text-gray-300 hover:text-white" %>
            <%= link_to "My Organizations", account_organizations_path, class: "nav-link text-gray-300 hover:text-white" %>
            <%= link_to "Organizations", organizations_path, class: "nav-link text-gray-300 hover:text-white" %>
            <%= link_to "Matches", matches_path, class: "nav-link text-gray-300 hover:text-white" %>

            <!-- User dropdown -->
            <div data-controller="mobile-menu" class="relative">
              <button data-mobile-menu-target="button" data-action="mobile-menu#toggle" class="flex items-center text-gray-300 hover:text-white">
                <span><%= current_user.username || current_user.email %></span>
                <i data-mobile-menu-target="icon" class="fas fa-chevron-down ml-1 text-xs"></i>
              </button>
              <div data-mobile-menu-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-slate-800 rounded-md shadow-lg py-1 z-50">
                <%= link_to "Profile", user_profile_path, class: "block px-4 py-2 text-sm text-gray-300 hover:bg-slate-700 hover:text-white" %>
                <%= link_to "Edit Account", edit_user_registration_path, class: "block px-4 py-2 text-sm text-gray-300 hover:bg-slate-700 hover:text-white" %>
                <%= link_to "Sign Out", destroy_user_session_path, method: :delete, class: "block px-4 py-2 text-sm text-gray-300 hover:bg-slate-700 hover:text-white" %>
              </div>
            </div>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "nav-link text-gray-300 hover:text-white" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "nav-link px-4 py-2 rounded-md bg-pink-600 hover:bg-pink-700 text-white" %>
          <% end %>
        </div>

        <!-- Mobile menu button -->
        <div class="md:hidden">
          <div data-controller="mobile-menu" data-mobile-menu-target="container">
            <button data-mobile-menu-target="button" data-action="mobile-menu#toggle" class="text-gray-300 hover:text-white">
              <i data-mobile-menu-target="icon" class="fas fa-bars text-xl"></i>
            </button>
            <div data-mobile-menu-target="menu" class="hidden fixed inset-0 z-50 bg-slate-900/95 backdrop-blur-sm">
              <div class="flex flex-col h-full">
                <div class="flex justify-end p-4">
                  <button data-action="mobile-menu#close" class="text-gray-300 hover:text-white">
                    <i class="fas fa-times text-xl"></i>
                  </button>
                </div>
                <div class="flex flex-col items-center justify-center flex-grow space-y-8 text-xl">
                  <% if user_signed_in? %>
                    <%= link_to "Dashboard", authenticated_root_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" %>
                    <%= link_to "My Organizations", account_organizations_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" %>
                    <%= link_to "Organizations", organizations_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" %>
                    <%= link_to "Matches", matches_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" %>
                    <%= link_to "Profile", user_profile_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" %>
                    <%= link_to "Sign Out", destroy_user_session_path, method: :delete, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center bg-pink-600 hover:bg-pink-700" %>
                  <% else %>
                    <%= link_to "Sign In", new_user_session_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" %>
                    <%= link_to "Sign Up", new_user_registration_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center bg-pink-600 hover:bg-pink-700" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
