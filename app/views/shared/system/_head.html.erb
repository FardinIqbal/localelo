<title><%= content_for?(:title) ? yield(:title) : "LocalElo" %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="LocalElo - The simple & powerful ranking system for gyms and sports clubs">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# Inline script to set theme and avoid FOUC %>
<%= render 'shared/system/theme_script' %>

<!-- Tailwind CSS -->
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap"
  rel="stylesheet"
  />

<!-- FontAwesome Icons -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

<!-- Import JavaScript Dependencies -->
<%= javascript_importmap_tags %>
