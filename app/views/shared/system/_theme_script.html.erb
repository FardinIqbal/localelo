<script>
  // Set theme immediately to avoid FOUC (Flash of Unstyled Content)
  if (localStorage.getItem('theme') === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    // Default to light mode if no theme is set or if theme is 'light'
    document.documentElement.classList.remove('dark');
    // We also explicitly set the theme to 'light' in localStorage if it's not set
    // This ensures the Stimulus controller knows the correct state on the first toggle.
    if (!localStorage.getItem('theme')) {
      localStorage.setItem('theme', 'light');
    }
  }
</script>
