<% if flash.any? %>
  <div
    id="flash-container"
    class="retro-flash-container fixed top-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-xl space-y-3 pointer-events-none"
    data-controller="flash"
  >
    <% flash.each do |type, message| %>
      <% variant, icon = case type.to_s
                         when "notice" then ["retro-flash--notice", "fas fa-info-circle"]
                         when "alert"  then ["retro-flash--alert", "fas fa-exclamation-circle"]
                         when "success" then ["retro-flash--success", "fas fa-check-circle"]
                         else ["", "fas fa-bell"]
                         end %>
      <div
        class="retro-flash <%= variant %> opacity-100 translate-y-0 transition-all duration-500"
        role="status"
        data-flash-target="message"
      >
        <div class="retro-flash__content">
          <i class="retro-flash__icon <%= icon %>"></i>
          <span><%= message %></span>
        </div>
        <button
          type="button"
          class="retro-flash__close"
          data-action="click->flash#close"
          aria-label="Dismiss message"
        >
          &times;
        </button>
      </div>
    <% end %>
  </div>
<% end %>
