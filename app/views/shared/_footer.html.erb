<footer class="bg-slate-800/90 backdrop-blur-sm py-8 mt-12">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-xl font-bold mb-4"><span class="text-pink-500">ELO</span>Tracker</h3>
        <p class="text-gray-400">Track your competitive rankings across multiple organizations and leaderboards.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><%= link_to "Home", root_path, class: "text-gray-400 hover:text-white" %></li>
          <li><%= link_to "Organizations", organizations_path, class: "text-gray-400 hover:text-white" %></li>
          <li><%= link_to "Matches", matches_path, class: "text-gray-400 hover:text-white" %></li>
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Account</h3>
        <ul class="space-y-2">
          <% if user_signed_in? %>
            <li><%= link_to "Profile", user_profile_path, class: "text-gray-400 hover:text-white" %></li>
            <li><%= link_to "My Organizations", account_organizations_path, class: "text-gray-400 hover:text-white" %></li>
            <li><%= link_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-gray-400 hover:text-white" %></li>
          <% else %>
            <li><%= link_to "Sign In", new_user_session_path, class: "text-gray-400 hover:text-white" %></li>
            <li><%= link_to "Sign Up", new_user_registration_path, class: "text-gray-400 hover:text-white" %></li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="border-t border-slate-700 mt-8 pt-8 text-center text-gray-500">
      <p>&copy; <%= Date.current.year %> ELO Tracker. All rights reserved.</p>
    </div>
  </div>
</footer>
