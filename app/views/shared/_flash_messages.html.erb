<% if flash.any? %>
  <div
    id="flash-container"
    class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 max-w-xl w-full space-y-2 pointer-events-none"
    data-controller="flash"
  >
    <% flash.each do |type, message| %>
      <% flash_class, icon_class = case type.to_s
                                   when "notice" then ["bg-indigo-900/50 text-indigo-300 border-indigo-500", "fas fa-info-circle text-indigo-400"]
                                   when "alert"  then ["bg-red-900/50 text-red-300 border-red-500", "fas fa-exclamation-circle text-red-400"]
                                   when "success" then ["bg-green-900/50 text-green-300 border-green-500", "fas fa-check-circle text-green-400"]
                                   else ["bg-slate-800/50 text-slate-300 border-slate-500", "fas fa-bell text-slate-400"]
                                   end %>

      <div
        class="flash-message flex items-center justify-between rounded-xl px-4 py-3 border-l-4 shadow-md backdrop-blur-md transition-all duration-500 transform opacity-100 translate-y-0 <%= flash_class %>"
        role="alert"
        data-flash-target="message"
      >
        <div class="flex items-center">
          <i class="<%= icon_class %> mr-3"></i>
          <p class="font-medium"><%= message %></p>
        </div>
        <button
          class="close-flash text-lg hover:text-white transition-colors duration-300"
          data-action="click->flash#close"
        >
          &times;
        </button>
      </div>
    <% end %>
  </div>
<% end %>
