<% if flash.any? %>
  <div class="mb-6">
    <% flash.each do |type, message| %>
      <% flash_class = case type.to_sym
                       when :notice then "bg-indigo-900/50 border-indigo-500 text-indigo-100"
                       when :success then "bg-green-900/50 border-green-500 text-green-100"
                       when :error then "bg-red-900/50 border-red-500 text-red-100"
                       when :alert then "bg-yellow-900/50 border-yellow-500 text-yellow-100"
                       else "bg-slate-800/50 border-slate-500 text-slate-100"
                       end %>
      <div data-controller="flash" class="mb-4 p-4 rounded-lg border-l-4 <%= flash_class %> transition-opacity duration-500">
        <div class="flex justify-between items-center">
          <div><%= message %></div>
          <button data-action="flash#close" class="text-white hover:text-gray-200">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
