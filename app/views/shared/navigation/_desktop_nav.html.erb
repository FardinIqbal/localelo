<nav class="retro-desktop-nav hidden md:block">
  <div class="retro-app">
    <div class="retro-nav__inner">
      <%= link_to(user_signed_in? ? authenticated_root_path : unauthenticated_root_path, class: "retro-brand") do %>
        <span class="retro-brand__mark">LE</span>
        <span class="retro-brand__text">
          <span class="retro-brand__title">LocalElo</span>
          <span class="retro-brand__tagline">Minimal retro rankings</span>
        </span>
      <% end %>

      <div class="retro-nav__group">
        <%= form_with url: search_path, method: :get, local: true, class: "retro-search" do |form| %>
          <%= form.label :q, "Search", class: "sr-only" %>
          <i class="fas fa-search retro-search__icon" aria-hidden="true"></i>
          <%= form.search_field :q,
                                value: params[:q],
                                placeholder: "Search",
                                class: "retro-search__input",
                                'aria-label': 'Search' %>
        <% end %>

        <% if user_signed_in? %>
          <div class="retro-nav__links">
            <%= link_to authenticated_root_path, class: active_nav_class(authenticated_root_path) do %>
              <i class="fas fa-home"></i>
              Home
            <% end %>
            <%= link_to organizations_path, class: active_nav_class(organizations_path) do %>
              <i class="fas fa-search"></i>
              Explore
            <% end %>
            <%= link_to account_organizations_path, class: active_nav_class(account_organizations_path) do %>
              <i class="fas fa-users"></i>
              My Orgs
            <% end %>
            <%= link_to matches_path, class: active_nav_class(matches_path) do %>
              <i class="fas fa-trophy"></i>
              Matches
            <% end %>
          </div>

          <%= render 'shared/navigation/theme_toggle' %>

          <%= link_to new_match_path, class: "retro-cta" do %>
            <i class="fas fa-plus"></i>
            Log Match
          <% end %>

          <div class="retro-profile" data-controller="profile-dropdown">
            <button
              type="button"
              class="retro-profile__trigger"
              data-action="click->profile-dropdown#toggle"
            >
              <span class="retro-profile__avatar">
                <i class="fas fa-user"></i>
              </span>
              <span class="retro-profile__name"><%= current_user.email.presence || 'My Account' %></span>
              <i class="fas fa-chevron-down retro-profile__chevron"></i>
            </button>

            <div class="retro-profile__menu hidden" data-profile-dropdown-target="menu">
              <% primary_profile = current_user.profiles.first %>
              <%= link_to(primary_profile ? profile_path(primary_profile) : authenticated_root_path,
                          class: "retro-profile__link") do %>
                <i class="fas fa-user"></i>
                <span>My Profile</span>
              <% end %>

              <%= link_to '#', class: "retro-profile__link" do %>
                <i class="fas fa-cog"></i>
                <span>Settings</span>
              <% end %>

              <hr class="retro-profile__divider"/>

              <%= button_to destroy_user_session_path, method: :delete, class: "retro-profile__link retro-profile__link--danger" do %>
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="retro-nav__links">
            <%= link_to organizations_path, class: active_nav_class(organizations_path) do %>
              <i class="fas fa-search"></i>
              Explore
            <% end %>
          </div>

          <%= render 'shared/navigation/theme_toggle' %>

          <div class="retro-nav__links">
            <%= link_to new_user_session_path, class: active_nav_class(new_user_session_path) do %>
              <i class="fas fa-sign-in-alt"></i>
              Sign In
            <% end %>
            <%= link_to new_user_registration_path, class: active_nav_class(new_user_registration_path) do %>
              <i class="fas fa-user-plus"></i>
              Sign Up
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>
