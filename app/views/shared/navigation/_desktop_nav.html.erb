<nav class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border-b border-slate-200/60 dark:border-white/10 sticky top-0 z-30 transition-all duration-200 hidden md:block">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">

    <!-- Logo -->
    <%= link_to(
          user_signed_in? ? authenticated_root_path : unauthenticated_root_path,
          class: 'text-2xl font-bold tracking-tight flex items-center group'
        ) do %>
        <span class="flex items-center bg-gradient-to-r from-pink-500 to-indigo-500 bg-clip-text text-transparent transition-all duration-200 group-hover:scale-105">
          <i class="fas fa-chart-line mr-2"></i>
          LocalElo
        </span>
    <% end %>

    <!-- Nav Links -->
    <div class="flex items-center gap-2">
      <% if user_signed_in? %>
        <%= link_to authenticated_root_path, class: active_nav_class(authenticated_root_path) do %>
          <i class="fas fa-home mr-2"></i>
          Home
        <% end %>
        <%= link_to organizations_path, class: active_nav_class(organizations_path) do %>
          <i class="fas fa-search mr-2"></i>
          Explore
        <% end %>
        <%= link_to account_organizations_path, class: active_nav_class(account_organizations_path) do %>
          <i class="fas fa-users mr-2"></i>
          My Organizations
        <% end %>
        <%= link_to matches_path, class: active_nav_class(matches_path) do %>
          <i class="fas fa-trophy mr-2"></i>
          Matches
        <% end %>

        <!-- Theme Toggle -->
        <%= render 'shared/navigation/theme_toggle' %>

        <!-- Log Match Button -->
        <%= link_to new_match_path,
                    class: "inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-0.5 active:scale-98 transition-all duration-200 ml-2" do %>
          <i class="fas fa-plus mr-2"></i>
          Log Match
        <% end %>

        <!-- Profile Dropdown -->
        <div class="relative ml-2" data-controller="profile-dropdown">
          <button
            type="button"
            class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-all duration-200"
            data-action="click->profile-dropdown#toggle"
          >
            <div class="w-8 h-8 bg-slate-200 dark:bg-slate-700/80 rounded-full flex items-center justify-center mr-2 border border-slate-300 dark:border-white/10">
              <i class="fas fa-user text-slate-600 dark:text-white/70"></i>
            </div>
            <span><%= current_user.email.presence || 'My Account' %></span>
            <i class="fas fa-chevron-down ml-2 text-xs"></i>
          </button>

          <div
            class="absolute right-0 mt-2 w-56 bg-white dark:bg-slate-800/90 backdrop-blur-xl rounded-xl shadow-xl overflow-hidden border border-slate-200 dark:border-slate-700 transform transition-all duration-200 z-50 hidden"
            data-profile-dropdown-target="menu"
          >
            <% primary_profile = current_user.profiles.first %>
            <%= link_to(primary_profile ? profile_path(primary_profile) : authenticated_root_path,
                        class: "flex items-center px-4 py-3 text-sm w-full text-left transition-all duration-200 text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-purple-500 dark:hover:text-purple-400") do %>
              <i class="fas fa-user mr-3 w-4 text-center"></i>
              <span>My Profile</span>
            <% end %>

            <%= link_to '#', class: "flex items-center px-4 py-3 text-sm w-full text-left transition-all duration-200 text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-purple-500 dark:hover:text-purple-400" do %>
              <i class="fas fa-cog mr-3 w-4 text-center"></i>
              <span>Settings</span>
            <% end %>

            <div class="my-1 border-t border-slate-200 dark:border-slate-700"></div>

            <%= button_to destroy_user_session_path, method: :delete,
                          class: "flex items-center px-4 py-3 text-sm w-full text-left transition-all duration-200 text-red-500 dark:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-red-600 dark:hover:text-red-300" do %>
              <i class="fas fa-sign-out-alt mr-3 w-4 text-center"></i>
              <span>Logout</span>
            <% end %>
          </div>
        </div>

      <% else %>
        <%= link_to organizations_path, class: "px-4 py-2 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-all duration-200" do %>
          <i class="fas fa-search mr-2"></i>
          Explore
        <% end %>

        <!-- Theme Toggle for guest users -->
        <%= render 'shared/navigation/theme_toggle' %>

        <%= link_to new_user_session_path, class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-all duration-200" do %>
          <i class="fas fa-sign-in-alt mr-2"></i>
          Sign In
        <% end %>
        <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400 shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transform hover:-translate-y-0.5 active:scale-98 transition-all duration-200" do %>
          <i class="fas fa-user-plus mr-2"></i>
          Sign Up
        <% end %>
      <% end %>
    </div>
  </div>
</nav>
