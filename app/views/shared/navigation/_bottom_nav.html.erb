<%#
  Bottom Navigation for Mobile
  - Visible only when user is signed in
  - Fixed to bottom of viewport with responsive design
  - Includes home, explore, create new match, organizations, and profile links
  - Uses Tailwind CSS for styling and Stimulus controller for behavior
%>
<div
  id="bottom-nav"
  class="md:hidden fixed bottom-0 left-0 right-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl z-40
         shadow-xl h-16 rounded-t-2xl transition-transform duration-200
         border-t border-slate-200/60 dark:border-white/10"
  data-controller="bottom-nav"
  data-action="scroll@window->bottom-nav#handleScroll"
  data-bottom-nav-hidden-class="translate-y-full"
>
  <div class="flex items-center h-full">
    <%# Home navigation link %>
    <%= link_to authenticated_root_path, class: "flex flex-col items-center justify-center flex-1 py-2 transition-all duration-200 #{nav_active_class(authenticated_root_path)}" do %>
      <i class="fas fa-home text-lg mb-1"></i>
      <span class="text-xs font-medium">Home</span>
    <% end %>

    <%# Explore navigation link %>
    <%= link_to organizations_path, class: "flex flex-col items-center justify-center flex-1 py-2 transition-all duration-200 #{nav_active_class(organizations_path)}" do %>
      <i class="fas fa-search text-lg mb-1"></i>
      <span class="text-xs font-medium">Explore</span>
    <% end %>

    <%# Create new match button (elevated above the navigation bar) %>
    <%= link_to new_match_path,
                aria: { label: "Create new match" },
                class: "flex items-center justify-center rounded-full shadow-lg text-white w-14 h-14 -mt-7 flex-shrink-0 mx-2
                        bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-500 hover:to-pink-400
                        shadow-purple-500/30 hover:shadow-purple-500/50 active:scale-95 transition-all duration-200" do %>
      <i class="fas fa-plus text-xl" aria-hidden="true"></i>
      <span class="sr-only">Create new match</span>
    <% end %>

    <%# My Organizations navigation link %>
    <%= link_to account_organizations_path, class: "flex flex-col items-center justify-center flex-1 py-2 transition-all duration-200 #{nav_active_class(account_organizations_path)}" do %>
      <i class="fas fa-users text-lg mb-1"></i>
      <span class="text-xs font-medium">My Orgs</span>
    <% end %>

    <%# User Profile navigation link %>
    <% primary_profile = current_user.profiles.first %>
    <% profile_path_link = primary_profile ? profile_path(primary_profile) : authenticated_root_path %>
    <%= link_to profile_path_link, class: "flex flex-col items-center justify-center flex-1 py-2 transition-all duration-200 #{nav_active_class(profile_path_link)}" do %>
      <i class="fas fa-user text-lg mb-1"></i>
      <span class="text-xs font-medium">Profile</span>
    <% end %>
  </div>
</div>
