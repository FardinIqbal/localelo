<div
  id="bottom-nav"
  class="retro-bottom-bar md:hidden fixed bottom-0 left-0 right-0"
  data-controller="bottom-nav"
  data-action="scroll@window->bottom-nav#handleScroll"
  data-bottom-nav-hidden-class="translate-y-full"
>
  <div class="retro-bottom-bar__inner">
    <%= link_to authenticated_root_path, class: nav_active_class(authenticated_root_path), aria: { label: "Home" } do %>
      <i class="fas fa-home" aria-hidden="true"></i>
      <span>Home</span>
    <% end %>

    <%= link_to organizations_path, class: nav_active_class(organizations_path), aria: { label: "Explore" } do %>
      <i class="fas fa-search" aria-hidden="true"></i>
      <span>Explore</span>
    <% end %>

    <%= link_to new_match_path, class: "retro-bottom-link retro-bottom-link--accent", aria: { label: "Log match" } do %>
      <i class="fas fa-plus" aria-hidden="true"></i>
      <span>Log</span>
    <% end %>

    <%= link_to account_organizations_path, class: nav_active_class(account_organizations_path), aria: { label: "My organizations" } do %>
      <i class="fas fa-users" aria-hidden="true"></i>
      <span>My Orgs</span>
    <% end %>

    <% primary_profile = current_user.profiles.first %>
    <% profile_path_link = primary_profile ? profile_path(primary_profile) : authenticated_root_path %>
    <%= link_to profile_path_link, class: nav_active_class(profile_path_link), aria: { label: "Profile" } do %>
      <i class="fas fa-user" aria-hidden="true"></i>
      <span>Profile</span>
    <% end %>
  </div>
</div>
