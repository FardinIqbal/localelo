<% if user_signed_in? %>
  <!-- Mobile nav controller wrapper -->
  <div class="md:hidden" data-controller="mobile-menu">
    <!-- Top Bar -->
    <div class="flex justify-between items-center px-4 py-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border-b border-slate-200/60 dark:border-white/10 shadow-lg">
      <!-- Logo -->
      <%= link_to authenticated_root_path,
                  class: "text-xl font-bold tracking-tight flex items-center group" do %>
        <div class="flex items-center">
          <div class="bg-gradient-to-r from-pink-500 to-indigo-500 rounded-lg p-1.5 mr-2 shadow-lg group-hover:scale-105 transition-all duration-200">
            <i class="fas fa-chart-line text-white"></i>
          </div>
          <span class="bg-gradient-to-r from-pink-500 to-indigo-500 bg-clip-text text-transparent">LocalElo</span>
        </div>
      <% end %>

      <!-- Hamburger Toggle -->
      <button
        type="button"
        class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-white hover:bg-slate-200 dark:hover:bg-slate-600/80 border border-slate-200 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-200 active:scale-95"
        data-action="click->mobile-menu#open"
        aria-label="Open menu"
      >
        <i class="fas fa-bars"></i>
      </button>
    </div>

    <!-- Slideout Menu -->
    <div
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden transition-opacity duration-200 ease-out"
      data-mobile-menu-target="overlay"
    >
      <div
        class="h-full w-80 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl p-6 shadow-2xl border-r border-slate-200 dark:border-white/10 transform -translate-x-full transition-transform duration-200 ease-out"
        data-mobile-menu-target="menu"
      >
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div class="text-xl font-bold flex items-center">
            <div class="bg-gradient-to-r from-pink-500 to-indigo-500 rounded-lg p-1.5 mr-2 shadow-lg">
              <i class="fas fa-chart-line text-white"></i>
            </div>
            <span class="bg-gradient-to-r from-pink-500 to-indigo-500 bg-clip-text text-transparent">LocalElo</span>
          </div>
          <button
            type="button"
            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-white hover:bg-slate-200 dark:hover:bg-slate-600/80 border border-slate-200 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-200 active:scale-95"
            data-action="click->mobile-menu#close"
            aria-label="Close menu"
          >
            <i class="fas fa-times"></i>
          </button>
        </div>

        <!-- User Info -->
        <div class="flex items-center mb-8 pb-6 border-b border-slate-200 dark:border-slate-700">
          <div class="w-12 h-12 bg-slate-200 dark:bg-slate-700/80 rounded-full flex items-center justify-center border border-slate-300 dark:border-white/10 shadow-md">
            <i class="fas fa-user text-slate-600 dark:text-white/70 text-lg"></i>
          </div>
          <div class="ml-3 flex-1 min-w-0">
            <div class="font-semibold text-slate-900 dark:text-white truncate"><%= current_user.username %></div>
            <% primary_profile = current_user.profiles.first %>
            <%= link_to(primary_profile ? profile_path(primary_profile) : authenticated_root_path,
                        class: "text-sm text-slate-500 dark:text-slate-400 hover:text-purple-500 dark:hover:text-purple-400 transition-colors duration-200 flex items-center mt-0.5 group") do %>
              <span>View Profile</span>
              <i class="fas fa-chevron-right ml-1 text-xs group-hover:translate-x-0.5 transition-transform duration-200"></i>
            <% end %>
          </div>
        </div>

        <!-- Navigation Links -->
        <div class="space-y-6">
          <div class="space-y-1">
            <h3 class="text-slate-400 dark:text-slate-500 uppercase text-xs font-semibold tracking-wider mb-3 px-2">Main</h3>
            <%= link_to authenticated_root_path, class: "flex items-center px-3 py-3 rounded-lg text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all duration-200 active:scale-98" do %>
              <i class="fas fa-home mr-3 w-5 text-center text-slate-400"></i>
              <span class="font-medium">Home</span>
            <% end %>
            <%= link_to organizations_path, class: "flex items-center px-3 py-3 rounded-lg text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all duration-200 active:scale-98" do %>
              <i class="fas fa-search mr-3 w-5 text-center text-slate-400"></i>
              <span class="font-medium">Explore</span>
            <% end %>
            <%= link_to account_organizations_path, class: "flex items-center px-3 py-3 rounded-lg text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all duration-200 active:scale-98" do %>
              <i class="fas fa-users mr-3 w-5 text-center text-slate-400"></i>
              <span class="font-medium">My Organizations</span>
            <% end %>
          </div>

          <div class="space-y-1">
            <h3 class="text-slate-400 dark:text-slate-500 uppercase text-xs font-semibold tracking-wider mb-3 px-2">Matches</h3>
            <%= link_to matches_path, class: "flex items-center px-3 py-3 rounded-lg text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all duration-200 active:scale-98" do %>
              <i class="fas fa-trophy mr-3 w-5 text-center text-slate-400"></i>
              <span class="font-medium">View Matches</span>
            <% end %>
            <%= link_to new_match_path, class: "flex items-center px-3 py-3 rounded-lg text-slate-900 dark:text-white bg-purple-100 dark:bg-gradient-to-r dark:from-purple-600/10 dark:to-pink-500/10 border border-purple-300 dark:border-purple-500/20 hover:bg-purple-50 dark:hover:bg-slate-800/80 transition-all duration-200 active:scale-98" do %>
              <i class="fas fa-plus-circle mr-3 w-5 text-center text-purple-500 dark:text-purple-400"></i>
              <span class="font-medium">Log New Match</span>
            <% end %>
          </div>

          <div class="border-t border-slate-200 dark:border-slate-700 pt-4">
            <div class="space-y-1">
              <h3 class="text-slate-400 dark:text-slate-500 uppercase text-xs font-semibold tracking-wider mb-3 px-2">Account</h3>
              <%= link_to '#', class: "flex items-center px-3 py-3 rounded-lg text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all duration-200 active:scale-98" do %>
                <i class="fas fa-cog mr-3 w-5 text-center text-slate-400"></i>
                <span class="font-medium">Settings</span>
              <% end %>
              <%= button_to destroy_user_session_path,
                            method: :delete,
                            class: "w-full flex items-center px-3 py-3 rounded-lg text-red-500 dark:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-red-600 dark:hover:text-red-300 transition-all duration-200 active:scale-98" do %>
                <i class="fas fa-sign-out-alt mr-3 w-5 text-center"></i>
                <span class="font-medium">Logout</span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- App version -->
        <div class="absolute bottom-6 left-0 right-0 text-center text-slate-400 dark:text-slate-500 text-xs">
          LocalElo v1.0
        </div>
      </div>
    </div>
  </div>
<% else %>
  <!-- Guest Mobile Header -->
  <div class="md:hidden bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border-b border-slate-200/60 dark:border-white/10 shadow-lg">
    <div class="flex justify-between items-center px-4 py-4">
      <!-- Logo -->
      <%= link_to unauthenticated_root_path,
                  class: "text-xl font-bold tracking-tight flex items-center group" do %>
        <div class="flex items-center">
          <div class="bg-gradient-to-r from-pink-500 to-indigo-500 rounded-lg p-1.5 mr-2 shadow-lg group-hover:scale-105 transition-all duration-200">
            <i class="fas fa-chart-line text-white"></i>
          </div>
          <span class="bg-gradient-to-r from-pink-500 to-indigo-500 bg-clip-text text-transparent">LocalElo</span>
        </div>
      <% end %>

      <!-- Guest Links -->
      <div class="flex gap-2">
        <%= link_to organizations_path, class: "inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-white hover:bg-slate-200 dark:hover:bg-slate-600/80 border border-slate-200 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-200 active:scale-95" do %>
          <i class="fas fa-search"></i>
        <% end %>

        <!-- Theme Toggle for guest users -->
        <%= render 'shared/navigation/theme_toggle' %>

        <div class="relative" data-controller="dropdown">
          <button
            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-white hover:bg-slate-200 dark:hover:bg-slate-600/80 border border-slate-200 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-200 active:scale-95"
            data-action="click->dropdown#toggle"
          >
            <i class="fas fa-user"></i>
          </button>

          <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-slate-800/90 backdrop-blur-xl rounded-xl shadow-xl border border-slate-200 dark:border-slate-700 hidden z-50 transform origin-top-right transition-all duration-200" data-dropdown-target="menu">
            <%= link_to new_user_session_path, class: "flex items-center px-4 py-3 text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-purple-500 dark:hover:text-purple-400 rounded-t-xl transition-all duration-200" do %>
              <i class="fas fa-sign-in-alt mr-3 w-5 text-center"></i>
              <span>Sign In</span>
            <% end %>
            <%= link_to new_user_registration_path, class: "flex items-center px-4 py-3 text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-purple-500 dark:hover:text-purple-400 rounded-b-xl transition-all duration-200" do %>
              <i class="fas fa-user-plus mr-3 w-5 text-center"></i>
              <span>Sign Up</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
