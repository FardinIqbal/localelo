<% if user_signed_in? %>
  <div class="md:hidden" data-controller="mobile-menu">
    <div class="retro-mobile-bar">
      <div class="retro-app">
        <div class="retro-mobile__inner">
          <%= link_to authenticated_root_path, class: "retro-brand retro-brand--compact" do %>
            <span class="retro-brand__mark">LE</span>
            <span class="retro-brand__text">
              <span class="retro-brand__title">LocalElo</span>
              <span class="retro-brand__tagline">Retro rankings</span>
            </span>
          <% end %>

          <div class="retro-mobile__actions">
            <%= render 'shared/navigation/theme_toggle' %>
            <button
              type="button"
              class="retro-icon-button"
              data-action="click->mobile-menu#open"
              aria-label="Open menu"
            >
              <i class="fas fa-bars"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="retro-mobile-overlay fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-200 ease-out"
      data-mobile-menu-target="overlay"
    >
      <div
        class="retro-mobile-panel h-full w-80 max-w-full transform -translate-x-full transition-transform duration-200 ease-out"
        data-mobile-menu-target="menu"
      >
        <div class="retro-mobile-panel__content">
          <div class="flex items-center justify-between">
            <%= link_to authenticated_root_path, class: "retro-brand retro-brand--compact" do %>
              <span class="retro-brand__mark">LE</span>
              <span class="retro-brand__text">
                <span class="retro-brand__title">LocalElo</span>
                <span class="retro-brand__tagline">Minimal retro</span>
              </span>
            <% end %>
            <button
              type="button"
              class="retro-icon-button"
              data-action="click->mobile-menu#close"
              aria-label="Close menu"
            >
              <i class="fas fa-times"></i>
            </button>
          </div>

          <%= form_with url: search_path, method: :get, local: true, class: "retro-search retro-mobile-menu__search" do |form| %>
            <%= form.label :q, "Search", class: "sr-only" %>
            <i class="fas fa-search retro-search__icon" aria-hidden="true"></i>
            <%= form.search_field :q,
                                  value: params[:q],
                                  placeholder: "Search",
                                  class: "retro-search__input",
                                  'aria-label': 'Search' %>
          <% end %>

          <div class="retro-mobile-user">
            <div class="retro-mobile-user__avatar">
              <i class="fas fa-user"></i>
            </div>
            <div>
              <p class="font-semibold"><%= current_user.username %></p>
              <% primary_profile = current_user.profiles.first %>
              <%= link_to(primary_profile ? profile_path(primary_profile) : authenticated_root_path,
                          class: "retro-mobile-menu__link") do %>
                <i class="fas fa-id-badge"></i>
                <span>View profile</span>
              <% end %>
            </div>
          </div>

          <div class="retro-mobile-menu__group">
            <p class="retro-mobile-menu__heading">Navigate</p>
            <%= link_to authenticated_root_path, class: "retro-mobile-menu__link" do %>
              <i class="fas fa-home"></i>
              <span>Home</span>
            <% end %>
            <%= link_to organizations_path, class: "retro-mobile-menu__link" do %>
              <i class="fas fa-search"></i>
              <span>Explore</span>
            <% end %>
            <%= link_to account_organizations_path, class: "retro-mobile-menu__link" do %>
              <i class="fas fa-users"></i>
              <span>My Organizations</span>
            <% end %>
            <%= link_to matches_path, class: "retro-mobile-menu__link" do %>
              <i class="fas fa-trophy"></i>
              <span>Matches</span>
            <% end %>
          </div>

          <div class="retro-mobile-menu__group">
            <p class="retro-mobile-menu__heading">Matches</p>
            <%= link_to new_match_path, class: "retro-mobile-menu__link" do %>
              <i class="fas fa-plus-circle"></i>
              <span>Log a match</span>
            <% end %>
          </div>

          <div class="retro-mobile-menu__group">
            <p class="retro-mobile-menu__heading">Account</p>
            <%= link_to '#', class: "retro-mobile-menu__link" do %>
              <i class="fas fa-cog"></i>
              <span>Settings</span>
            <% end %>
            <%= button_to destroy_user_session_path,
                          method: :delete,
                          class: "retro-mobile-menu__link retro-mobile-menu__link--danger" do %>
              <i class="fas fa-sign-out-alt"></i>
              <span>Logout</span>
            <% end %>
          </div>

          <p class="retro-mobile-footer">LocalElo v1.0</p>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="md:hidden retro-mobile-bar">
    <div class="retro-app">
      <div class="retro-mobile__inner">
        <%= link_to unauthenticated_root_path, class: "retro-brand retro-brand--compact" do %>
          <span class="retro-brand__mark">LE</span>
          <span class="retro-brand__text">
            <span class="retro-brand__title">LocalElo</span>
            <span class="retro-brand__tagline">Retro rankings</span>
          </span>
        <% end %>

        <div class="retro-mobile__actions">
          <%= form_with url: search_path, method: :get, local: true, class: "retro-search retro-mobile-menu__search" do |form| %>
            <%= form.label :q, "Search", class: "sr-only" %>
            <i class="fas fa-search retro-search__icon" aria-hidden="true"></i>
            <%= form.search_field :q,
                                  value: params[:q],
                                  placeholder: "Search",
                                  class: "retro-search__input",
                                  'aria-label': 'Search' %>
          <% end %>
          <%= render 'shared/navigation/theme_toggle' %>
          <div class="retro-nav__links">
            <%= link_to new_user_session_path, class: active_nav_class(new_user_session_path) do %>
              <i class="fas fa-sign-in-alt"></i>
              Sign In
            <% end %>
            <%= link_to new_user_registration_path, class: active_nav_class(new_user_registration_path) do %>
              <i class="fas fa-user-plus"></i>
              Sign Up
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
