<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:title) ? yield(:title) : "Admin - ELO Tracker" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-slate-900 text-white min-h-screen flex">
<!-- Admin sidebar -->
<aside class="w-64 bg-slate-800 fixed inset-y-0 z-50 hidden md:block">
  <div class="p-6">
    <div class="text-xl font-bold mb-8">
      <span class="text-pink-500">ELO</span>Tracker Admin
    </div>

    <nav class="space-y-1">
      <%= link_to admin_dashboard_path, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
        <i class="fas fa-tachometer-alt w-5 mr-3"></i>
        <span>Dashboard</span>
      <% end %>

      <%= link_to admin_organizations_path, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
        <i class="fas fa-building w-5 mr-3"></i>
        <span>Organizations</span>
      <% end %>

      <%= link_to admin_users_path, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
        <i class="fas fa-users w-5 mr-3"></i>
        <span>Users</span>
      <% end %>

      <%= link_to admin_leaderboards_path, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
        <i class="fas fa-list-ol w-5 mr-3"></i>
        <span>Leaderboards</span>
      <% end %>

      <%= link_to admin_matches_path, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
        <i class="fas fa-trophy w-5 mr-3"></i>
        <span>Matches</span>
      <% end %>
    </nav>
  </div>

  <div class="absolute bottom-0 left-0 right-0 p-6">
    <%= link_to root_path, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
      <i class="fas fa-arrow-left w-5 mr-3"></i>
      <span>Back to App</span>
    <% end %>

    <%= link_to destroy_user_session_path, method: :delete, class: "flex items-center px-4 py-3 rounded-lg text-gray-300 hover:bg-slate-700 hover:text-white" do %>
      <i class="fas fa-sign-out-alt w-5 mr-3"></i>
      <span>Sign Out</span>
    <% end %>
  </div>
</aside>

<!-- Mobile admin header -->
<div class="md:hidden fixed top-0 left-0 right-0 bg-slate-800 z-50">
  <div class="flex items-center justify-between p-4">
    <div class="text-xl font-bold">
      <span class="text-pink-500">ELO</span>Tracker Admin
    </div>

    <div data-controller="mobile-menu" data-mobile-menu-target="container">
      <button data-mobile-menu-target="button" data-action="mobile-menu#toggle" class="text-gray-300 hover:text-white">
        <i data-mobile-menu-target="icon" class="fas fa-bars text-xl"></i>
      </button>
      <div data-mobile-menu-target="menu" class="hidden fixed inset-0 z-50 bg-slate-900/95 backdrop-blur-sm">
        <div class="flex flex-col h-full">
          <div class="flex justify-end p-4">
            <button data-action="mobile-menu#close" class="text-gray-300 hover:text-white">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
          <div class="flex flex-col items-center justify-center flex-grow space-y-8 text-xl">
            <%= link_to admin_dashboard_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" do %>
              <i class="fas fa-tachometer-alt mr-2"></i> Dashboard
            <% end %>

            <%= link_to admin_organizations_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" do %>
              <i class="fas fa-building mr-2"></i> Organizations
            <% end %>

            <%= link_to admin_users_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" do %>
              <i class="fas fa-users mr-2"></i> Users
            <% end %>

            <%= link_to admin_leaderboards_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" do %>
              <i class="fas fa-list-ol mr-2"></i> Leaderboards
            <% end %>

            <%= link_to admin_matches_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" do %>
              <i class="fas fa-trophy mr-2"></i> Matches
            <% end %>

            <%= link_to root_path, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center" do %>
              <i class="fas fa-arrow-left mr-2"></i> Back to App
            <% end %>

            <%= link_to destroy_user_session_path, method: :delete, class: "mobile-nav-item px-4 py-2 rounded-lg w-64 text-center bg-pink-600" do %>
              <i class="fas fa-sign-out-alt mr-2"></i> Sign Out
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="flex-1 md:ml-64 pt-16 md:pt-0">
  <div class="p-6 md:p-10">
    <%= render "shared/flash_messages" %>

    <% if content_for?(:admin_header) %>
      <div class="mb-8">
        <%= yield :admin_header %>
      </div>
    <% end %>

    <%= yield %>
  </div>
</div>

<!-- Toast container for notifications -->
<div id="toast-container" data-controller="toast" class="fixed top-4 right-4 z-50 flex flex-col items-end"></div>
</body>
</html>
