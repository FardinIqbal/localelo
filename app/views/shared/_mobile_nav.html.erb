<% if user_signed_in? %>
  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-button"
    type="button"
    class="md:hidden flex items-center justify-center w-10 h-10 rounded-full bg-slate-800 text-white border border-white/10"
    data-action="click->mobile-menu#open"
  >
    <i class="fas fa-bars"></i>
  </button>

  <!-- Slideout Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden"
    data-controller="mobile-menu"
  >
    <div
      id="mobile-menu-container"
      class="h-full w-72 bg-slate-800/90 backdrop-blur-xl p-6 shadow-lg rounded-r-lg border-l border-white/10 transform -translate-x-full transition-transform duration-300"
      data-mobile-menu-target="container"
    >
      <div class="flex justify-between items-center mb-6">
        <div class="text-xl font-bold bg-gradient-to-r from-pink-500 to-indigo-500 bg-clip-text text-transparent flex items-center">
          <i class="fas fa-chart-line mr-2"></i>
          LocalElo
        </div>
        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-700 text-white border border-white/10"
          data-action="click->mobile-menu#close"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>

      <!-- User Info -->
      <div class="flex items-center mb-6 pb-4 border-b border-white/5">
        <div class="bg-slate-700 rounded-full w-12 h-12 flex items-center justify-center border border-white/10">
          <i class="fas fa-user text-white/70 text-xl"></i>
        </div>
        <div class="ml-3">
          <div class="font-medium text-white"><%= current_user.username %></div>
          <div class="text-sm text-white/60">View Profile</div>
        </div>
      </div>

      <!-- Nav Items -->
      <%= render 'shared/nav_link', text: 'Home', path: authenticated_root_path, icon: 'fa-home', extra_classes: 'mobile-nav-item mb-1' %>
      <%= render 'shared/nav_link', text: 'Explore', path: organizations_path, icon: 'fa-search', extra_classes: 'mobile-nav-item mb-1' %>
      <%= render 'shared/nav_link', text: 'My Organizations', path: account_organizations_path, icon: 'fa-users', extra_classes: 'mobile-nav-item mb-1' %>
      <%= render 'shared/nav_link', text: 'Matches', path: matches_path, icon: 'fa-trophy', extra_classes: 'mobile-nav-item mb-1' %>
      <%= render 'shared/nav_link', text: 'Log Match', path: new_match_path, icon: 'fa-plus', extra_classes: 'mobile-nav-item mb-1' %>

      <div class="border-t border-white/10 my-4"></div>

      <%= render 'shared/nav_link', text: 'Settings', path: '#', icon: 'fa-cog', extra_classes: 'mobile-nav-item mb-1' %>

      <%= button_to destroy_user_session_path, method: :delete,
                    class: "block py-3 px-4 text-red-400 rounded-md transition-all duration-300 hover:bg-slate-700/50 hover:text-red-300 mb-1 w-full text-left" do %>
        <i class="fas fa-sign-out-alt mr-3 w-6 text-center"></i> Logout
      <% end %>
    </div>
  </div>
<% else %>
  <!-- Guest Links (for mobile) -->
  <div class="md:hidden flex gap-2">
    <%= render 'shared/nav_link', text: 'Explore', path: organizations_path, icon: 'fa-search', extra_classes: 'mobile-nav-item' %>
    <%= render 'shared/nav_link', text: 'Sign In', path: new_user_session_path, icon: 'fa-sign-in-alt', extra_classes: 'mobile-nav-item' %>
    <%= render 'shared/nav_link', text: 'Sign Up', path: new_user_registration_path, icon: 'fa-user-plus', extra_classes: 'mobile-nav-item' %>
  </div>
<% end %>
