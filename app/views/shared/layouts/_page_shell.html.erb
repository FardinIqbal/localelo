<%# Shared retro page shell to unify interior spacing and tone %>
<% content = capture { yield } if block_given? %>
<% body_classes = ["retro-shell__body", local_assigns[:body_classes]].compact.join(" ") %>
<div class="retro-shell">
  <div class="retro-shell__surface">
    <% if local_assigns[:eyebrow].present? || local_assigns[:title].present? || local_assigns[:subtitle].present? %>
      <header class="retro-shell__header">
        <% if local_assigns[:eyebrow].present? %>
          <p class="retro-shell__eyebrow"><%= local_assigns[:eyebrow] %></p>
        <% end %>
        <% if local_assigns[:title].present? %>
          <h1 class="retro-shell__title"><%= local_assigns[:title] %></h1>
        <% end %>
        <% if local_assigns[:subtitle].present? %>
          <p class="retro-shell__subtitle"><%= local_assigns[:subtitle] %></p>
        <% end %>
      </header>
    <% end %>
    <div class="<%= body_classes %>">
      <%= content %>
    </div>
  </div>
</div>
