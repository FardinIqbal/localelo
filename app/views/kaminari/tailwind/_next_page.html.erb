<%
  link_classes = local_assigns[:class] || ""
  disabled_classes = local_assigns[:disabled_class] || link_classes
  sr_label = local_assigns[:sr_label] || t('views.pagination.next')
%>
<% if current_page.last? %>
  <span class="<%= disabled_classes %>" aria-disabled="true">
    <span class="sr-only"><%= sr_label %></span>
    <i class="fas fa-chevron-right opacity-60"></i>
  </span>
<% else %>
  <%= link_to url, class: link_classes, rel: 'next', remote: remote do %>
    <span class="sr-only"><%= sr_label %></span>
    <i class="fas fa-chevron-right"></i>
  <% end %>
<% end %>
