<div class="relative min-h-screen bg-slate-900 text-white">
  <div class="decorative-blur absolute -top-20 -right-20 w-96 h-96 bg-purple-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0"></div>
  <div class="decorative-blur absolute -bottom-20 -left-20 w-64 h-64 bg-pink-600/10 rounded-full filter blur-3xl animate-pulse-slow z-0 delay-1500"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 py-8 space-y-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-3xl font-bold shadow-lg shadow-purple-500/20">
          <%= @profile.username.first.upcase %>
        </div>
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
            <%= @profile.username %>
          </h1>
          <p class="text-slate-300 mt-1">
            <i class="fas fa-building mr-2"></i>
            <%= link_to @organization.name, organization_path(@organization), class: "hover:text-purple-300 transition-colors" %>
          </p>
          <p class="text-slate-400 text-sm mt-2">
            <i class="fas fa-envelope mr-2"></i>
            <%= @profile.user.email %>
          </p>
        </div>
      </div>

      <%# Additional profile actions can go here %>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Total Matches</div>
        <div class="text-2xl font-bold text-white mt-1"><%= @profile_stats[:total_matches] %></div>
      </div>
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Wins</div>
        <div class="text-2xl font-bold text-green-400 mt-1"><%= @profile_stats[:total_wins] %></div>
      </div>
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Losses</div>
        <div class="text-2xl font-bold text-red-400 mt-1"><%= @profile_stats[:total_losses] %></div>
      </div>
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl p-4 border border-slate-700">
        <div class="text-sm text-slate-400">Win Rate</div>
        <div class="text-2xl font-bold text-white mt-1"><%= @profile_stats[:win_rate] %>%</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-slate-700">
          <h2 class="text-xl font-bold text-white">Leaderboard Ratings</h2>
          <% if @leaderboard_ratings.empty? && @profile.user == current_user %>
            <%= link_to new_match_path(leaderboard_id: @organization.leaderboards.first&.id), class: "text-sm text-purple-400 hover:text-pink-400 transition-colors" do %>
              <i class="fas fa-plus mr-1"></i> Log Match
            <% end %>
          <% end %>
        </div>
        <% if @leaderboard_ratings.any? %>
          <div class="divide-y divide-slate-700">
            <% @leaderboard_ratings.each do |rating| %>
              <div class="p-4 flex items-center justify-between hover:bg-slate-700/40 transition-colors">
                <div>
                  <div class="text-white font-medium"><%= rating.leaderboard.name %></div>
                  <div class="text-xs text-slate-400 mt-1">
                    <%= rating.wins %> wins / <%= rating.losses %> losses
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-bold text-purple-400"><%= rating.rating.round %></div>
                  <div class="text-xs text-slate-400">±<%= rating.rating_deviation.round %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-6 text-center text-slate-400">No leaderboard activity yet.</div>
        <% end %>
      </div>

      <div class="bg-slate-800/70 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-slate-700">
          <h2 class="text-xl font-bold text-white">Recent Matches</h2>
          <%= link_to matches_path, class: "text-sm text-purple-400 hover:text-pink-400 transition-colors" do %>
            View All <i class="fas fa-arrow-right ml-1"></i>
          <% end %>
        </div>
        <% if @matches.any? %>
          <div class="divide-y divide-slate-700">
            <% @matches.each do |match| %>
              <% opponent = match.profile1_id == @profile.id ? match.opponent_profile : match.profile1 %>
              <div class="p-4 flex items-center justify-between hover:bg-slate-700/40 transition-colors">
                <div>
                  <div class="text-white font-medium">
                    <%= link_to opponent.username, profile_path(opponent), class: "hover:text-purple-300 transition-colors" %>
                  </div>
                  <div class="text-xs text-slate-400 mt-1">
                    <%= match.leaderboard.name %> • <%= match.created_at.strftime("%b %d, %Y") %>
                  </div>
                </div>
                <div class="text-sm font-semibold <%= match.is_draw ? 'text-yellow-400' : (match.winner_profile_id == @profile.id ? 'text-green-400' : 'text-red-400') %>">
                  <% if match.is_draw %>
                    Draw
                  <% elsif match.winner_profile_id == @profile.id %>
                    Won
                  <% else %>
                    Lost
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-6 text-center text-slate-400">No matches recorded yet.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
