<%= render "shared/layouts/page_shell",
           title: @profile.username,
           subtitle: "Match history and ratings across this organization." do %>
  <div class="space-y-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <span class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-900 text-2xl font-semibold text-white">
          <%= @profile.username.first.upcase %>
        </span>
        <div class="text-sm text-slate-600">
          <p><i class="fas fa-building mr-1 text-slate-400"></i><%= link_to @organization.name, organization_path(@organization), class: "text-slate-600 hover:text-slate-900" %></p>
          <p class="mt-1"><i class="fas fa-envelope mr-1 text-slate-400"></i><%= @profile.user.email %></p>
        </div>
      </div>
    </div>

    <section>
      <h2 class="text-lg font-semibold text-slate-900">Overview</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Matches</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @profile_stats[:total_matches] %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Wins</dt>
          <dd class="mt-2 text-2xl font-semibold text-emerald-600"><%= @profile_stats[:total_wins] %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Losses</dt>
          <dd class="mt-2 text-2xl font-semibold text-rose-600"><%= @profile_stats[:total_losses] %></dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Win rate</dt>
          <dd class="mt-2 text-2xl font-semibold text-slate-900"><%= @profile_stats[:win_rate] %>%</dd>
        </div>
      </dl>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900">Leaderboard ratings</h2>
          <% if @leaderboard_ratings.empty? && @profile.user == current_user && @organization.leaderboards.any? %>
            <%= link_to "Log a match", new_match_path(leaderboard_id: @organization.leaderboards.first.id), class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
          <% end %>
        </div>
        <% if @leaderboard_ratings.any? %>
          <ul class="space-y-3 text-sm text-slate-600">
            <% @leaderboard_ratings.each do |rating| %>
              <li class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="font-semibold text-slate-900"><%= rating.leaderboard.name %></p>
                    <p class="text-xs text-slate-500"><%= rating.wins %> wins · <%= rating.losses %> losses</p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-semibold text-slate-900"><%= rating.rating.round %></p>
                    <p class="text-xs text-slate-500">±<%= rating.rating_deviation.round %></p>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-600">No leaderboard activity yet.</p>
        <% end %>
      </section>

      <section class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900">Recent matches</h2>
          <%= link_to "View all matches", matches_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
        </div>
        <% if @matches.any? %>
          <ul class="space-y-3 text-sm text-slate-600">
            <% @matches.each do |match| %>
              <% opponent = match.profile1_id == @profile.id ? match.opponent_profile : match.profile1 %>
              <li class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                  <p class="font-semibold text-slate-900">
                    <%= link_to opponent.username, profile_path(opponent), class: "hover:text-slate-700" %>
                  </p>
                  <p class="text-xs text-slate-500"><%= match.leaderboard.name %> · <%= match.created_at.strftime("%b %d, %Y") %></p>
                </div>
                <p class="text-xs text-slate-500">
                  <% if match.is_draw %>
                    Draw
                  <% elsif match.winner_profile_id == @profile.id %>
                    Won
                  <% else %>
                    Lost
                  <% end %>
                </p>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-600">No matches recorded yet.</p>
        <% end %>
      </section>
    </div>
  </div>
<% end %>
